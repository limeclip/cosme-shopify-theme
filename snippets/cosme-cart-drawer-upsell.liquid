{% doc %}
  Cart drawer "You may also like" list. Manual products persist on the dialog;
  recommendations are filled via Shopify's Product Recommendations API.

  @param {boolean} [enabled] - Whether the upsell is enabled (default: true)
  @param {string} [heading] - Section heading
  @param {string} [source] - `manual` or `recommendations` (default: manual)
  @param {object} [products] - Product list from the section setting
  @param {number} [limit] - Maximum products to show (default: 4)
  @param {boolean} [show_vendor] - Show vendor on each row
  @param {boolean} [recs_ready] - Whether Shopify recommendations were returned
  @param {object} [recs_products] - Products from the Product Recommendations API
  @param {string} [context] - `cart` or `empty` (default: cart)

  @example
  {% render 'cosme-cart-drawer-upsell', source: 'manual', products: section.settings.upsell_products %}
{% enddoc %}

{%- liquid
  assign upsell_enabled = true
  if enabled == false
    assign upsell_enabled = false
  endif

  assign upsell_source = source | default: 'manual'
  assign upsell_limit = limit | default: 4
  if upsell_limit < 1
    assign upsell_limit = 1
  endif
  if upsell_limit > 4
    assign upsell_limit = 4
  endif

  assign upsell_heading = heading | strip
  if upsell_heading == blank
    assign upsell_heading = 'cart.upsell_heading' | t
  endif

  assign show_vendor_label = false
  if show_vendor
    assign show_vendor_label = true
  endif

  assign recs_are_ready = false
  if recs_ready
    assign recs_are_ready = true
  endif

  assign upsell_context = context | default: 'cart'
  assign visible_count = 0
-%}

{%- if upsell_enabled -%}
  <section
    class="cosme-cart-drawer__upsell"
    data-cart-drawer-upsell
    data-upsell-context="{{ upsell_context | escape }}"
    data-upsell-source="{{ upsell_source | escape }}"
    data-upsell-limit="{{ upsell_limit }}"
    {% if show_vendor_label %}
      data-show-vendor="true"
    {% else %}
      data-show-vendor="false"
    {% endif %}
    aria-label="{{ upsell_heading | escape }}"
  >
    <h3 class="cosme-cart-drawer__upsell-heading" data-cart-drawer-upsell-heading>
      {{ upsell_heading | escape }}
    </h3>

    <ul class="cosme-cart-drawer__upsell-list" role="list" data-cart-drawer-upsell-list>
      {%- if recs_are_ready -%}
        {%- for product in recs_products limit: upsell_limit -%}
          {%- liquid
            assign skip_product = false
            unless product.available
              assign skip_product = true
            endunless

            for item in cart.items
              if item.product.id == product.id
                assign skip_product = true
              endif
            endfor
          -%}
          {%- unless skip_product -%}
            {%- assign visible_count = visible_count | plus: 1 -%}
            {% render 'cosme-cart-drawer-upsell-item', product: product, show_vendor: show_vendor_label %}
          {%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        {%- for product in products limit: upsell_limit -%}
          {%- if product.available -%}
            {%- assign visible_count = visible_count | plus: 1 -%}
            {% render 'cosme-cart-drawer-upsell-item', product: product, show_vendor: show_vendor_label %}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if request.design_mode -%}
      {%- if recs_are_ready == false -%}
        {%- if visible_count == 0 -%}
          <p class="cosme-cart-drawer__upsell-editor">{{ 'cart.upsell_editor_empty' | t }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  </section>
{%- endif -%}

{% stylesheet %}
  .cosme-cart-drawer__upsell {
    flex-shrink: 0;
    margin-top: var(--spacing-sm);
    padding: var(--spacing-md) 0 0;
    border-top: var(--border-width) solid var(--color-border);
  }

  .cosme-cart-drawer__upsell[hidden] {
    display: none;
  }

  .cosme-cart-drawer__upsell-heading {
    margin: 0 0 var(--spacing-md);
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: var(--font-body--weight);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-cart-drawer__upsell-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cosme-cart-drawer__upsell-item {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    gap: var(--spacing-sm) var(--spacing-md);
    align-items: center;
    padding-block: var(--spacing-sm);
  }

  .cosme-cart-drawer__upsell-item + .cosme-cart-drawer__upsell-item {
    border-top: var(--border-width) solid var(--color-border);
  }

  .cosme-cart-drawer__upsell-media {
    display: block;
    width: 3.5rem;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }

  .cosme-cart-drawer__upsell-media img,
  .cosme-cart-drawer__upsell-placeholder {
    display: block;
    width: 100%;
    height: auto;
  }

  .cosme-cart-drawer__upsell-placeholder {
    color: var(--color-muted);
  }

  .cosme-cart-drawer__upsell-copy {
    min-width: 0;
  }

  .cosme-cart-drawer__upsell-vendor {
    margin: 0 0 0.125rem;
    color: var(--color-muted);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cosme-cart-drawer__upsell[data-show-vendor='false'] .cosme-cart-drawer__upsell-vendor {
    display: none;
  }

  .cosme-cart-drawer__upsell-title {
    display: block;
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--color-heading, var(--color-foreground));
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .cosme-cart-drawer__upsell-title:hover,
  .cosme-cart-drawer__upsell-title:focus-visible {
    color: var(--color-accent);
  }

  .cosme-cart-drawer__upsell-price {
    margin-top: 0.125rem;
  }

  .cosme-cart-drawer__upsell-price .cosme-price {
    font-size: 0.8125rem;
  }

  .cosme-cart-drawer__upsell-action {
    justify-self: end;
  }

  .cosme-cart-drawer__upsell-add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0 var(--spacing-sm);
    color: var(--color-heading, var(--color-foreground));
    background: transparent;
    border: 0;
    font-family: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }

  .cosme-cart-drawer__upsell-add:hover {
    color: var(--color-accent);
  }

  .cosme-cart-drawer__upsell-add:focus-visible {
    color: var(--color-accent);
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .cosme-cart-drawer__upsell-add[aria-busy='true'],
  .cosme-cart-drawer__upsell-add:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  .cosme-cart-drawer__upsell-editor {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.8125rem;
  }
{% endstylesheet %}
