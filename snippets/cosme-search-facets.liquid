{% javascript %}
  (() => {
    const SCROLL_LOCK_CLASS = 'cosme-collection-filters-scroll-lock';
    const READY_ATTRIBUTE = 'data-search-facets-ready';

    const lockScroll = () => {
      document.documentElement.classList.add(SCROLL_LOCK_CLASS);
      document.body.classList.add(SCROLL_LOCK_CLASS);
    };

    const unlockScroll = () => {
      document.documentElement.classList.remove(SCROLL_LOCK_CLASS);
      document.body.classList.remove(SCROLL_LOCK_CLASS);
    };

    const initFacets = (root) => {
      if (!root || root.getAttribute(READY_ATTRIBUTE) === 'true') {
        return;
      }

      root.setAttribute(READY_ATTRIBUTE, 'true');

      const dialog = root.querySelector('[data-filter-dialog]');
      const openButton = root.querySelector('[data-filter-open]');
      const closeButtons = root.querySelectorAll('[data-filter-close]');
      const sortSelect = root.querySelector('[data-sort-select]');
      const dropdowns = root.querySelectorAll('[data-cosme-dropdown]');
      const heading = dialog ? dialog.querySelector('.cosme-collection-filters__heading') : null;
      const closeButton = dialog ? dialog.querySelector('[data-filter-close]') : null;

      const setExpanded = (expanded) => {
        if (openButton) {
          openButton.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        }
        if (dialog) {
          dialog.setAttribute('aria-hidden', expanded ? 'false' : 'true');
        }
      };

      const openFilters = () => {
        if (!dialog || dialog.open) return;
        dialog.showModal();
        setExpanded(true);
        lockScroll();
        const focusTarget = heading || closeButton;
        if (focusTarget) focusTarget.focus();
      };

      const closeFilters = () => {
        if (!dialog || !dialog.open) return;
        dialog.close();
      };

      if (openButton) {
        openButton.addEventListener('click', openFilters);
      }

      closeButtons.forEach((button) => {
        button.addEventListener('click', closeFilters);
      });

      if (dialog) {
        if (!dialog.open) {
          dialog.setAttribute('aria-hidden', 'true');
        }

        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) closeFilters();
        });

        dialog.addEventListener('close', () => {
          setExpanded(false);
          unlockScroll();
          if (openButton) openButton.focus();
        });

        dialog.addEventListener('cancel', () => {
          unlockScroll();
        });
      }

      if (sortSelect) {
        sortSelect.addEventListener('change', () => {
          if (sortSelect.form) sortSelect.form.requestSubmit();
        });
      }

      dropdowns.forEach((dropdown) => {
        const trigger = dropdown.querySelector('[data-dropdown-trigger]');
        const menu = dropdown.querySelector('[data-dropdown-menu]');
        const options = dropdown.querySelectorAll('[data-dropdown-option]');
        const nativeSelect = dropdown.querySelector('[data-sort-select]');
        const label = dropdown.querySelector('[data-dropdown-label]');

        if (!trigger || !menu) return;

        const close = () => {
          dropdown.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
        };

        const open = () => {
          document.querySelectorAll('[data-cosme-dropdown].is-open').forEach((item) => {
            if (item !== dropdown) {
              item.classList.remove('is-open');
              item.querySelector('[data-dropdown-trigger]')?.setAttribute('aria-expanded', 'false');
            }
          });
          dropdown.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        };

        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          if (dropdown.classList.contains('is-open')) {
            close();
          } else {
            open();
          }
        });

        options.forEach((option) => {
          option.addEventListener('click', () => {
            const value = option.dataset.value;
            if (nativeSelect && value) {
              nativeSelect.value = value;
              if (label) {
                label.textContent = option.querySelector('span')?.textContent.trim() || '';
              }
              nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));
            }
            close();
          });
        });

        trigger.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            close();
            return;
          }
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            if (dropdown.classList.contains('is-open')) {
              close();
            } else {
              open();
            }
          }
          if (event.key === 'ArrowDown') {
            event.preventDefault();
            open();
            options[0]?.focus();
          }
        });

        options.forEach((option, index) => {
          option.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
              close();
              trigger.focus();
              return;
            }
            if (event.key === 'ArrowDown') {
              event.preventDefault();
              options[index + 1]?.focus();
            }
            if (event.key === 'ArrowUp') {
              event.preventDefault();
              if (index === 0) {
                trigger.focus();
              } else {
                options[index - 1]?.focus();
              }
            }
          });
        });
      });

      document.addEventListener('click', (event) => {
        dropdowns.forEach((dropdown) => {
          if (!dropdown.contains(event.target)) {
            dropdown.classList.remove('is-open');
            dropdown.querySelector('[data-dropdown-trigger]')?.setAttribute('aria-expanded', 'false');
          }
        });
      });
    };

    document.querySelectorAll('[data-search-facets]').forEach(initFacets);

    document.addEventListener('shopify:section:load', (event) => {
      const root = event.target.querySelector('[data-search-facets]');
      if (root) initFacets(root);
    });
  })();
{% endjavascript %}
