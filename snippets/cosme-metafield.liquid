{% doc %}
  Renders a product metafield when the namespace/key pair has a value.

  Uses Shopify metafield filters only. Empty metafields output nothing.

  @param {object} product - The product to read metafields from
  @param {string} namespace - Metafield namespace, for example `custom`
  @param {string} key - Metafield key, for example `ingredients`

  @example
  {% render 'cosme-metafield', product: product, namespace: 'custom', key: 'ingredients' %}
{% enddoc %}

{% liquid
  assign metafield_namespace = namespace | strip
  assign metafield_key = key | strip
  assign metafield_text = ''
  assign metafield_object = nil

  if metafield_namespace != blank
    if metafield_key != blank
      assign metafield_object = product.metafields[metafield_namespace][metafield_key]
      if metafield_object != blank
        assign metafield_text = metafield_object | metafield_text | strip
      endif
    endif
  endif
%}

{% if metafield_text != blank %}
  <div class="cosme-rte">
    {{ metafield_object | metafield_tag }}
  </div>
{% endif %}
