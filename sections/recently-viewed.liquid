{% liquid
  assign section_enabled = section.settings.enable
  assign products_limit = section.settings.products_to_show | default: 8
  assign desktop_columns = section.settings.desktop_columns | default: 4
  assign mobile_columns = 2

  assign heading = section.settings.heading | strip
  if heading == blank
    assign heading = 'sections.recently_viewed.heading' | t
  endif

  assign desktop_vw = 100 | divided_by: desktop_columns
  assign card_sizes = '(min-width: 990px) ' | append: desktop_vw | append: 'vw, (min-width: 768px) 33vw, 50vw'

  assign show_demo = false
  if request.design_mode
    if section_enabled
      assign show_demo = true
    endif
  endif

  assign hide_section = true
  if show_demo
    assign hide_section = false
  endif
%}

<section
  id="RecentlyViewed-{{ section.id }}"
  class="cosme-recently-viewed full-width color-{{ section.settings.color_scheme }}"
  style="--recently-viewed-columns-desktop: {{ desktop_columns }}; --recently-viewed-columns-mobile: {{ mobile_columns }};"
  data-recently-viewed
  data-enabled="{{ section_enabled }}"
  data-ready="{% if show_demo %}true{% else %}false{% endif %}"
  data-section-id="{{ section.id }}"
  data-cards-section="recently-viewed-cards"
  data-search-url="{{ routes.search_url }}"
  data-product-handle="{{ product.handle | escape }}"
  data-storage-key="cosme-recently-viewed-{{ shop.id }}"
  data-max-products="{{ products_limit }}"
  data-show-navigation="{{ section.settings.show_navigation }}"
  data-page-label="{{ 'sections.recently_viewed.page_status' | t }}"
  aria-label="{{ 'sections.recently_viewed.landmark_label' | t }}"
  {% if hide_section %}
    hidden
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="cosme-recently-viewed__inner">
    {% if show_demo %}
      <header class="cosme-recently-viewed__header">
        <div class="cosme-recently-viewed__titles">
          <h2 class="cosme-recently-viewed__heading">{{ heading | escape }}</h2>
        </div>

        {% if section.settings.show_navigation %}
          <nav
            class="cosme-recently-viewed__navigation"
            aria-label="{{ 'sections.recently_viewed.navigation' | t }}"
            data-recently-viewed-nav
            hidden
          >
            <button
              type="button"
              class="cosme-recently-viewed__nav-button"
              data-recently-viewed-prev
              aria-label="{{ 'sections.recently_viewed.previous' | t }}"
              disabled
            >
              {{ 'sections.recently_viewed.previous' | t }}
            </button>
            <span class="cosme-recently-viewed__nav-divider" aria-hidden="true">|</span>
            <button
              type="button"
              class="cosme-recently-viewed__nav-button"
              data-recently-viewed-next
              aria-label="{{ 'sections.recently_viewed.next' | t }}"
              disabled
            >
              {{ 'sections.recently_viewed.next' | t }}
            </button>
          </nav>
        {% endif %}
      </header>

      <div class="cosme-recently-viewed__grid" data-recently-viewed-grid>
        {% liquid
          assign demo_vendor = 'sections.recently_viewed.demo_vendor' | t
          assign demo_price = 'sections.recently_viewed.demo_price' | t
        %}
        {% for i in (1..4) %}
          {% liquid
            assign demo_title_key = 'sections.recently_viewed.demo_product_' | append: i
            assign demo_title = demo_title_key | t
            if i <= desktop_columns
              assign card_loading = 'eager'
            else
              assign card_loading = 'lazy'
            endif
            if i == 1
              assign card_fetchpriority = 'high'
            else
              assign card_fetchpriority = blank
            endif
          %}

          {% render 'cosme-product-card',
            demo_mode: true,
            demo_title: demo_title,
            demo_vendor: demo_vendor,
            demo_price: demo_price,
            layout: 'editorial',
            aspect_ratio: '1/1',
            image_width: 900,
            sizes: card_sizes,
            loading: card_loading,
            fetchpriority: card_fetchpriority,
            show_vendor: true,
            show_price: true,
            show_badge: true,
            show_secondary_image: true,
            show_quick_view: true,
            show_add_to_cart: true
          %}
        {% endfor %}
      </div>

      <p class="cosme-visually-hidden" aria-live="polite" data-recently-viewed-live></p>
    {% elsif section_enabled %}
      <header class="cosme-recently-viewed__header">
        <div class="cosme-recently-viewed__titles">
          <h2 class="cosme-recently-viewed__heading">{{ heading | escape }}</h2>
        </div>

        {% if section.settings.show_navigation %}
          <nav
            class="cosme-recently-viewed__navigation"
            aria-label="{{ 'sections.recently_viewed.navigation' | t }}"
            data-recently-viewed-nav
            hidden
          >
            <button
              type="button"
              class="cosme-recently-viewed__nav-button"
              data-recently-viewed-prev
              aria-label="{{ 'sections.recently_viewed.previous' | t }}"
              disabled
            >
              {{ 'sections.recently_viewed.previous' | t }}
            </button>
            <span class="cosme-recently-viewed__nav-divider" aria-hidden="true">|</span>
            <button
              type="button"
              class="cosme-recently-viewed__nav-button"
              data-recently-viewed-next
              aria-label="{{ 'sections.recently_viewed.next' | t }}"
              disabled
            >
              {{ 'sections.recently_viewed.next' | t }}
            </button>
          </nav>
        {% endif %}
      </header>

      <div class="cosme-recently-viewed__grid" data-recently-viewed-grid></div>

      <p class="cosme-visually-hidden" aria-live="polite" data-recently-viewed-live></p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cosme-recently-viewed {
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .cosme-recently-viewed[hidden] {
    display: none;
  }

  .section-recently-viewed:has(.cosme-recently-viewed[hidden]) {
    display: none;
  }

  .cosme-recently-viewed__inner {
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--spacing-section) var(--page-margin);
  }

  .cosme-recently-viewed[hidden] .cosme-recently-viewed__inner {
    padding: 0;
  }

  .cosme-recently-viewed__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-lg);
    margin-block-end: var(--spacing-2xl);
  }

  .cosme-recently-viewed__titles {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    min-width: 0;
  }

  .cosme-recently-viewed__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 4vw, 2.5rem);
    font-weight: var(--font-heading--weight);
    line-height: 1.05;
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-heading);
  }

  .cosme-recently-viewed__navigation {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex-shrink: 0;
  }

  .cosme-recently-viewed__nav-button {
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 0.8125rem;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    cursor: pointer;
    transition: color var(--transition-duration) var(--transition-easing);
  }

  .cosme-recently-viewed__nav-button:hover:not(:disabled),
  .cosme-recently-viewed__nav-button:focus-visible:not(:disabled) {
    color: var(--color-foreground);
  }

  .cosme-recently-viewed__nav-button:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-accent);
    outline-offset: 2px;
  }

  .cosme-recently-viewed__nav-button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .cosme-recently-viewed__nav-divider {
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1;
    opacity: 0.6;
  }

  .cosme-recently-viewed__grid {
    display: grid;
    grid-template-columns: repeat(var(--recently-viewed-columns-mobile), minmax(0, 1fr));
    gap: var(--spacing-xl) var(--grid-gap);
    touch-action: pan-y;
  }

  .cosme-recently-viewed__grid > * {
    min-width: 0;
  }

  .cosme-recently-viewed .cosme-product-card__title,
  .cosme-recently-viewed .cosme-product-card__vendor,
  .cosme-recently-viewed .cosme-product-card__price {
    overflow-wrap: anywhere;
  }

  .cosme-recently-viewed .cosme-product-card__meta-row {
    gap: var(--spacing-sm);
  }

  .cosme-recently-viewed--enhanced.cosme-recently-viewed--paginated .cosme-recently-viewed__grid > [hidden] {
    display: none;
  }

  @media (min-width: 768px) {
    .cosme-recently-viewed__grid {
      grid-template-columns: repeat(min(var(--recently-viewed-columns-desktop), 3), minmax(0, 1fr));
      gap: var(--spacing-2xl) var(--grid-gap);
    }
  }

  @media (min-width: 990px) {
    .cosme-recently-viewed__grid {
      grid-template-columns: repeat(var(--recently-viewed-columns-desktop), minmax(0, 1fr));
    }

    .cosme-recently-viewed__header {
      margin-block-end: calc(var(--spacing-2xl) + var(--spacing-md));
    }
  }

  @media (max-width: 767px) {
    .cosme-recently-viewed__header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-md);
      margin-block-end: var(--spacing-xl);
    }

    .cosme-recently-viewed__navigation {
      align-self: flex-end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cosme-recently-viewed__nav-button {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    if (window._cosmeRecentlyViewed) return;
    window._cosmeRecentlyViewed = true;

    const initialized = new WeakSet();

    const readHandles = (key) => {
      try {
        const value = JSON.parse(localStorage.getItem(key) || '[]');
        if (!Array.isArray(value)) return [];
        return value.filter((handle) => typeof handle === 'string' && handle !== '');
      } catch (error) {
        return [];
      }
    };

    const writeHandles = (key, handles) => {
      try {
        localStorage.setItem(key, JSON.stringify(handles));
      } catch (error) {
        return;
      }
    };

    const rememberProduct = (key, handle, max) => {
      if (!handle) return;
      const next = readHandles(key).filter((item) => item !== handle);
      next.unshift(handle);
      writeHandles(key, next.slice(0, max));
    };

    const initPagination = (root) => {
      if (!root || initialized.has(root)) return;

      const grid = root.querySelector('[data-recently-viewed-grid]');
      const nav = root.querySelector('[data-recently-viewed-nav]');
      const prevButton = root.querySelector('[data-recently-viewed-prev]');
      const nextButton = root.querySelector('[data-recently-viewed-next]');
      const liveRegion = root.querySelector('[data-recently-viewed-live]');
      const items = grid ? Array.from(grid.children) : [];

      if (!grid || items.length === 0) return;

      initialized.add(root);

      let currentPage = 0;
      let pointerStartX = 0;
      const showNavigation = root.dataset.showNavigation === 'true';
      const pageLabelTemplate = root.dataset.pageLabel || 'Page {current} of {total}';

      const getDesktopColumns = () => {
        const value = getComputedStyle(root).getPropertyValue('--recently-viewed-columns-desktop').trim();
        const parsed = parseInt(value, 10);
        return Number.isNaN(parsed) ? 4 : parsed;
      };

      const getColumnsPerView = () => {
        if (window.matchMedia('(min-width: 990px)').matches) {
          return getDesktopColumns();
        }

        if (window.matchMedia('(min-width: 768px)').matches) {
          return Math.min(getDesktopColumns(), 3);
        }

        return 0;
      };

      const getItemsPerPage = () => {
        const columns = getColumnsPerView();
        return columns > 0 ? columns : items.length;
      };

      const getTotalPages = () => {
        const perPage = getItemsPerPage();
        if (perPage <= 0 || items.length <= perPage) return 1;
        return Math.ceil(items.length / perPage);
      };

      const shouldPaginate = () => {
        const columns = getColumnsPerView();
        return showNavigation && columns > 0 && items.length > columns;
      };

      const formatPageLabel = (current, total) =>
        pageLabelTemplate.replace('{current}', current).replace('{total}', total);

      const announcePage = (current, total) => {
        if (!liveRegion) return;
        liveRegion.textContent = formatPageLabel(current, total);
      };

      const updateUI = () => {
        const paginate = shouldPaginate();
        const perPage = getItemsPerPage();
        const totalPages = getTotalPages();

        if (nav) {
          nav.hidden = !paginate;
        }

        if (!paginate) {
          items.forEach((item) => {
            item.hidden = false;
            item.removeAttribute('aria-hidden');
          });
          root.classList.remove('cosme-recently-viewed--paginated');
          return;
        }

        root.classList.add('cosme-recently-viewed--paginated');

        if (currentPage > totalPages - 1) currentPage = totalPages - 1;
        if (currentPage < 0) currentPage = 0;

        const start = currentPage * perPage;
        const end = start + perPage;

        items.forEach((item, index) => {
          const isVisible = index >= start && index < end;
          item.hidden = !isVisible;
          item.setAttribute('aria-hidden', isVisible ? 'false' : 'true');
        });

        if (prevButton) prevButton.disabled = currentPage === 0;
        if (nextButton) nextButton.disabled = currentPage >= totalPages - 1;
        announcePage(currentPage + 1, totalPages);
      };

      const goToPage = (pageIndex) => {
        const totalPages = getTotalPages();
        const nextPage = Math.max(0, Math.min(pageIndex, totalPages - 1));
        if (nextPage === currentPage) return;
        currentPage = nextPage;
        updateUI();
      };

      if (prevButton) prevButton.addEventListener('click', () => goToPage(currentPage - 1));
      if (nextButton) nextButton.addEventListener('click', () => goToPage(currentPage + 1));

      const onPointerDown = (event) => {
        if (!shouldPaginate()) return;
        if (event.pointerType === 'mouse') return;
        pointerStartX = event.clientX;
      };

      const onPointerUp = (event) => {
        if (!shouldPaginate()) return;
        if (event.pointerType === 'mouse') return;
        const delta = event.clientX - pointerStartX;
        if (Math.abs(delta) < 48) return;
        if (delta < 0) goToPage(currentPage + 1);
        else goToPage(currentPage - 1);
      };

      grid.addEventListener('pointerdown', onPointerDown);
      grid.addEventListener('pointerup', onPointerUp);

      const onResize = () => {
        currentPage = 0;
        updateUI();
      };

      window.addEventListener('resize', onResize);
      root.classList.add('cosme-recently-viewed--enhanced');
      updateUI();

      root._recentlyViewedCleanup = () => {
        window.removeEventListener('resize', onResize);
        grid.removeEventListener('pointerdown', onPointerDown);
        grid.removeEventListener('pointerup', onPointerUp);
      };
    };

    const revealSection = (root) => {
      const grid = root.querySelector('[data-recently-viewed-grid]');
      if (!grid || grid.children.length === 0) {
        root.hidden = true;
        return;
      }

      root.hidden = false;
      root.dataset.ready = 'true';
      initPagination(root);
    };

    const loadViewedProducts = (root) => {
      if (!root || root.dataset.enabled !== 'true') {
        if (root) root.hidden = true;
        return;
      }

      const storageKey = root.dataset.storageKey;
      const currentHandle = root.dataset.productHandle || '';
      const maxProducts = parseInt(root.dataset.maxProducts, 10) || 8;
      const stored = readHandles(storageKey);
      const displayHandles = stored.filter((handle) => handle !== currentHandle).slice(0, maxProducts);

      rememberProduct(storageKey, currentHandle, maxProducts + 1);

      if (displayHandles.length === 0) {
        if (root.dataset.ready === 'true') {
          revealSection(root);
        } else {
          root.hidden = true;
        }
        return;
      }

      const sectionId = root.dataset.cardsSection || 'recently-viewed-cards';
      const searchUrl = root.dataset.searchUrl || '/search';
      let url;

      try {
        url = new URL(searchUrl, window.location.origin);
      } catch (error) {
        root.hidden = true;
        return;
      }

      url.searchParams.set('q', displayHandles.join(','));
      url.searchParams.set('type', 'product');
      url.searchParams.set('section_id', sectionId);

      fetch(url.toString())
        .then((response) => {
          if (!response.ok) throw new Error('section');
          return response.text();
        })
        .then((text) => {
          const doc = new DOMParser().parseFromString(text, 'text/html');
          const incomingGrid = doc.querySelector('[data-recently-viewed-grid]');
          const currentGrid = root.querySelector('[data-recently-viewed-grid]');
          if (!incomingGrid || !currentGrid || incomingGrid.children.length === 0) {
            if (root.dataset.ready === 'true') {
              revealSection(root);
            } else {
              root.hidden = true;
            }
            return;
          }

          currentGrid.innerHTML = incomingGrid.innerHTML;
          revealSection(root);
        })
        .catch(() => {
          if (root.dataset.ready === 'true') {
            revealSection(root);
          } else {
            root.hidden = true;
          }
        });
    };

    const initAll = (container = document) => {
      container.querySelectorAll('[data-recently-viewed]').forEach(loadViewedProducts);
    };

    initAll();

    document.addEventListener('shopify:section:load', (event) => {
      initAll(event.target);
    });

    document.addEventListener('shopify:section:unload', (event) => {
      event.target.querySelectorAll('[data-recently-viewed]').forEach((root) => {
        if (typeof root._recentlyViewedCleanup === 'function') root._recentlyViewedCleanup();
        initialized.delete(root);
      });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.recently_viewed",
  "tag": "section",
  "class": "section-recently-viewed",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "t:sections.recently_viewed.settings.enable",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Recently viewed"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.recently_viewed.settings.products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "t:sections.recently_viewed.settings.columns",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "t:sections.recently_viewed.settings.show_navigation",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:general.recently_viewed"
    }
  ]
}
{% endschema %}
