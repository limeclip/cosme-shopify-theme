                return;
              }
              const visible = entry.isIntersecting && entry.intersectionRatio >= autoplayThreshold(root);
              visibleMap.set(video, visible);

              if (!visible) {
                pauseVideo(video);
                return;
              }

              refreshAutoplay();
            });
          },
          { threshold: [0.2, 0.35, 0.55, 0.75] }
        );

        videos.forEach((video) => {
          if (isCloneSlide(video.closest('.cosme-vertical-video__slide'))) return;
          loadObserver.observe(video);
          playObserver.observe(video);
        });
      }

      const onHidden = () => {
        videos.forEach((video) => pauseVideo(video));
        stopCarouselAutoplay();
      };

      const onVisible = () => {
        if (allowAutoplay(root)) refreshAutoplay();
        startCarouselAutoplay();
      };

      const onMotionChange = () => {
        if (!allowAutoplay(root)) videos.forEach((video) => pauseVideo(video));
        else refreshAutoplay();
        if (allowMotion(root)) startCarouselAutoplay();
        else stopCarouselAutoplay();
      };

      const onVisibility = () => {
        if (document.hidden) onHidden();
        else onVisible();
      };

      document.addEventListener('visibilitychange', onVisibility);

      if (typeof motionQuery.addEventListener === 'function') {
        motionQuery.addEventListener('change', onMotionChange);
      } else if (typeof motionQuery.addListener === 'function') {
        motionQuery.addListener(onMotionChange);
      }

      startCarouselAutoplay();
      refreshAutoplay();

      root._verticalVideoCleanup = () => {
        if (activeFrame) cancelAnimationFrame(activeFrame);
        if (scrollEndTimer) window.clearTimeout(scrollEndTimer);
        stopCarouselAutoplay();
        if (playObserver) playObserver.disconnect();
        if (loadObserver) loadObserver.disconnect();
        if (resizeObserver) resizeObserver.disconnect();
        document.removeEventListener('visibilitychange', onVisibility);
        if (typeof motionQuery.removeEventListener === 'function') {
          motionQuery.removeEventListener('change', onMotionChange);
        } else if (typeof motionQuery.removeListener === 'function') {
          motionQuery.removeListener(onMotionChange);
        }
      };
    };

    const initAll = (container = document) => {
      container.querySelectorAll('[data-vertical-video]').forEach(initVerticalVideo);
    };

    initAll();

    document.addEventListener('shopify:section:load', (event) => {
      initAll(event.target);
    });

    document.addEventListener('shopify:section:unload', (event) => {
      event.target.querySelectorAll('[data-vertical-video]').forEach((root) => {
        if (typeof root._verticalVideoCleanup === 'function') {
          root._verticalVideoCleanup();
        }
        initialized.delete(root);
      });
    });
  })();
