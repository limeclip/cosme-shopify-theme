{% liquid
  assign collection_blocks = section.blocks | where: 'type', 'collection_link'
  assign video_blocks = section.blocks | where: 'type', 'video'
  assign video_count = video_blocks.size

  assign aspect_ratio = section.settings.video_aspect_ratio | default: '9/16'
  assign desktop_cards = section.settings.desktop_cards | default: '5'
  assign mobile_cards = section.settings.mobile_cards | default: '1.5'

  assign show_categories = false
  if section.settings.layout == 'video_collections'
    if section.settings.show_category_navigation
      if collection_blocks.size > 0
        assign show_categories = true
      endif
    endif
  endif

  assign show_arrows = false
  if section.settings.show_arrows
    if video_count > 1
      assign show_arrows = true
    endif
  endif

  assign heading_align_class = 'cosme-vertical-video--align-left'
  if section.settings.heading_alignment == 'center'
    assign heading_align_class = 'cosme-vertical-video--align-center'
  endif
%}

<section
  id="VerticalVideo-{{ section.id }}"
  class="cosme-vertical-video full-width color-{{ section.settings.color_scheme }} {{ heading_align_class }}"
  style="
    --vertical-video-ratio: {{ aspect_ratio }};
    --vertical-video-desktop-cards: {{ desktop_cards }};
    --vertical-video-mobile-cards: {{ mobile_cards }};
  "
  data-vertical-video
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-behavior="{{ section.settings.autoplay_behavior | default: 'viewport' }}"
  data-carousel-autoplay="{{ section.settings.carousel_autoplay }}"
  data-carousel-autoplay-delay="{{ section.settings.carousel_autoplay_delay | default: 5000 }}"
  data-enable-animations="{{ settings.enable_animations }}"
  data-slide-count="{{ video_count }}"
  aria-label="{{ 'sections.vertical_video.landmark_label' | t }}"
  {{ section.shopify_attributes }}
>
  <div class="cosme-vertical-video__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <header class="cosme-vertical-video__header">
        {% if section.settings.eyebrow != blank %}
          <p class="cosme-vertical-video__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="cosme-vertical-video__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </header>
    {% endif %}

    {% if show_categories %}
      <nav
        class="cosme-vertical-video__categories"
        aria-label="{{ 'sections.vertical_video.category_navigation' | t }}"
      >
        <ul class="cosme-vertical-video__category-track">
          {%- for block in collection_blocks -%}
            {%- liquid
              assign category_collection = block.settings.collection
              assign category_label = block.settings.label
              if category_label == blank and category_collection != blank
                assign category_label = category_collection.title
              endif

              assign category_url = blank
              if category_collection != blank
                assign category_url = category_collection.url
              endif

              assign category_image = blank
              if block.settings.image != blank
                assign category_image = block.settings.image
              elsif category_collection != blank
                assign category_image = category_collection.featured_image
              endif

              assign image_fit_class = 'cosme-vertical-video__category-image--cover'
              if block.settings.image_fit == 'contain'
                assign image_fit_class = 'cosme-vertical-video__category-image--contain'
              endif
              assign category_image_classes = 'cosme-vertical-video__category-image ' | append: image_fit_class

              assign placeholder_name = 'collection-' | append: forloop.index
            -%}

            {% if category_label != blank %}
              <li class="cosme-vertical-video__category-item" {{ block.shopify_attributes }}>
                {% if category_url != blank %}
                  <a
                    class="cosme-vertical-video__category"
                    href="{{ category_url }}"
                    aria-label="{{ category_label | escape }}"
                  >
                {% else %}
                  <div class="cosme-vertical-video__category cosme-vertical-video__category--static">
                {% endif %}
                <div class="cosme-vertical-video__category-media" aria-hidden="true">
                  {% if category_image != blank %}
                    {% render 'cosme-image',
                      image: category_image,
                      alt: '',
                      class: category_image_classes,
                      width: 700,
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 16vw, 42vw'
                    %}
                  {% else %}
                    {{ placeholder_name | placeholder_svg_tag: 'cosme-vertical-video__category-placeholder' }}
                  {% endif %}
                </div>
                <span class="cosme-vertical-video__category-label">{{ category_label | escape }}</span>
                {% if category_url != blank %}
                  </a>
                {% else %}
                  </div>
                {% endif %}
              </li>
            {% endif %}
          {%- endfor -%}
        </ul>
      </nav>
    {% endif %}

    {% if video_count > 0 %}
      <div class="cosme-vertical-video__carousel">
        {% if show_arrows %}
          <button
            type="button"
            class="cosme-vertical-video__arrow cosme-vertical-video__arrow--prev"
            data-vertical-video-prev
            aria-label="{{ 'sections.vertical_video.previous' | t }}"
          >
            {% render 'cosme-icon', icon: 'chevron-left' %}
          </button>
        {% endif %}

        <div class="cosme-vertical-video__viewport" data-vertical-video-viewport>
          <ul class="cosme-vertical-video__track" data-vertical-video-track>
            {%- for block in video_blocks -%}
              {%- liquid
                assign video = block.settings.video
                assign poster = block.settings.poster
                assign product = block.settings.product
                assign product_position = block.settings.product_position | default: 'bottom-left'

                assign video_label = block.settings.video_alt
                if video_label == blank and video != blank
                  assign video_label = video.alt
                endif

                assign fallback_image = poster
                if fallback_image == blank and video != blank
                  assign fallback_image = video.preview_image
                endif

                assign poster_url = blank
                if fallback_image != blank
                  assign poster_url = fallback_image | image_url: width: 900
                endif

                assign show_block_product = false
                if section.settings.show_product
                  if block.settings.show_product
                    assign show_block_product = true
                  endif
                endif

                assign has_real_product = false
                if show_block_product
                  if product != blank
                    assign has_real_product = true
                  endif
                endif

                assign media_url = blank
                assign media_label = blank
                unless has_real_product
                  if block.settings.link != blank
                    assign media_url = block.settings.link
                    if block.settings.custom_label != blank
                      assign media_label = block.settings.custom_label
                    elsif video_label != blank
                      assign media_label = video_label
                    else
                      assign media_label = 'sections.vertical_video.open_media' | t
                    endif
                  endif
                endunless

                assign demo_placeholder = 'product-1'
                assign demo_title = 'sections.vertical_video.demo_product_1' | t
                assign demo_price = 3800
                case forloop.index
                  when 2
                    assign demo_placeholder = 'product-2'
                    assign demo_title = 'sections.vertical_video.demo_product_2' | t
                    assign demo_price = 2400
                  when 3
                    assign demo_placeholder = 'product-3'
                    assign demo_title = 'sections.vertical_video.demo_product_3' | t
                    assign demo_price = 4200
                  when 4
                    assign demo_placeholder = 'product-4'
                    assign demo_title = 'sections.vertical_video.demo_product_4' | t
                    assign demo_price = 5800
                  when 5
                    assign demo_placeholder = 'product-5'
                    assign demo_title = 'sections.vertical_video.demo_product_5' | t
                    assign demo_price = 3600
                  when 6
                    assign demo_placeholder = 'product-6'
                    assign demo_title = 'sections.vertical_video.demo_product_6' | t
                    assign demo_price = 6400
                endcase

                if forloop.first
                  assign media_loading = 'eager'
                else
                  assign media_loading = 'lazy'
                endif
              -%}

              <li
                class="cosme-vertical-video__slide{% if forloop.first %} is-active{% endif %}"
                {{ block.shopify_attributes }}
              >
                <article class="cosme-vertical-video__card">
                  <div
                    class="cosme-vertical-video__media{% if video != blank %} cosme-vertical-video__media--has-video{% endif %}"
                    data-vertical-video-card
                  >
                    {% if video != blank %}
                      {% if fallback_image != blank %}
                        <div class="cosme-vertical-video__fallback" aria-hidden="true">
                          {% render 'cosme-image',
                            image: fallback_image,
                            alt: '',
                            class: 'cosme-vertical-video__poster',
                            width: 900,
                            loading: media_loading,
                            sizes: '(min-width: 990px) 18vw, 62vw'
                          %}
                        </div>
                      {% endif %}

                      {% if media_url != blank %}
                        <a
                          class="cosme-vertical-video__media-link"
                          href="{{ media_url }}"
                          aria-label="{{ media_label | escape }}"
                        >
                      {% endif %}
                      <video
                        class="cosme-vertical-video__video"
                        playsinline
                        loop
                        muted
                        preload="none"
                        controlslist="nodownload nofullscreen noremoteplayback"
                        disablepictureinpicture
                        {% if poster_url != blank %}
                          poster="{{ poster_url }}"
                        {% endif %}
                        {% if video_label != blank %}
                          aria-label="{{ video_label | escape }}"
                        {% endif %}
                        data-vertical-video-media
                      >
                        {%- for source in video.sources -%}
                          <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {%- endfor -%}
                      </video>
                      {% if media_url != blank %}
                        </a>
                      {% endif %}

                      <div class="cosme-vertical-video__controls">
                        <button
                          type="button"
                          class="cosme-vertical-video__control"
                          data-vertical-video-mute
                          aria-pressed="true"
                          aria-label="{{ 'sections.vertical_video.unmute' | t }}"
                          data-label-mute="{{ 'sections.vertical_video.mute' | t }}"
                          data-label-unmute="{{ 'sections.vertical_video.unmute' | t }}"
                        >
                          <span data-icon-muted>
                            {% render 'cosme-icon', icon: 'volume-off', size: 'xl' %}
                          </span>
                          <span data-icon-unmuted hidden>
                            {% render 'cosme-icon', icon: 'volume', size: 'xl' %}
                          </span>
                        </button>

                        <button
                          type="button"
                          class="cosme-vertical-video__control"
                          data-vertical-video-playback
                          aria-pressed="false"
                          aria-label="{{ 'sections.vertical_video.play' | t }}"
                          data-label-play="{{ 'sections.vertical_video.play' | t }}"
                          data-label-pause="{{ 'sections.vertical_video.pause' | t }}"
                        >
                          <span data-icon-play>
                            {% render 'cosme-icon', icon: 'play', size: 'xl' %}
                          </span>
                          <span data-icon-pause hidden>
                            {% render 'cosme-icon', icon: 'pause', size: 'xl' %}
                          </span>
                        </button>
                      </div>
                    {% elsif poster != blank %}
                      {% if media_url != blank %}
                        <a
                          class="cosme-vertical-video__media-link"
                          href="{{ media_url }}"
                          aria-label="{{ media_label | escape }}"
                        >
                      {% endif %}
                      {% render 'cosme-image',
                        image: poster,
                        alt: video_label,
                        class: 'cosme-vertical-video__poster',
                        width: 900,
                        loading: media_loading,
                        sizes: '(min-width: 990px) 18vw, 62vw'
                      %}
                      {% if media_url != blank %}
                        </a>
                      {% endif %}
                    {% else %}
                      {% if media_url != blank %}
                        <a
                          class="cosme-vertical-video__media-link"
                          href="{{ media_url }}"
                          aria-label="{{ media_label | escape }}"
                        >
                      {% endif %}
                      <div
                        class="cosme-vertical-video__placeholder"
                        {% if video_label != blank %}
                          role="img"
                          aria-label="{{ video_label | escape }}"
                        {% else %}
                          aria-hidden="true"
                        {% endif %}
                      >
                        {{ demo_placeholder | placeholder_svg_tag: 'cosme-vertical-video__placeholder-svg' }}
                      </div>
                      {% if media_url != blank %}
                        </a>
                      {% endif %}
                    {% endif %}

                    <div class="product-bottom-wrapper">
                      {% if block.settings.custom_label != blank %}
                        <p class="cosme-vertical-video__caption">{{ block.settings.custom_label | escape }}</p>
                      {% endif %}

                      {% if has_real_product %}
                        <div class="cosme-vertical-video__product cosme-vertical-video__product--{{ product_position }}">
                          <a
                            class="cosme-vertical-video__product-link"
                            href="{{ product.url }}"
                            aria-label="{{ 'sections.vertical_video.view_product' | t: title: product.title }}"
                          >
                            {% if section.settings.show_product_image %}
                              {% if product.featured_image != blank %}
                                <span class="cosme-vertical-video__product-image">
                                  {% render 'cosme-image',
                                    image: product.featured_image,
                                    alt: '',
                                    class: 'cosme-vertical-video__product-thumb',
                                    width: 160,
                                    height: 160,
                                    crop: 'center',
                                    loading: 'lazy',
                                    aspect_ratio: '1/1'
                                  %}
                                </span>
                              {% endif %}
                            {% endif %}

                            <span class="cosme-vertical-video__product-copy">
                              <span class="cosme-vertical-video__product-title">{{ product.title | escape }}</span>
                              {% render 'cosme-price',
                                product: product,
                                show_compare_at: false,
                                show_from: false,
                                class: 'cosme-vertical-video__product-price'
                              %}
                            </span>
                          </a>

                          <button
                            type="button"
                            class="cosme-vertical-video__product-add"
                            data-quick-view
                            data-product-handle="{{ product.handle }}"
                            data-product-url="{{ product.url }}"
                            aria-label="{{ 'products.quick_view' | t: title: product.title }}"
                          >
                            {% render 'cosme-icon', icon: 'plus' %}
                          </button>
                        </div>
                      {% elsif show_block_product %}
                        <div class="cosme-vertical-video__product cosme-vertical-video__product--{{ product_position }} cosme-vertical-video__product--demo">
                          {% if section.settings.show_product_image %}
                            <span class="cosme-vertical-video__product-image" aria-hidden="true">
                              {{ demo_placeholder | placeholder_svg_tag: 'cosme-vertical-video__product-placeholder' }}
                            </span>
                          {% endif %}
                          <span class="cosme-vertical-video__product-copy">
                            <span class="cosme-vertical-video__product-title">{{ demo_title | escape }}</span>
                            <span class="cosme-vertical-video__product-price">{{ demo_price | money }}</span>
                          </span>
                          <span class="cosme-vertical-video__product-add" aria-hidden="true">
                            {% render 'cosme-icon', icon: 'plus' %}
                          </span>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </article>
              </li>
            {%- endfor -%}
          </ul>
        </div>

        {% if show_arrows %}
          <button
            type="button"
            class="cosme-vertical-video__arrow cosme-vertical-video__arrow--next"
            data-vertical-video-next
            aria-label="{{ 'sections.vertical_video.next' | t }}"
          >
            {% render 'cosme-icon', icon: 'chevron-right' %}
          </button>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cosme-vertical-video {
    --vertical-video-gap: var(--grid-gap);
    --vertical-video-visible: var(--vertical-video-mobile-cards);
    --vertical-video-span: var(--vertical-video-visible);

    overflow-x: clip;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .cosme-vertical-video__inner {
    width: 100%;
    max-width: var(--page-width);
    min-width: 0;
    margin-inline: auto;
    padding: var(--spacing-xl) var(--page-margin);
  }

  .cosme-vertical-video__header {
    display: grid;
    gap: var(--spacing-sm);
    margin-block-end: var(--spacing-lg);
  }

  .cosme-vertical-video--align-center .cosme-vertical-video__header {
    justify-items: center;
    text-align: center;
  }

  .cosme-vertical-video__eyebrow {
    margin: 0;
    font-size: 0.6875rem;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-vertical-video__heading {
    margin: 0;
    max-width: min(22ch, 100%);
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: var(--font-heading--weight);
    line-height: 1.08;
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-heading);
  }

  .cosme-vertical-video__categories {
    margin-block-end: var(--spacing-lg);
  }

  .cosme-vertical-video__category-track,
  .cosme-vertical-video__track {
    display: flex;
    gap: var(--vertical-video-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cosme-vertical-video__category-track {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .cosme-vertical-video__category-track::-webkit-scrollbar {
    display: none;
  }

  .cosme-vertical-video__category-item {
    flex: 0 0 calc((100% - (var(--vertical-video-gap) * 1.4)) / 2.4);
    min-width: 0;
    scroll-snap-align: start;
  }

  .cosme-vertical-video__category {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-card);
    text-decoration: none;
    color: inherit;
    isolation: isolate;
  }

  .cosme-vertical-video__category--static {
    cursor: default;
  }

  .cosme-vertical-video__category-media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: var(--color-background-2);
    border-radius: var(--radius-card);
  }

  .cosme-vertical-video__category-media .cosme-image,
  .cosme-vertical-video__category-media .cosme-image__img,
  .cosme-vertical-video__category-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cosme-vertical-video__category-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0);
    opacity: 0.35;
  }

  /* === Плейсхолдеры для видео (демо-заглушки) === */
  .cosme-vertical-video__placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    filter: brightness(0);
    opacity: 0.45;
  }

  /* === Плейсхолдеры для продуктов в демо-режиме === */
  .cosme-vertical-video__product-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    filter: brightness(0);
    opacity: 0.45;
  }

  /* === Тёмная схема (color-scheme-2, т.е. Dark) === */
  .color-scheme-2 .cosme-vertical-video__category-placeholder,
  .color-scheme-2 .cosme-vertical-video__placeholder-svg,
  .color-scheme-2 .cosme-vertical-video__product-placeholder {
    filter: brightness(0) invert(1);
    opacity: 0.45;
  }
  .cosme-vertical-video__category-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--color-overlay) 42%, transparent), transparent 55%);
    pointer-events: none;
  }

  .cosme-vertical-video__category-label {
    position: absolute;
    z-index: 1;
    top: var(--spacing-sm);
    left: var(--spacing-sm);
    max-width: calc(100% - var(--spacing-md));
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-button);
    background-color: transparent;
    color: var(--color-accent-contrast);
    font-size: 1rem;
    line-height: 1.3;
    letter-spacing: normal;
    font-weight: 500;
  }

  .cosme-vertical-video__track {
  position: relative;
  align-items: flex-end;
}

  .cosme-vertical-video__carousel {
    position: relative;
    min-width: 0;
    max-width: 100%;
    padding-block-start: var(--spacing-md);
  }

  .cosme-vertical-video__viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
  }

  .cosme-vertical-video__viewport::-webkit-scrollbar {
    display: none;
  }

  .cosme-vertical-video__slide {
    flex: 0 0 calc((100% - (var(--vertical-video-gap) * (var(--vertical-video-span) - 1))) / var(--vertical-video-span));
    min-width: 0;
    scroll-snap-align: center;
    scroll-snap-stop: normal;
    transform: scale(0.88);
    transform-origin: center center;
    transition: transform var(--animation-duration) var(--transition-easing);
    cursor: pointer;
  }

  .cosme-vertical-video__slide.is-active {
    transform: scale(1);
    z-index: 1;
    cursor: default;
  }

  .cosme-vertical-video__card {
    display: block;
    height: 100%;
  }

  .cosme-vertical-video__media-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .cosme-vertical-video__media-link .cosme-vertical-video__video,
  .cosme-vertical-video__media-link .cosme-image {
    height: 100%;
  }

  .cosme-vertical-video__media {
    position: relative;
    display: block;
    overflow: hidden;
    height: 100%;
    aspect-ratio: var(--vertical-video-ratio);
    border-radius: var(--radius-card);
    background-color: var(--color-background-2);
  }

  .cosme-vertical-video__video,
  .cosme-vertical-video__fallback .cosme-image,
  .cosme-vertical-video__fallback .cosme-image__img,
  .cosme-vertical-video__media-link .cosme-image,
  .cosme-vertical-video__media-link .cosme-image__img,
  .cosme-vertical-video__placeholder,
  .cosme-vertical-video__placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cosme-vertical-video__media::after {
    content: '';
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    height: 42%;
    background: linear-gradient(to top, color-mix(in srgb, var(--color-overlay) 62%, transparent), transparent);
    pointer-events: none;
  }

  .cosme-vertical-video__fallback {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 1;
    transition: opacity var(--transition-duration) var(--transition-easing);
  }

  .cosme-vertical-video__video {
    z-index: 0;
  }

  /* Когда видео играет, скрываем постер */
  .cosme-vertical-video__media--playing .cosme-vertical-video__fallback {
    opacity: 0;
    pointer-events: none;
  }
  .cosme-vertical-video__media--error .cosme-vertical-video__video,
  .cosme-vertical-video__media--error .cosme-vertical-video__controls,
  .cosme-vertical-video__media--error .cosme-vertical-video__media-link {
    display: none;
  }

  .cosme-vertical-video__controls {
    position: absolute;
    z-index: 4;
    top: var(--spacing-sm);
    right: var(--spacing-sm);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-duration) var(--transition-easing);
  }

  .cosme-vertical-video__media:hover .cosme-vertical-video__controls,
  .cosme-vertical-video__media:focus-within .cosme-vertical-video__controls,
  .cosme-vertical-video__media--playing .cosme-vertical-video__controls,
  .cosme-vertical-video__slide.is-active .cosme-vertical-video__controls {
    opacity: 1;
  }

  .cosme-vertical-video__control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
