{% liquid
  assign icon_style = section.settings.icon_style | default: 'plus_minus'
  assign open_first_row = false
  if section.settings.open_first_row
    assign open_first_row = true
  endif
  assign show_full_description = false
  if section.settings.show_full_description
    assign show_full_description = true
  endif
  assign show_trust = false
  if section.settings.show_trust
    assign show_trust = true
  endif

  assign first_row_opened = false
%}

<section
  id="ProductDetails-{{ section.id }}"
  class="cosme-product-details full-width color-{{ section.settings.color_scheme }} cosme-product-details--icon-{{ icon_style }}"
  aria-label="{{ 'sections.product_details.landmark_label' | t }}"
  {{ section.shopify_attributes }}
>
  <div class="cosme-product-details__inner">
    {% if show_trust %}
      <div class="cosme-product-details__trust">
        {% render 'cosme-trust-bar',
          item_1_icon: 'shipping',
          item_1_heading: section.settings.trust_shipping,
          item_2_icon: 'secure',
          item_2_heading: section.settings.trust_payment,
          item_3_icon: 'return',
          item_3_heading: section.settings.trust_returns
        %}
      </div>
    {% endif %}

    <div class="cosme-product-details__accordion">
      {% for block in section.blocks %}
        {% liquid
          assign row_enabled = true
          if block.settings.enabled == false
            assign row_enabled = false
          endif

          assign row_heading = block.settings.heading | strip
          assign row_content = ''
          assign row_has_content = false
        %}

        {% if row_enabled %}
          {% case block.type %}
            {% when 'description' %}
              {% if show_full_description %}
                {% if product.description != blank %}
                  {% if row_heading == blank %}
                    {% assign row_heading = 'products.details.description' | t %}
                  {% endif %}
                  {% capture row_content %}
                    <div class="cosme-rte">{{ product.description }}</div>
                  {% endcapture %}
                {% endif %}
              {% endif %}

            {% when 'information' %}
              {% if row_heading == blank %}
                {% assign row_heading = 'products.details.information' | t %}
              {% endif %}
              {% capture row_content %}
                {% render 'cosme-metafield',
                  product: product,
                  namespace: block.settings.metafield_namespace,
                  key: block.settings.metafield_key
                %}
              {% endcapture %}
              {% assign metafield_plain = row_content | strip_html | strip %}
              {% if metafield_plain == blank %}
                {% if block.settings.content != blank %}
                  {% capture row_content %}
                    <div class="cosme-rte">{{ block.settings.content }}</div>
                  {% endcapture %}
                {% else %}
                  {% assign row_content = '' %}
                {% endif %}
              {% endif %}
          {% endcase %}

          {% assign row_plain = row_content | strip_html | strip %}
          {% if row_plain != blank %}
            {% if row_heading != blank %}
              {% assign row_has_content = true %}
            {% endif %}
          {% endif %}
        {% endif %}

        {% if row_has_content %}
          {% liquid
            assign row_open = false
            if open_first_row
              unless first_row_opened
                assign row_open = true
                assign first_row_opened = true
              endunless
            endif
            assign row_id = 'ProductDetailsRow-' | append: section.id | append: '-' | append: block.id
          %}
          <details
            class="cosme-product-details__item"
            id="{{ row_id }}"
            {% if row_open %}
              open
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="cosme-product-details__summary">
              <span class="cosme-product-details__title">{{ row_heading | escape }}</span>
              <span class="cosme-product-details__icon" aria-hidden="true">
                {% if icon_style == 'chevron' %}
                  {% render 'cosme-icon', icon: 'chevron-down', size: 'sm' %}
                {% else %}
                  <span class="cosme-product-details__icon-plus">
                    {% render 'cosme-icon', icon: 'plus', size: 'sm' %}
                  </span>
                  <span class="cosme-product-details__icon-minus">
                    {% render 'cosme-icon', icon: 'minus', size: 'sm' %}
                  </span>
                {% endif %}
              </span>
            </summary>
            <div class="cosme-product-details__panel">
              <div class="cosme-product-details__content">
                {{ row_content }}
              </div>
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .cosme-product-details {
    background-color: var(--color-background);
    color: var(--color-foreground);
    overflow-x: hidden;
    max-width: 100%;
  }

  .cosme-product-details__inner {
    width: 100%;
    max-width: var(--content-width);
    min-width: 0;
    margin-inline: auto;
    padding: var(--spacing-section) var(--page-margin);
  }

  .cosme-product-details__trust {
    margin-block-end: var(--spacing-lg);
  }

  .cosme-product-details__accordion {
    width: 100%;
    max-width: 42rem;
    min-width: 0;
  }

  .cosme-product-details__item {
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .cosme-product-details__item:first-child {
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .cosme-product-details__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    width: 100%;
    min-height: 3.25rem;
    padding-block: 0.9rem;
    cursor: pointer;
    list-style: none;
    color: var(--color-heading);
  }

  .cosme-product-details__summary::-webkit-details-marker {
    display: none;
  }

  .cosme-product-details__summary:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-accent);
    outline-offset: 4px;
  }

  .cosme-product-details__title {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: 0.8125rem;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .cosme-product-details__icon {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-foreground);
  }

  .cosme-product-details__icon-minus {
    display: none;
  }

  .cosme-product-details__item[open] .cosme-product-details__icon-plus {
    display: none;
  }

  .cosme-product-details__item[open] .cosme-product-details__icon-minus {
    display: inline-flex;
  }

  .cosme-product-details--icon-chevron .cosme-product-details__icon {
    transition: transform var(--transition-duration) var(--transition-easing);
  }

  .cosme-product-details--icon-chevron .cosme-product-details__item[open] .cosme-product-details__icon {
    transform: rotate(180deg);
  }

  .cosme-product-details__item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.35s var(--transition-easing),
      content-visibility 0.35s allow-discrete;
  }

  .cosme-product-details__item[open]::details-content {
    block-size: auto;
  }

  .cosme-product-details__content {
    padding-block: 0 1.25rem;
    max-width: 40rem;
    font-size: 0.9375rem;
    line-height: var(--line-height-body);
    color: var(--color-muted);
    overflow-wrap: anywhere;
    text-align: left;
  }

  .cosme-product-details__content p,
  .cosme-product-details__content ul,
  .cosme-product-details__content ol {
    margin: 0 0 0.75rem;
  }

  .cosme-product-details__content ul,
  .cosme-product-details__content ol {
    padding-inline-start: 1.1rem;
  }

  .cosme-product-details__content .cosme-rte > *:first-child {
    margin-block-start: 0;
  }

  .cosme-product-details__content .cosme-rte > *:last-child {
    margin-block-end: 0;
  }

  .cosme-product-details__content a {
    color: var(--color-foreground);
  }

  .cosme-product-details__content a:hover,
  .cosme-product-details__content a:focus-visible {
    color: var(--color-accent);
  }

  .cosme-product-details__accordion:empty,
  .cosme-product-details__trust:empty {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .cosme-product-details__inner {
      padding-block: var(--spacing-lg);
    }

    .cosme-product-details__accordion {
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_details",
  "tag": "div",
  "class": "section-product-details",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.product_details.settings.content_header"
    },
    {
      "type": "checkbox",
      "id": "show_full_description",
      "label": "t:sections.product_details.settings.show_full_description",
      "info": "t:sections.product_details.settings.show_full_description_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_first_row",
      "label": "t:sections.product_details.settings.open_first_row",
      "default": true
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "t:sections.product_details.settings.icon_style",
      "options": [
        {
          "value": "plus_minus",
          "label": "t:sections.product_details.settings.icon_plus"
        },
        {
          "value": "chevron",
          "label": "t:sections.product_details.settings.icon_chevron"
        }
      ],
      "default": "plus_minus"
    },
    {
      "type": "header",
      "content": "t:sections.product_details.settings.trust_header"
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "t:sections.product_details.settings.show_trust",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_shipping",
      "label": "t:sections.product_details.settings.trust_shipping",
      "default": "Free shipping",
      "visible_if": "{{ section.settings.show_trust }}"
    },
    {
      "type": "text",
      "id": "trust_payment",
      "label": "t:sections.product_details.settings.trust_payment",
      "default": "Secure payment",
      "visible_if": "{{ section.settings.show_trust }}"
    },
    {
      "type": "text",
      "id": "trust_returns",
      "label": "t:sections.product_details.settings.trust_returns",
      "default": "Easy returns",
      "visible_if": "{{ section.settings.show_trust }}"
    }
  ],
  "blocks": [
    {
      "type": "description",
      "name": "t:sections.product_details.blocks.description.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "t:sections.product_details.blocks.shared.enabled",
          "default": true
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Description"
        }
      ]
    },
    {
      "type": "information",
      "name": "t:sections.product_details.blocks.information.name",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "t:sections.product_details.blocks.shared.enabled",
          "default": true
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Ingredients"
        },
        {
          "type": "text",
          "id": "metafield_namespace",
          "label": "t:sections.product_details.blocks.information.namespace",
          "info": "t:sections.product_details.blocks.information.namespace_info",
          "default": "custom"
        },
        {
          "type": "text",
          "id": "metafield_key",
          "label": "t:sections.product_details.blocks.information.key",
          "info": "t:sections.product_details.blocks.information.key_info"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.product_details.blocks.information.content",
          "info": "t:sections.product_details.blocks.information.content_info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.product_details",
      "settings": {
        "color_scheme": "scheme-1",
        "show_full_description": true,
        "open_first_row": true,
        "icon_style": "plus_minus",
        "show_trust": true,
        "trust_shipping": "Free shipping",
        "trust_payment": "Secure payment",
        "trust_returns": "Easy returns"
      },
      "blocks": [
        {
          "type": "description",
          "settings": {
            "enabled": true,
            "heading": "Description"
          }
        },
        {
          "type": "information",
          "settings": {
            "enabled": true,
            "heading": "Ingredients",
            "metafield_namespace": "custom",
            "metafield_key": "ingredients"
          }
        },
        {
          "type": "information",
          "settings": {
            "enabled": true,
            "heading": "How to use",
            "metafield_namespace": "custom",
            "metafield_key": "how_to_use"
          }
        },
        {
          "type": "information",
          "settings": {
            "enabled": true,
            "heading": "Shipping & returns",
            "metafield_namespace": "custom",
            "metafield_key": "shipping_information"
          }
        },
        {
          "type": "information",
          "settings": {
            "enabled": true,
            "heading": "Additional information",
            "metafield_namespace": "custom",
            "metafield_key": "additional_information"
          }
        }
      ]
    }
  ]
}
{% endschema %}
