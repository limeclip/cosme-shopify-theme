{% liquid
  assign heading_id = 'PasswordHeading-' | append: section.id
  assign password_form_id = 'PasswordForm-' | append: section.id
  assign password_input_id = 'PasswordInput-' | append: section.id
  assign newsletter_form_id = 'PasswordNewsletter-' | append: section.id
  assign newsletter_email_id = 'PasswordNewsletterEmail-' | append: section.id
  assign newsletter_success_id = 'PasswordNewsletterSuccess-' | append: section.id
  assign newsletter_heading_id = 'PasswordNewsletterHeading-' | append: section.id

  assign eyebrow = section.settings.eyebrow | strip
  assign heading = section.settings.heading | strip
  assign description = section.settings.description | strip
  assign password_label = section.settings.password_label | strip
  assign password_button_label = section.settings.password_button_label | strip

  if heading == blank
    assign heading = shop.name
  endif

  if password_label == blank
    assign password_label = 'password.password' | t
  endif

  if password_button_label == blank
    assign password_button_label = 'password.enter' | t
  endif

  assign show_image = false
  if section.settings.show_image
    if section.settings.image != blank
      assign show_image = true
    endif
  endif

  case section.settings.image_ratio
    when 'landscape'
      assign image_aspect_ratio = '3/2'
    when 'square'
      assign image_aspect_ratio = '1/1'
    when 'wide'
      assign image_aspect_ratio = '16/9'
    else
      assign image_aspect_ratio = '4/5'
  endcase

  assign image_alt = section.settings.image.alt | default: heading

  assign show_newsletter = section.settings.show_newsletter
  assign newsletter_eyebrow = section.settings.newsletter_eyebrow | strip
  assign newsletter_heading = section.settings.newsletter_heading | strip
  assign newsletter_description = section.settings.newsletter_description | strip
  assign newsletter_button_label = section.settings.newsletter_button_label | strip
  if newsletter_button_label == blank
    assign newsletter_button_label = 'password.newsletter_submit' | t
  endif
  assign newsletter_email_label = 'password.newsletter_email_label' | t
%}

<a class="cosme-skip-link full-width" href="#MainContent">
  {{ 'password.skip_to_content' | t }}
</a>

<main
  id="MainContent"
  class="
    cosme-password
    full-width
    color-{{ section.settings.color_scheme }}
    {% if show_image %}cosme-password--has-image{% else %}cosme-password--solo{% endif %}
  "
  aria-labelledby="{{ heading_id }}"
  {{ section.shopify_attributes }}
>
  <div class="cosme-password__panel">
    <div class="cosme-password__intro">
      <div
        class="cosme-password__brand"
        {% if settings.logo != blank %}
          style="--cosme-password-logo-width: {{ settings.logo_width }}px;"
        {% endif %}
      >
        {%- if settings.logo != blank -%}
          {%- capture logo_sizes -%}{{ settings.logo_width }}px{%- endcapture -%}
          {% render 'cosme-image',
            image: settings.logo,
            class: 'cosme-password__logo-media',
            width: settings.logo_width,
            sizes: logo_sizes,
            loading: 'eager',
            alt: shop.name
          %}
        {%- else -%}
          <span class="cosme-password__logo-text">{{ shop.name | escape }}</span>
        {%- endif -%}
      </div>

      {% if eyebrow != blank %}
        <p class="cosme-password__eyebrow">{{ eyebrow | escape }}</p>
      {% endif %}

      <h1 class="cosme-password__title" id="{{ heading_id }}">{{ heading | escape }}</h1>

      {% if description != blank %}
        <p class="cosme-password__description">{{ description | escape }}</p>
      {% endif %}
    </div>

    <div class="cosme-password__forms">
      {% form 'storefront_password', id: password_form_id, class: 'cosme-password__form' %}
        {% liquid
          assign password_error = blank
          if form.errors
            assign password_error = form.errors.messages['form']
            if password_error == blank
              assign password_error = 'password.error' | t
            endif
          endif
        %}

        {% render 'cosme-form-field',
          label: password_label,
          id: password_input_id,
          name: 'password',
          type: 'password',
          required: true,
          autocomplete: 'current-password',
          error: password_error,
          class: 'cosme-password__field'
        %}

        {% render 'cosme-button',
          label: password_button_label,
          type: 'submit',
          style: 'primary',
          class: 'cosme-password__submit'
        %}
      {% endform %}

      {% if show_newsletter %}
        <section
          class="cosme-password__newsletter color-{{ section.settings.newsletter_color_scheme }}"
          {% if newsletter_heading != blank %}
            aria-labelledby="{{ newsletter_heading_id }}"
          {% else %}
            aria-label="{{ 'password.newsletter_label' | t }}"
          {% endif %}
        >
          {% if newsletter_eyebrow != blank %}
            <p class="cosme-password__newsletter-eyebrow">{{ newsletter_eyebrow | escape }}</p>
          {% endif %}

          {% if newsletter_heading != blank %}
            <h2 class="cosme-password__newsletter-heading" id="{{ newsletter_heading_id }}">
              {{ newsletter_heading | escape }}
            </h2>
          {% endif %}

          {% if newsletter_description != blank %}
            <p class="cosme-password__newsletter-description">{{ newsletter_description | escape }}</p>
          {% endif %}

          {% form 'customer', id: newsletter_form_id, class: 'cosme-password__newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="prospect, password page">
            <input type="hidden" name="customer[accepts_marketing]" value="true">

            {% liquid
              assign newsletter_error = blank
              assign newsletter_posted = false
              if form.posted_successfully?
                assign newsletter_posted = true
              endif
              if form.errors
                assign newsletter_error = 'password.newsletter_error' | t
              endif
            %}

            {% if newsletter_posted %}
              <p
                class="cosme-password__newsletter-status"
                id="{{ newsletter_success_id }}"
                role="status"
                aria-live="polite"
                tabindex="-1"
              >
                {{ 'password.newsletter_success' | t }}
              </p>
            {% endif %}

            {% render 'cosme-form-field',
              label: newsletter_email_label,
              id: newsletter_email_id,
              name: 'contact[email]',
              type: 'email',
              value: form.email,
              required: true,
              autocomplete: 'email',
              error: newsletter_error,
              class: 'cosme-password__newsletter-field'
            %}

            {% render 'cosme-button',
              label: newsletter_button_label,
              type: 'submit',
              style: 'secondary',
              class: 'cosme-password__newsletter-submit'
            %}
          {% endform %}
        </section>
      {% endif %}
    </div>
  </div>

  {% if show_image %}
    <div class="cosme-password__media">
      {% render 'cosme-image',
        image: section.settings.image,
        alt: image_alt,
        class: 'cosme-password__image',
        width: 1600,
        loading: 'eager',
        fetchpriority: 'high',
        aspect_ratio: image_aspect_ratio,
        sizes: '(min-width: 990px) 50vw, 100vw'
      %}
    </div>
  {% endif %}
</main>

{% stylesheet %}
  .cosme-skip-link {
    position: absolute;
    z-index: 100;
    inset-block-start: var(--spacing-sm);
    inset-inline-start: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--color-background);
    color: var(--color-foreground);
    text-decoration: none;
    transform: translateY(-200%);
  }

  .cosme-skip-link:focus,
  .cosme-skip-link:focus-visible {
    transform: translateY(0);
  }

  .shopify-section:has(.cosme-password) {
    flex: 1 1 auto;
    min-height: 100svh;
    min-width: 0;
  }

  .cosme-password {
    overflow-x: clip;
    min-width: 0;
    min-height: 100svh;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .cosme-password__panel,
  .cosme-password__intro,
  .cosme-password__forms,
  .cosme-password__media {
    min-width: 0;
  }

  .cosme-password--solo {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .cosme-password--solo .cosme-password__panel {
    width: 100%;
    max-width: 34rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 8vw, 5rem) var(--page-margin);
  }

  .cosme-password--solo .cosme-password__intro {
    text-align: center;
  }

  .cosme-password--solo .cosme-password__brand {
    justify-content: center;
  }

  .cosme-password--solo .cosme-password__description {
    margin-inline: auto;
  }

  .cosme-password--has-image {
    display: flex;
    flex-direction: column;
  }

  .cosme-password--has-image .cosme-password__panel {
    display: contents;
  }

  .cosme-password--has-image .cosme-password__intro {
    order: 1;
    padding: clamp(2rem, 6vw, 3.5rem) var(--page-margin) var(--spacing-lg);
  }

  .cosme-password--has-image .cosme-password__media {
    order: 2;
  }

  .cosme-password--has-image .cosme-password__forms {
    order: 3;
    padding: var(--spacing-xl) var(--page-margin) clamp(2.5rem, 7vw, 4rem);
  }

  .cosme-password__brand {
    display: flex;
    align-items: center;
    margin-block-end: var(--spacing-xl);
    color: var(--color-heading, var(--color-foreground));
  }

  .cosme-password__logo-media .cosme-image__img,
  .cosme-password__logo-media.cosme-image__img {
    width: var(--cosme-password-logo-width, 7.5rem);
    max-width: 100%;
    height: auto;
  }

  .cosme-password__logo-text {
    font-family: var(--font-heading--family);
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: var(--font-heading--weight);
    line-height: var(--line-height-heading);
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }

  .cosme-password__eyebrow {
    margin: 0 0 var(--spacing-sm);
    font-size: 0.6875rem;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-password__title {
    margin: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-heading, var(--color-foreground));
  }

  .cosme-password__description {
    max-width: 32rem;
    margin: var(--spacing-md) 0 0;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .cosme-password__form {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-md);
    width: 100%;
    max-width: 26rem;
  }

  .cosme-password--solo .cosme-password__form,
  .cosme-password--solo .cosme-password__newsletter {
    margin-inline: auto;
  }

  .cosme-password__submit {
    width: 100%;
  }

  .cosme-password__media {
    overflow: hidden;
    background-color: var(--color-background-2, var(--color-background));
  }

  .cosme-password__image,
  .cosme-password__media .cosme-image {
    width: 100%;
    height: 100%;
  }

  .cosme-password__media .cosme-image__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cosme-password__newsletter {
    width: 100%;
    max-width: 26rem;
    margin-block-start: var(--spacing-2xl);
    padding-block-start: var(--spacing-xl);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .cosme-password__newsletter-eyebrow {
    margin: 0 0 var(--spacing-sm);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-password__newsletter-heading {
    margin: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: var(--font-heading--weight);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-heading, var(--color-foreground));
  }

  .cosme-password__newsletter-description {
    margin: var(--spacing-sm) 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .cosme-password__newsletter-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    margin-block-start: var(--spacing-lg);
  }

  .cosme-password__newsletter-status {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-foreground);
  }

  .cosme-password__newsletter-submit {
    width: 100%;
  }

  @media screen and (min-width: 768px) {
    .cosme-password__title {
      font-size: clamp(2.5rem, 5vw, 3.75rem);
    }

    .cosme-password__newsletter-form {
      flex-direction: row;
      align-items: flex-end;
    }

    .cosme-password__newsletter-field {
      flex: 1 1 auto;
      min-width: 0;
    }

    .cosme-password__newsletter-submit {
      width: auto;
      flex: 0 0 auto;
    }
  }

  @media screen and (min-width: 990px) {
    .cosme-password--has-image {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }

    .cosme-password--has-image .cosme-password__panel {
      display: flex;
      flex-direction: column;
      justify-content: center;
      grid-column: 1;
      min-height: 100svh;
      padding: clamp(3rem, 6vw, 5.5rem) clamp(2rem, 6vw, 5rem);
    }

    .cosme-password--has-image .cosme-password__intro,
    .cosme-password--has-image .cosme-password__forms {
      order: unset;
      padding: 0;
    }

    .cosme-password--has-image .cosme-password__forms {
      margin-block-start: var(--spacing-xl);
    }

    .cosme-password--has-image .cosme-password__media {
      order: unset;
      grid-column: 2;
      min-height: 100svh;
    }

    .cosme-password--has-image .cosme-password__media .cosme-image {
      min-height: 100svh;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.password.settings.eyebrow",
      "default": "COMING SOON"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.password.settings.heading",
      "default": "Something beautiful is coming."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.password.settings.description",
      "default": "Cosme is preparing a new collection of beauty essentials, thoughtfully curated for your everyday ritual."
    },
    {
      "type": "text",
      "id": "password_label",
      "label": "t:sections.password.settings.password_label",
      "default": "Enter store password"
    },
    {
      "type": "text",
      "id": "password_button_label",
      "label": "t:sections.password.settings.password_button_label",
      "default": "Enter"
    },
    {
      "type": "header",
      "content": "t:sections.password.settings.image_header"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.password.settings.show_image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.password.settings.image_ratio",
      "options": [
        { "value": "portrait", "label": "t:sections.blog.settings.ratio_portrait" },
        { "value": "square", "label": "t:sections.blog.settings.ratio_square" },
        { "value": "landscape", "label": "t:sections.blog.settings.ratio_landscape" },
        { "value": "wide", "label": "t:sections.blog.settings.ratio_wide" }
      ],
      "default": "portrait",
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "header",
      "content": "t:sections.article.settings.newsletter_header"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.article.settings.show_newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_eyebrow",
      "label": "t:sections.article.settings.newsletter_eyebrow",
      "default": "THE COSME JOURNAL",
      "visible_if": "{{ section.settings.show_newsletter }}"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:sections.article.settings.newsletter_heading",
      "default": "Be the first to know.",
      "visible_if": "{{ section.settings.show_newsletter }}"
    },
    {
      "type": "textarea",
      "id": "newsletter_description",
      "label": "t:sections.article.settings.newsletter_description",
      "default": "Receive launch news, beauty stories and new discoveries from Cosme.",
      "visible_if": "{{ section.settings.show_newsletter }}"
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "t:sections.article.settings.newsletter_button_label",
      "default": "Subscribe",
      "visible_if": "{{ section.settings.show_newsletter }}"
    },
    {
      "type": "color_scheme",
      "id": "newsletter_color_scheme",
      "label": "t:sections.article.settings.newsletter_color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.show_newsletter }}"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
