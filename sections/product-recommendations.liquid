{% liquid
  assign products_limit = section.settings.products_to_show | default: 8
  assign desktop_columns = section.settings.desktop_columns | default: 4
  assign mobile_columns = 2
  assign product_source = section.settings.product_source | default: 'related'
  assign intent = product_source
  if product_source == 'recommended'
    assign intent = 'related'
  endif

  assign recommendations_ready = false
  if recommendations.performed?
    assign recommendations_ready = true
  endif

  assign has_products = false
  if recommendations_ready
    if recommendations.products_count > 0
      assign has_products = true
    endif
  endif

  assign heading = section.settings.heading | strip
  if heading == blank
    if intent == 'complementary'
      assign heading = 'sections.product_recommendations.heading_complementary' | t
    else
      assign heading = 'sections.product_recommendations.heading_related' | t
    endif
  endif

  assign subheading = section.settings.subheading | strip
  assign hide_on_storefront = false
  if recommendations_ready
    unless has_products
      unless request.design_mode
        assign hide_on_storefront = true
      endunless
    endunless
  endif

  assign desktop_vw = 100 | divided_by: desktop_columns
  assign card_sizes = '(min-width: 990px) ' | append: desktop_vw | append: 'vw, (min-width: 768px) 33vw, 50vw'
  assign recommendations_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: products_limit | append: '&intent=' | append: intent
%}

<section
  id="ProductRecommendations-{{ section.id }}"
  class="cosme-related-products full-width color-{{ section.settings.color_scheme }}{% if settings.enable_animations %} cosme-related-products--animated{% endif %}"
  style="--related-products-columns-desktop: {{ desktop_columns }}; --related-products-columns-mobile: {{ mobile_columns }};"
  data-product-recommendations
  data-section-id="{{ section.id }}"
  data-url="{{ recommendations_url }}"
  data-performed="{{ recommendations_ready }}"
  data-show-navigation="{{ section.settings.show_navigation }}"
  data-page-label="{{ 'sections.product_recommendations.page_status' | t }}"
  aria-label="{{ 'sections.product_recommendations.landmark_label' | t }}"
  {% if hide_on_storefront %}
    hidden
  {% endif %}
  {{ section.shopify_attributes }}
>
  <div class="cosme-related-products__inner">
    {% if has_products %}
      <header class="cosme-related-products__header">
        <div class="cosme-related-products__titles">
          {% if heading != blank %}
            <h2 class="cosme-related-products__heading">{{ heading | escape }}</h2>
          {% endif %}

          {% if subheading != blank %}
            <p class="cosme-related-products__subheading">{{ subheading | escape }}</p>
          {% endif %}
        </div>

        {% if section.settings.show_navigation %}
          <nav
            class="cosme-related-products__navigation"
            aria-label="{{ 'sections.product_recommendations.navigation' | t }}"
            data-related-products-nav
            hidden
          >
            <button
              type="button"
              class="cosme-related-products__nav-button"
              data-related-products-prev
              aria-label="{{ 'sections.product_recommendations.previous' | t }}"
              disabled
            >
              {{ 'sections.product_recommendations.previous' | t }}
            </button>
            <span class="cosme-related-products__nav-divider" aria-hidden="true">|</span>
            <button
              type="button"
              class="cosme-related-products__nav-button"
              data-related-products-next
              aria-label="{{ 'sections.product_recommendations.next' | t }}"
              disabled
            >
              {{ 'sections.product_recommendations.next' | t }}
            </button>
          </nav>
        {% endif %}
      </header>

      <div class="cosme-related-products__grid" data-related-products-grid>
        {% for recommendation in recommendations.products limit: products_limit %}
          {% liquid
            if forloop.index <= desktop_columns
              assign card_loading = 'eager'
            else
              assign card_loading = 'lazy'
            endif

            if forloop.first
              assign card_fetchpriority = 'high'
            else
              assign card_fetchpriority = blank
            endif
          %}

          {% render 'cosme-product-card',
            product: recommendation,
            layout: 'editorial',
            aspect_ratio: '1/1',
            image_width: 900,
            sizes: card_sizes,
            loading: card_loading,
            fetchpriority: card_fetchpriority,
            show_vendor: section.settings.show_vendor,
            show_price: true,
            show_badge: section.settings.show_badges,
            show_secondary_image: true,
            show_quick_view: true,
            show_add_to_cart: true
          %}
        {% endfor %}
      </div>

      <p class="cosme-visually-hidden" aria-live="polite" data-related-products-live></p>
    {% elsif recommendations_ready %}
      {% if request.design_mode %}
        <p class="cosme-related-products__empty">{{ 'sections.product_recommendations.empty' | t }}</p>
      {% endif %}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cosme-related-products {
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .cosme-related-products[hidden] {
    display: none;
  }

  .cosme-related-products__inner {
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--spacing-section) var(--page-margin);
  }

  .cosme-related-products__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-lg);
    margin-block-end: var(--spacing-2xl);
  }

  .cosme-related-products__titles {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    min-width: 0;
  }

  .cosme-related-products__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 4vw, 2.5rem);
    font-weight: var(--font-heading--weight);
    line-height: 1.05;
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-heading);
  }

  .cosme-related-products__subheading {
    margin: 0;
    max-width: 36rem;
    font-size: 0.9375rem;
    line-height: var(--line-height-body);
    color: var(--color-muted);
  }

  .cosme-related-products__empty {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .cosme-related-products__navigation {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex-shrink: 0;
  }

  .cosme-related-products__nav-button {
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 0.8125rem;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    cursor: pointer;
    transition: color var(--transition-duration) var(--transition-easing);
  }

  .cosme-related-products__nav-button:hover:not(:disabled),
  .cosme-related-products__nav-button:focus-visible:not(:disabled) {
    color: var(--color-foreground);
  }

  .cosme-related-products__nav-button:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-accent);
    outline-offset: 2px;
  }

  .cosme-related-products__nav-button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .cosme-related-products__nav-divider {
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1;
    opacity: 0.6;
  }

  .cosme-related-products__grid {
    display: grid;
    grid-template-columns: repeat(var(--related-products-columns-mobile), minmax(0, 1fr));
    gap: var(--spacing-xl) var(--grid-gap);
    touch-action: pan-y;
  }

  .cosme-related-products__grid > * {
    min-width: 0;
  }

  .cosme-related-products .cosme-product-card__title,
  .cosme-related-products .cosme-product-card__vendor,
  .cosme-related-products .cosme-product-card__price {
    overflow-wrap: anywhere;
  }

  .cosme-related-products .cosme-product-card__meta-row {
    gap: var(--spacing-sm);
  }

  .cosme-related-products--enhanced.cosme-related-products--paginated .cosme-related-products__grid > [hidden] {
    display: none;
  }

  @media (min-width: 768px) {
    .cosme-related-products__grid {
      grid-template-columns: repeat(min(var(--related-products-columns-desktop), 3), minmax(0, 1fr));
      gap: var(--spacing-2xl) var(--grid-gap);
    }
  }

  @media (min-width: 990px) {
    .cosme-related-products__grid {
      grid-template-columns: repeat(var(--related-products-columns-desktop), minmax(0, 1fr));
    }

    .cosme-related-products__header {
      margin-block-end: calc(var(--spacing-2xl) + var(--spacing-md));
    }
  }

  @media (max-width: 767px) {
    .cosme-related-products__header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-md);
      margin-block-end: var(--spacing-xl);
    }

    .cosme-related-products__navigation {
      align-self: flex-end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cosme-related-products__nav-button {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    if (window._cosmeRelatedProducts) return;
    window._cosmeRelatedProducts = true;

    const initialized = new WeakSet();

    const initPagination = (root) => {
      if (!root || initialized.has(root)) return;

      const grid = root.querySelector('[data-related-products-grid]');
      const nav = root.querySelector('[data-related-products-nav]');
      const prevButton = root.querySelector('[data-related-products-prev]');
      const nextButton = root.querySelector('[data-related-products-next]');
      const liveRegion = root.querySelector('[data-related-products-live]');
      const items = grid ? Array.from(grid.children) : [];

      if (!grid || items.length === 0) return;

      initialized.add(root);

      let currentPage = 0;
      let pointerStartX = 0;
      const showNavigation = root.dataset.showNavigation === 'true';
      const pageLabelTemplate = root.dataset.pageLabel || 'Page {current} of {total}';

      const getDesktopColumns = () => {
        const value = getComputedStyle(root).getPropertyValue('--related-products-columns-desktop').trim();
        const parsed = parseInt(value, 10);
        return Number.isNaN(parsed) ? 4 : parsed;
      };

      const getColumnsPerView = () => {
        if (window.matchMedia('(min-width: 990px)').matches) {
          return getDesktopColumns();
        }

        if (window.matchMedia('(min-width: 768px)').matches) {
          return Math.min(getDesktopColumns(), 3);
        }

        return 0;
      };

      const getItemsPerPage = () => {
        const columns = getColumnsPerView();
        return columns > 0 ? columns : items.length;
      };

      const getTotalPages = () => {
        const perPage = getItemsPerPage();
        if (perPage <= 0 || items.length <= perPage) return 1;
        return Math.ceil(items.length / perPage);
      };

      const shouldPaginate = () => {
        const columns = getColumnsPerView();
        return showNavigation && columns > 0 && items.length > columns;
      };

      const formatPageLabel = (current, total) =>
        pageLabelTemplate.replace('{current}', current).replace('{total}', total);

      const announcePage = (current, total) => {
        if (!liveRegion) return;
        liveRegion.textContent = formatPageLabel(current, total);
      };

      const updateUI = () => {
        const paginate = shouldPaginate();
        const perPage = getItemsPerPage();
        const totalPages = getTotalPages();

        if (nav) {
          nav.hidden = !paginate;
        }

        if (!paginate) {
          items.forEach((item) => {
            item.hidden = false;
            item.removeAttribute('aria-hidden');
          });
          root.classList.remove('cosme-related-products--paginated');
          return;
        }

        root.classList.add('cosme-related-products--paginated');

        if (currentPage > totalPages - 1) currentPage = totalPages - 1;
        if (currentPage < 0) currentPage = 0;

        const start = currentPage * perPage;
        const end = start + perPage;

        items.forEach((item, index) => {
          const isVisible = index >= start && index < end;
          item.hidden = !isVisible;
          item.setAttribute('aria-hidden', isVisible ? 'false' : 'true');
        });

        if (prevButton) prevButton.disabled = currentPage === 0;
        if (nextButton) nextButton.disabled = currentPage >= totalPages - 1;
        announcePage(currentPage + 1, totalPages);
      };

      const goToPage = (pageIndex) => {
        const totalPages = getTotalPages();
        const nextPage = Math.max(0, Math.min(pageIndex, totalPages - 1));
        if (nextPage === currentPage) return;
        currentPage = nextPage;
        updateUI();
      };

      if (prevButton) prevButton.addEventListener('click', () => goToPage(currentPage - 1));
      if (nextButton) nextButton.addEventListener('click', () => goToPage(currentPage + 1));

      const onPointerDown = (event) => {
        if (!shouldPaginate()) return;
        if (event.pointerType === 'mouse') return;
        pointerStartX = event.clientX;
      };

      const onPointerUp = (event) => {
        if (!shouldPaginate()) return;
        if (event.pointerType === 'mouse') return;
        const delta = event.clientX - pointerStartX;
        if (Math.abs(delta) < 48) return;
        if (delta < 0) goToPage(currentPage + 1);
        else goToPage(currentPage - 1);
      };

      grid.addEventListener('pointerdown', onPointerDown);
      grid.addEventListener('pointerup', onPointerUp);

      const onResize = () => {
        currentPage = 0;
        updateUI();
      };

      window.addEventListener('resize', onResize);
      root.classList.add('cosme-related-products--enhanced');
      updateUI();

      root._relatedProductsCleanup = () => {
        window.removeEventListener('resize', onResize);
        grid.removeEventListener('pointerdown', onPointerDown);
        grid.removeEventListener('pointerup', onPointerUp);
      };
    };

    const loadRecommendations = (root) => {
      if (!root || root.dataset.performed === 'true') {
        initPagination(root);
        return;
      }

      const url = root.dataset.url;
      if (!url) return;

      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries[0] || !entries[0].isIntersecting) return;
          observer.unobserve(root);

          fetch(url)
            .then((response) => response.text())
            .then((text) => {
              const doc = new DOMParser().parseFromString(text, 'text/html');
              const incoming = doc.querySelector('[data-product-recommendations]');
              if (!incoming) {
                root.hidden = true;
                return;
              }

              const incomingInner = incoming.querySelector('.cosme-related-products__inner');
              const currentInner = root.querySelector('.cosme-related-products__inner');
              if (!incomingInner || !currentInner) {
                root.hidden = true;
                return;
              }

              currentInner.replaceWith(incomingInner);
              root.dataset.performed = 'true';
              root.hidden = incoming.hasAttribute('hidden');

              if (!root.hidden) initPagination(root);
            })
            .catch(() => {
              root.hidden = true;
            });
        },
        { rootMargin: '0px 0px 200px 0px' }
      );

      observer.observe(root);
      root._relatedProductsObserver = observer;
    };

    const initAll = (container = document) => {
      container.querySelectorAll('[data-product-recommendations]').forEach(loadRecommendations);
    };

    initAll();

    document.addEventListener('shopify:section:load', (event) => {
      initAll(event.target);
    });

    document.addEventListener('shopify:section:unload', (event) => {
      event.target.querySelectorAll('[data-product-recommendations]').forEach((root) => {
        if (typeof root._relatedProductsCleanup === 'function') root._relatedProductsCleanup();
        if (root._relatedProductsObserver) root._relatedProductsObserver.disconnect();
        initialized.delete(root);
      });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product_recommendations",
  "tag": "section",
  "class": "section-product-recommendations",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "You may also like"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.product_recommendations.settings.subheading"
    },
    {
      "type": "select",
      "id": "product_source",
      "label": "t:sections.product_recommendations.settings.product_source",
      "info": "t:sections.product_recommendations.settings.product_source_info",
      "options": [
        {
          "value": "related",
          "label": "t:sections.product_recommendations.settings.source_related"
        },
        {
          "value": "complementary",
          "label": "t:sections.product_recommendations.settings.source_complementary"
        },
        {
          "value": "recommended",
          "label": "t:sections.product_recommendations.settings.source_recommended"
        }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.product_recommendations.settings.products_to_show",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "t:sections.product_recommendations.settings.columns",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.product_recommendations.settings.show_vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "t:sections.product_recommendations.settings.show_badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "t:sections.product_recommendations.settings.show_navigation",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:general.product_recommendations"
    }
  ]
}
{% endschema %}
