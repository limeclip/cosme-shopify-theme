    }

    .cosme-header--layout-centered_logo .cosme-header__action--account-bar .cosme-header__account-label {
      display: inline;
    }

    .cosme-header--layout-centered_logo .cosme-header__action--account-bar .cosme-header__account-icon {
      display: none;
    }
  }

  @media (max-width: 989px) {
    .cosme-header__inner {
      grid-template-columns: 1fr auto 1fr;
      grid-template-areas: 'leading logo actions';
    }

    .cosme-header__drawer-panel--mega_menu,
    .cosme-header__drawer-panel--mega_menu_image,
    .cosme-header__drawer-panel--simple {
      width: 100vw;
      max-width: 100vw;
    }

    .cosme-header__mega-triggers {
      display: none;
    }

    .cosme-header__mega-panel,
    .cosme-header__mega-panel--hidden {
      display: block;
    }

    .cosme-header__leading {
      grid-area: leading;
      justify-self: start;
    }

    .cosme-header__logo {
      grid-area: logo;
      justify-self: center;
    }

    .cosme-header__nav {
      display: none;
    }

    .cosme-header__actions {
      grid-area: actions;
      justify-self: end;
    }

    .cosme-header__action--search-leading,
    .cosme-header__action--search-actions,
    .cosme-header__action--account-bar {
      display: none;
    }

    .cosme-header--layout-standard .cosme-header__leading {
      display: inline-flex;
    }

    .cosme-header--layout-standard .cosme-header__logo {
      justify-self: center;
    }

    .cosme-header__search-panel {
      width: 100vw;
      max-width: 100vw;
      height: 100dvh;
      max-height: 100dvh;
      margin: 0;
      border: 0;
    }

    .cosme-header__cart-panel {
      width: 100vw;
      max-width: 100vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cosme-header--animated .cosme-header__submenu,
    .cosme-header--animated .cosme-header__drawer,
    .cosme-header--animated .cosme-header__drawer::backdrop,
    .cosme-header--animated .cosme-header__drawer-panel,
    .cosme-header--animated .cosme-header__drawer-details[open] > .cosme-header__drawer-summary .cosme-icon,
    .cosme-header--animated .cosme-header__mega-accordion[open] > .cosme-header__mega-accordion-summary .cosme-icon,
    .cosme-header--animated .cosme-header__menu-toggle,
    .cosme-header--animated .cosme-header__action,
    .cosme-header--animated shopify-account.cosme-header__action,
    .cosme-header--animated .cosme-header__drawer-close,
    .cosme-header--animated .cosme-header__drawer-utility,
    .cosme-header--animated shopify-account.cosme-header__drawer-utility,
    .cosme-header--animated .cosme-header__drawer-link,
    .cosme-header--animated .cosme-header__mega-trigger,
    .cosme-header--animated .cosme-header__mega-link,
    .cosme-header--animated .cosme-header__mega-column-title,
    .cosme-header--animated .cosme-header__mega-view-all,
    .cosme-header--animated .cosme-header__mega-editorial-link,
    .cosme-header--animated .cosme-header__search-dialog,
    .cosme-header--animated .cosme-header__search-dialog::backdrop,
    .cosme-header--animated .cosme-header__search-panel,
    .cosme-header--animated .cosme-header__cart-dialog,
    .cosme-header--animated .cosme-header__cart-dialog::backdrop,
    .cosme-header--animated .cosme-header__cart-panel,
    .cosme-header-group--animated.cosme-header-group--hide-on-scroll,
    .cosme-header--animated.cosme-header--appearance-transparent,
    .cosme-header--animated.cosme-header--appearance-blur {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  const COSME_SCROLL_THRESHOLD = 20;

  const setHeaderColorScheme = (header, schemeId) => {
    if (!schemeId) return;

    [...header.classList]
      .filter((className) => className.startsWith('color-'))
      .forEach((className) => header.classList.remove(className));

    header.classList.add(`color-${schemeId}`);
  };

  const initCosmeHeaderScroll = (header) => {
    const headerGroup = header.closest('[data-header-group]');
    const appearance = header.dataset.appearance || 'solid';
    const schemes = {
      default: header.dataset.schemeDefault,
      transparent: header.dataset.schemeTransparent || header.dataset.schemeDefault,
      scrolled: header.dataset.schemeScrolled || header.dataset.schemeDefault,
    };

    const isTransparentAppearance = appearance === 'transparent' || appearance === 'blur';
    const hideOnScroll = headerGroup?.classList.contains('cosme-header-group--hide-on-scroll');
    let lastScrollY = window.scrollY;
    let ticking = false;

    const updateHeaderStickyOffset = () => {
      const stickyGroup = document.querySelector(
        '.shopify-section-group-header-group:has([data-header-group][data-sticky="true"])'
      );
      let offset = 0;

      if (stickyGroup) {
        const group = stickyGroup.querySelector('[data-header-group]');
        const hidden = group?.classList.contains('cosme-header-group--scroll-hidden');
        if (!hidden) {
          offset = Math.round(stickyGroup.getBoundingClientRect().height);
        }
      }

      document.documentElement.style.setProperty('--header-sticky-offset', `${offset}px`);
    };

    const updateHeaderOnScroll = () => {
      const scrollY = window.scrollY;
      const isScrolled = scrollY > COSME_SCROLL_THRESHOLD;

      header.classList.toggle('cosme-header--scrolled', isScrolled);

      if (headerGroup) {
        headerGroup.classList.toggle('cosme-header-group--scrolled', isScrolled);
      }

      if (isScrolled) {
        setHeaderColorScheme(header, schemes.scrolled);
      } else if (isTransparentAppearance) {
        setHeaderColorScheme(header, schemes.transparent);
      } else {
        setHeaderColorScheme(header, schemes.default);
      }

      if (hideOnScroll && headerGroup) {
        const headerHeight = header.offsetHeight || headerGroup.offsetHeight;
        const scrollingDown = scrollY > lastScrollY && scrollY > headerHeight;

        headerGroup.classList.toggle('cosme-header-group--scroll-hidden', scrollingDown);
      }

      updateHeaderStickyOffset();
      lastScrollY = scrollY;
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateHeaderOnScroll);
        ticking = true;
      }
    };

    updateHeaderOnScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', updateHeaderStickyOffset, { passive: true });
  };

  const initCosmeMegaMenu = (header) => {
    const megaMenu = header.querySelector('[data-mega-menu]');

    if (!megaMenu) return;

    const triggers = Array.from(megaMenu.querySelectorAll('[data-mega-trigger]'));
    const panels = Array.from(megaMenu.querySelectorAll('[data-mega-panel]'));

    if (triggers.length === 0 || panels.length === 0) return;

    const activatePanel = (index) => {
      triggers.forEach((trigger, triggerIndex) => {
        const isSelected = triggerIndex + 1 === index;

        trigger.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        trigger.tabIndex = isSelected ? 0 : -1;
      });

      panels.forEach((panel) => {
        const panelIndex = Number(panel.dataset.megaIndex);
        const isActive = panelIndex === index;

        panel.classList.toggle('cosme-header__mega-panel--hidden', !isActive);
        panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');

        const accordion = panel.querySelector('[data-mega-accordion]');
        if (accordion) {
          accordion.toggleAttribute('open', isActive);
        }
      });
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        activatePanel(Number(trigger.dataset.megaIndex));
      });

      trigger.addEventListener('keydown', (event) => {
        const currentIndex = triggers.indexOf(trigger);
        let nextIndex = currentIndex;

        if (event.key === 'ArrowDown') {
          event.preventDefault();
          nextIndex = (currentIndex + 1) % triggers.length;
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          nextIndex = (currentIndex - 1 + triggers.length) % triggers.length;
        } else if (event.key === 'Home') {
          event.preventDefault();
          nextIndex = 0;
        } else if (event.key === 'End') {
          event.preventDefault();
          nextIndex = triggers.length - 1;
        } else {
          return;
        }

        triggers[nextIndex].focus();
        activatePanel(Number(triggers[nextIndex].dataset.megaIndex));
      });
    });

    const activeTrigger = triggers.find((trigger) => trigger.getAttribute('aria-selected') === 'true');

    if (activeTrigger) {
      activatePanel(Number(activeTrigger.dataset.megaIndex));
    } else {
      activatePanel(Number(triggers[0].dataset.megaIndex));
    }
  };

  const initCosmeHeader = (header) => {
    const menuToggle = header.querySelector('[data-header-menu-toggle]');
    const menuCloseButtons = header.querySelectorAll('[data-header-menu-close]');
    const drawer = header.querySelector('[data-header-drawer]');
    const menuIcon = header.querySelector('[data-header-menu-icon]');
    const closeIcon = header.querySelector('[data-header-menu-close-icon]');

    if (menuToggle && drawer) {
      let lastFocusedElement = null;

      const setMenuIcons = (isOpen) => {
        if (!menuIcon || !closeIcon) return;

        menuIcon.hidden = isOpen;
        closeIcon.hidden = !isOpen;
      };

      const openMenu = () => {
        if (drawer.open) return;

        lastFocusedElement = document.activeElement;
        drawer.showModal();
        menuToggle.setAttribute('aria-expanded', 'true');
        setMenuIcons(true);

        const firstFocusable = drawer.querySelector(
          'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
        );

        if (firstFocusable) {
          firstFocusable.focus();
        }
      };

      const closeMenu = () => {
        if (!drawer.open) return;

        drawer.close();
        menuToggle.setAttribute('aria-expanded', 'false');
        setMenuIcons(false);

        if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
          lastFocusedElement.focus();
        } else {
          menuToggle.focus();
        }
      };

      menuToggle.addEventListener('click', () => {
        if (drawer.open) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      menuCloseButtons.forEach((button) => {
        button.addEventListener('click', closeMenu);
      });

      drawer.addEventListener('close', () => {
        menuToggle.setAttribute('aria-expanded', 'false');
        setMenuIcons(false);
      });

      drawer.addEventListener('click', (event) => {
        if (event.target === drawer) {
          closeMenu();
        }
      });

      drawer.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeMenu();
      });

      drawer?.querySelectorAll('a[href]').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });
    }

    initCosmeMegaMenu(header);
    initCosmeHeaderScroll(header);
    initCosmeHeaderSearch(header);
    initCosmeHeaderCart(header);
  };

  const initCosmeHeaderSearch = (header) => {
    const searchDialog = header.querySelector('[data-header-search-dialog]');
    const searchToggles = header.querySelectorAll('[data-header-search-toggle]');
    const searchCloseButtons = header.querySelectorAll('[data-header-search-close]');
    const searchForm = header.querySelector('[data-header-search-form]');
    const searchInput = searchForm?.querySelector('input[type="search"], input[name="q"]');
    const searchResults = header.querySelector('[data-header-search-results]');
    const searchStatus = header.querySelector('[data-header-search-status]');
    const usePredictive = header.dataset.predictiveSearch === 'true';

    if (!searchDialog || searchToggles.length === 0) return;

    let lastFocusedElement = null;
    let predictiveTimeout = null;

    const openSearch = () => {
      if (searchDialog.open) return;

      lastFocusedElement = document.activeElement;
      searchDialog.showModal();

      searchToggles.forEach((toggle) => {
        toggle.setAttribute('aria-expanded', 'true');
      });

      if (searchInput) {
        searchInput.focus();
      }
    };

    const closeSearch = () => {
      if (!searchDialog.open) return;

      searchDialog.close();

      searchToggles.forEach((toggle) => {
        toggle.setAttribute('aria-expanded', 'false');
      });

      if (searchResults) {
        searchResults.hidden = true;
        searchResults.innerHTML = '';
      }

      if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
        lastFocusedElement.focus();
      } else if (searchToggles[0]) {
        searchToggles[0].focus();
      }
    };

    const renderPredictiveResults = (products) => {
      if (!searchResults) return;

      if (!products.length) {
        searchResults.innerHTML = `<p class="cosme-header__search-empty">${searchResults.dataset.emptyText || ''}</p>`;
        searchResults.hidden = false;
        return;
      }

      searchResults.innerHTML = products
        .map((product) => {
          const imageMarkup = product.featured_image?.url
            ? `<span class="cosme-header__search-result-media"><img src="${product.featured_image.url}" alt="" width="48" height="48" loading="lazy"></span>`
            : '';

          return `<a class="cosme-header__search-result" role="option" href="${product.url}">${imageMarkup}<span class="cosme-header__search-result-title">${product.title}</span></a>`;
        })
        .join('');

      searchResults.hidden = false;

      searchResults.querySelectorAll('a[href]').forEach((link) => {
        link.addEventListener('click', closeSearch);
      });
    };

    const fetchPredictiveResults = async (query) => {
      if (!usePredictive || !searchResults) return;

      if (!query.trim()) {
        searchResults.hidden = true;
        searchResults.innerHTML = '';
        return;
      }

      try {
        const response = await fetch(
          `/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=6`,
          { headers: { Accept: 'application/json' } }
        );
        const data = await response.json();
        const products = data?.resources?.results?.products || [];

        renderPredictiveResults(products);

        if (searchStatus) {
          searchStatus.textContent = products.length
            ? `${products.length} results`
            : searchResults.dataset.emptyText || '';
        }
      } catch (error) {
        if (searchResults) {
          searchResults.hidden = true;
        }
      }
    };

    searchToggles.forEach((toggle) => {
      toggle.addEventListener('click', openSearch);
    });

    searchCloseButtons.forEach((button) => {
      button.addEventListener('click', closeSearch);
    });

    searchDialog.addEventListener('close', () => {
      searchToggles.forEach((toggle) => {
        toggle.setAttribute('aria-expanded', 'false');
      });
    });

    searchDialog.addEventListener('click', (event) => {
      if (event.target === searchDialog) {
        closeSearch();
      }
    });

    searchDialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeSearch();
    });

    if (searchInput && usePredictive) {
      if (searchResults) {
        searchResults.dataset.emptyText = searchResults.dataset.emptyText || 'No results found';
      }

      searchInput.addEventListener('input', () => {
        window.clearTimeout(predictiveTimeout);
        predictiveTimeout = window.setTimeout(() => {
          fetchPredictiveResults(searchInput.value);
        }, 250);
      });
    }
  };

  const initCosmeHeaderCart = (header) => {
    if (header.dataset.cartDrawer !== 'true') return;
    if (header.dataset.cartDrawerReady === 'true') return;

    const cartDialog = document.querySelector('[data-header-cart-dialog]');
    const cartToggle = header.querySelector('[data-header-cart-toggle]');
    const cartCloseButtons = cartDialog ? cartDialog.querySelectorAll('[data-header-cart-close]') : [];
    const cartBody = cartDialog ? cartDialog.querySelector('[data-header-cart-body]') : null;
    const cartPanel = cartDialog ? cartDialog.querySelector('.cosme-header__cart-panel') : null;
    const drawerCount = cartDialog ? cartDialog.querySelector('[data-cart-drawer-count]') : null;
    const drawerTitle = cartDialog ? cartDialog.querySelector('.cosme-header__cart-title') : null;
    const statusEl = cartDialog ? cartDialog.querySelector('[data-cart-drawer-status]') : null;
    const errorEl = cartDialog ? cartDialog.querySelector('[data-cart-drawer-error]') : null;

    if (!cartDialog || !cartToggle || !cartBody) return;

    header.dataset.cartDrawerReady = 'true';

    const focusableSelector =
      'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
    const getDrawerFocusable = () =>
      Array.from(cartDialog.querySelectorAll(focusableSelector)).filter((element) => {
        if (element.closest('[hidden]')) return false;
        if (element.closest('[aria-hidden="true"]')) return false;
        return true;
      });
    const interpolateCount = (template, count) => String(template || '').replace(/COUNT/g, String(count));
    const routesRoot = () => {
      const root = window.Shopify && window.Shopify.routes && window.Shopify.routes.root;
      return typeof root === 'string' && root.length ? root : '/';
    };

    let lastFocusedElement = null;
    let requestInFlight = false;
    let noteTimer = null;
    let noteDirty = false;
    let extrasState = {
      noteOpen: false,
      discountOpen: false,
      discountValue: '',
    };

    const strings = {
      error: cartDialog.dataset.errorMessage || '',
      updated: cartDialog.dataset.updatedMessage || '',
      quantityUpdated: cartDialog.dataset.quantityUpdatedMessage || '',
      itemRemoved: cartDialog.dataset.itemRemovedMessage || '',
      itemAdded: cartDialog.dataset.itemAddedMessage || '',
      itemCountOne: cartDialog.dataset.itemCountOne || '',
      itemCountOther: cartDialog.dataset.itemCountOther || '',
      headerCartCount: cartDialog.dataset.headerCartCountLabel || '',
      discountEmpty: cartDialog.dataset.discountEmpty || '',
      discountApplied: cartDialog.dataset.discountApplied || '',
      discountRemoved: cartDialog.dataset.discountRemoved || '',
      discountNotApplied: cartDialog.dataset.discountNotApplied || '',
      noteSaved: cartDialog.dataset.noteSaved || '',
    };

    const announce = (message) => {
      if (!statusEl || !message) return;
      statusEl.textContent = '';
      window.requestAnimationFrame(() => {
        statusEl.textContent = message;
      });
    };

    const showError = (message) => {
      if (!errorEl) return;
      errorEl.hidden = false;
      errorEl.textContent = message || strings.error;
    };

    const clearError = () => {
      if (!errorEl) return;
      errorEl.hidden = true;
      errorEl.textContent = '';
    };

    const customerErrorMessage = (payload) => {
      if (!payload || typeof payload !== 'object') return strings.error;

      const description = payload.description;
      if (typeof description !== 'string') return strings.error;

      const trimmed = description.trim();
      if (!trimmed) return strings.error;
      if (trimmed.length > 180) return strings.error;
      if (/stack|trace|undefined|null|\{|\}/i.test(trimmed)) return strings.error;

      return trimmed;
    };

    const formatItemCount = (count) => {
      const template = count === 1 ? strings.itemCountOne : strings.itemCountOther;
      return interpolateCount(template, count);
    };

    const setDrawerBusy = (busy) => {
      if (cartPanel) {
        cartPanel.setAttribute('aria-busy', busy ? 'true' : 'false');
      }

      cartBody
        .querySelectorAll(
          '[data-cart-quantity-decrease], [data-cart-quantity-increase], [data-cart-quantity-input], [data-cart-remove], .cosme-cart-drawer__checkout, [data-cart-upsell-add], [data-cart-drawer-discount-apply], [data-cart-drawer-discount-remove], [data-cart-drawer-discount-input]'
        )
        .forEach((control) => {
          control.disabled = busy;
        });
    };

    const updateCartCount = (count) => {
      const safeCount = Number(count) || 0;

      header.querySelectorAll('[data-header-cart-count]').forEach((element) => {
        element.textContent = String(safeCount);
        element.hidden = safeCount <= 0;
      });

      if (safeCount > 0 && strings.headerCartCount) {
        cartToggle.setAttribute('aria-label', interpolateCount(strings.headerCartCount, safeCount));
      } else {
        cartToggle.removeAttribute('aria-label');
      }

      if (drawerCount) {
        if (safeCount <= 0) {
          drawerCount.hidden = true;
        } else {
          drawerCount.hidden = false;
          drawerCount.textContent = formatItemCount(safeCount);
        }
      }
    };

    const restoreFocus = (lineKey, focusPref) => {
      if (!cartDialog.open) return;

      let nextFocus = null;

      if (lineKey) {
        const item = cartBody.querySelector('[data-cart-item][data-line-key="' + CSS.escape(lineKey) + '"]');
        if (item && focusPref === 'increase') nextFocus = item.querySelector('[data-cart-quantity-increase]');
        if (item && focusPref === 'decrease') nextFocus = item.querySelector('[data-cart-quantity-decrease]');
        if (item && focusPref === 'input') nextFocus = item.querySelector('[data-cart-quantity-input]');
        if (item && focusPref === 'remove') nextFocus = item.querySelector('[data-cart-remove]');
      }

      if (!nextFocus && focusPref === 'discount') {
        nextFocus = cartBody.querySelector('[data-cart-drawer-discount-input]');
      }

      if (!nextFocus) {
        nextFocus = getDrawerFocusable()[0] || null;
      }

      if (nextFocus && typeof nextFocus.focus === 'function') {
        nextFocus.focus();
      }
    };

    const formatMoney = (cents, format) => {
      if (cents == null || Number.isNaN(Number(cents))) return '';

      const value = Number(cents);
      const formatString = format || cartDialog.dataset.moneyFormat || ('$' + '{' + '{amount}}');
      const placeholderMatch = formatString.match(new RegExp('\\{\\{\\s*(\\w+)\\s*\\}\\}'));

      if (!placeholderMatch) return String(value);

      const formatWithDelimiters = (number, precision, thousands, decimal) => {
        const safePrecision = precision == null ? 2 : precision;
        const thousandSep = thousands == null ? ',' : thousands;
        const decimalSep = decimal == null ? '.' : decimal;
        const normalized = (number / 100).toFixed(safePrecision);
        const parts = normalized.split('.');
        const dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, `$1${thousandSep}`);
        const centsPart = parts[1] ? decimalSep + parts[1] : '';
        return dollars + centsPart;
      };

      let formatted = '';

      switch (placeholderMatch[1]) {
        case 'amount':
          formatted = formatWithDelimiters(value, 2);
          break;
        case 'amount_no_decimals':
          formatted = formatWithDelimiters(value, 0);
          break;
        case 'amount_with_comma_separator':
          formatted = formatWithDelimiters(value, 2, '.', ',');
          break;
        case 'amount_no_decimals_with_comma_separator':
          formatted = formatWithDelimiters(value, 0, '.', ',');
          break;
        default:
          formatted = formatWithDelimiters(value, 2);
      }

      return formatString.replace(new RegExp('\\{\\{\\s*\\w+\\s*\\}\\}'), formatted);
    };

    const applyEmptyCartContent = () => {
      const emptyRoot = cartBody.querySelector('[data-cart-drawer-empty]');
      if (!emptyRoot) return;

      const headingEl = emptyRoot.querySelector('[data-empty-heading]');
      const messageEl = emptyRoot.querySelector('[data-empty-message]');
      const buttonEl = emptyRoot.querySelector('.cosme-cart-drawer__empty-cta');

      if (headingEl && cartDialog.dataset.emptyHeading) {
        headingEl.textContent = cartDialog.dataset.emptyHeading;
      }

      if (messageEl && cartDialog.dataset.emptyMessage) {
        messageEl.textContent = cartDialog.dataset.emptyMessage;
      }

      if (buttonEl) {
        if (cartDialog.dataset.emptyButtonLabel) {
          buttonEl.textContent = cartDialog.dataset.emptyButtonLabel;
        }
        if (cartDialog.dataset.emptyButtonLink) {
          buttonEl.setAttribute('href', cartDialog.dataset.emptyButtonLink);
        }
      }

      mountEmptyRecs();
    };

    const updateFreeShippingBar = (cartTotal, threshold, message, unlockedMessage) => {
      const content = cartBody.querySelector('[data-cart-drawer-content]');
      const itemCount = Number(content && content.dataset.itemCount ? content.dataset.itemCount : 0);
      const shippingEl = cartBody.querySelector('[data-cart-drawer-shipping]');
      const enabled = cartDialog.dataset.freeShippingEnabled === 'true';

      if (!enabled || itemCount <= 0) {
        if (shippingEl) shippingEl.hidden = true;
        return;
      }

      if (!shippingEl) return;

      shippingEl.hidden = false;

      const thresholdUnits = Number(threshold != null ? threshold : cartDialog.dataset.freeShippingThreshold) || 100;
      const thresholdCents = thresholdUnits * 100;
      const total = Number(cartTotal) || 0;
      const remaining = Math.max(0, thresholdCents - total);
      const progress = thresholdCents > 0 ? Math.min(100, Math.max(0, (total / thresholdCents) * 100)) : 0;
      const unlocked = remaining === 0;
      const fill = shippingEl.querySelector('[data-shipping-fill]');
      const bar = shippingEl.querySelector('[data-shipping-bar]');
      const textEl = shippingEl.querySelector('[data-shipping-text]');
      const iconEl = shippingEl.querySelector('[data-shipping-icon]');
      const awayTemplate = message != null ? message : cartDialog.dataset.freeShippingMessage || '';
      const unlockedTemplate = unlockedMessage != null ? unlockedMessage : cartDialog.dataset.freeShippingUnlocked || '';
      const formattedRemaining = formatMoney(remaining, cartDialog.dataset.moneyFormat);
      let nextMessage = unlocked
        ? unlockedTemplate
        : String(awayTemplate).replace(/\[amount\]/g, formattedRemaining);

      if (!unlocked && nextMessage === awayTemplate) {
        nextMessage = String(awayTemplate).replace(/\{\{\s*amount\s*\}\}/g, formattedRemaining);
      }

      const width = unlocked ? 100 : progress;

      shippingEl.classList.toggle('cosme-cart-drawer__shipping--unlocked', unlocked);

      if (fill) {
        fill.style.width = width + '%';
        fill.classList.toggle('is-complete', unlocked);
      }

      if (bar) {
        bar.setAttribute('aria-valuenow', String(Math.round(width)));
        bar.setAttribute('aria-valuetext', nextMessage);
      }

      if (textEl) textEl.textContent = nextMessage;
      if (iconEl) iconEl.hidden = !unlocked;
    };

    const syncFreeShippingFromDom = (cartPayload) => {
      const content = cartBody.querySelector('[data-cart-drawer-content]');
      const total =
        cartPayload && typeof cartPayload.total_price === 'number'
          ? cartPayload.total_price
          : Number(content && content.dataset.cartTotal ? content.dataset.cartTotal : 0);

      if (content && cartPayload) {
        if (typeof cartPayload.item_count === 'number') {
          content.dataset.itemCount = String(cartPayload.item_count);
        }
        if (typeof cartPayload.total_price === 'number') {
          content.dataset.cartTotal = String(cartPayload.total_price);
        }
      }

      updateFreeShippingBar(
        total,
        cartDialog.dataset.freeShippingThreshold,
        cartDialog.dataset.freeShippingMessage,
        cartDialog.dataset.freeShippingUnlocked
      );
      applyEmptyCartContent();
    };

    const getUpsellSourceNode = () =>
      cartDialog.querySelector('[data-cart-drawer-upsell-source] [data-cart-drawer-upsell]');

    const syncUpsellHeading = (node, headingOverride) => {
      if (!node) return;

      const headingText =
        headingOverride != null && headingOverride !== ''
          ? headingOverride
          : cartDialog.dataset.upsellHeading;
      const headingEl = node.querySelector('[data-cart-drawer-upsell-heading]');

      if (headingEl && headingText) {
        headingEl.textContent = headingText;
      }

      node.dataset.showVendor = cartDialog.dataset.upsellShowVendor === 'true' ? 'true' : 'false';
      if (headingText) {
        node.setAttribute('aria-label', headingText);
      }
    };

    let recsRequestToken = 0;

    const revealOrHideUpsell = (node) => {
      if (!node) return;
      const list = node.querySelector('[data-cart-drawer-upsell-list]');
      node.hidden = !(list && list.querySelector('[data-upsell-product-id]'));
    };

    const loadUpsellRecommendations = (live, options) => {
      if (!live) return;

      const opts = options || {};
      const source = opts.source || cartDialog.dataset.upsellSource;
      const heading = opts.heading != null ? opts.heading : cartDialog.dataset.upsellHeading;
      const limit = opts.limit || cartDialog.dataset.upsellLimit || '4';

      if (source !== 'recommendations') {
        revealOrHideUpsell(live);
        return;
      }

      const content = cartBody.querySelector('[data-cart-drawer-content]');
      const productId = content && content.dataset.firstProductId;
      const recsBase = cartDialog.dataset.recommendationsUrl;
      const sectionId = cartDialog.dataset.sectionId;

      if (!productId || !recsBase || !sectionId) {
        revealOrHideUpsell(live);
        return;
      }

      live.hidden = true;
      const token = ++recsRequestToken;
      const joiner = recsBase.indexOf('?') === -1 ? '?' : '&';
      const url =
        recsBase +
        joiner +
        'section_id=' +
        encodeURIComponent(sectionId) +
        '&product_id=' +
        encodeURIComponent(productId) +
        '&limit=' +
        encodeURIComponent(limit) +
        '&intent=related';

      fetch(url)
        .then((response) => {
          if (!response.ok) throw new Error('recs');
          return response.text();
        })
        .then((text) => {
          if (token !== recsRequestToken) return;
          if (!live.isConnected) return;

          const doc = new DOMParser().parseFromString(text, 'text/html');
          const incomingList = doc.querySelector('[data-cart-drawer-upsell-list]');
          const currentList = live.querySelector('[data-cart-drawer-upsell-list]');

          if (incomingList && currentList && incomingList.querySelector('[data-upsell-product-id]')) {
            currentList.innerHTML = incomingList.innerHTML;
            syncUpsellHeading(live, heading);
            live.hidden = false;
            return;
          }

          revealOrHideUpsell(live);
        })
        .catch(() => {
          if (token !== recsRequestToken) return;
          revealOrHideUpsell(live);
        });
    };

    const mountUpsell = () => {
      const content = cartBody.querySelector('[data-cart-drawer-content]');
      const slot = cartBody.querySelector('[data-cart-drawer-upsell-slot]');
      const itemCount = Number(content && content.dataset.itemCount ? content.dataset.itemCount : 0);
      const enabled = cartDialog.dataset.upsellEnabled === 'true';
      const existing = cartBody.querySelector('.cosme-cart-drawer__scroll [data-cart-drawer-upsell]');

      if (!enabled || itemCount <= 0) {
        if (existing) existing.remove();
        return;
      }

      const source = getUpsellSourceNode();
      if (!source) {
        if (existing) existing.remove();
        if (slot) slot.remove();
        return;
      }

      const live = source.cloneNode(true);
      live.hidden = false;
      syncUpsellHeading(live);

      if (slot) {
        slot.replaceWith(live);
      } else if (existing) {
        existing.replaceWith(live);
      } else {
        const extras = cartBody.querySelector('.cosme-cart-drawer__scroll .cosme-cart-drawer__extras');
        const scroll = cartBody.querySelector('.cosme-cart-drawer__scroll');
        if (extras) extras.before(live);
        else if (scroll) scroll.appendChild(live);
      }

      if (cartDialog.dataset.upsellSource === 'recommendations') {
        loadUpsellRecommendations(live);
        return;
      }

      const list = live.querySelector('[data-cart-drawer-upsell-list]');
      if (!list || !list.querySelector('[data-upsell-product-id]')) {
        live.hidden = true;
      }
    };

    const mountEmptyRecs = () => {
      const content = cartBody.querySelector('[data-cart-drawer-content]');
      const emptyRoot = cartBody.querySelector('[data-cart-drawer-empty]');
      const itemCount = Number(content && content.dataset.itemCount ? content.dataset.itemCount : 0);
      const slot = emptyRoot && emptyRoot.querySelector('[data-cart-drawer-empty-recs-slot]');
      const existing = emptyRoot && emptyRoot.querySelector('[data-cart-drawer-upsell]');
      const enabled = cartDialog.dataset.emptyRecsEnabled === 'true';

      if (itemCount > 0 || !emptyRoot || !enabled) {
        if (existing) existing.remove();
        return;
      }

      const source = cartDialog.querySelector(
        '[data-cart-drawer-empty-recs-source] [data-cart-drawer-upsell]'
      );

      if (!source) {
        if (existing) existing.remove();
        if (slot) slot.remove();
        return;
      }

      const live = source.cloneNode(true);
      live.hidden = false;
      syncUpsellHeading(live, cartDialog.dataset.emptyRecsHeading);

      if (slot) {
        slot.replaceWith(live);
      } else if (existing) {
        existing.replaceWith(live);
      } else {
        emptyRoot.appendChild(live);
      }

      loadUpsellRecommendations(live, {
        source: cartDialog.dataset.emptyRecsSource,
        heading: cartDialog.dataset.emptyRecsHeading,
        limit: cartDialog.dataset.emptyRecsLimit,
      });
    };

    const addUpsellToCart = async (form) => {
      if (!form || requestInFlight) return;

      const formData = new FormData(form);
      const variantId = Number(formData.get('id'));
      const quantity = Number(formData.get('quantity')) || 1;

      if (!variantId) return;

      const button = form.querySelector('[data-cart-upsell-add]');
      const originalLabel = button ? button.textContent : '';
      const addingLabel = form.getAttribute('data-adding-label') || originalLabel;

      requestInFlight = true;
      clearError();
      setDrawerBusy(true);

      if (button) {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        if (addingLabel) button.textContent = addingLabel;
      }

      try {
        const response = await fetch(routesRoot() + 'cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            items: [{ id: variantId, quantity: quantity }],
            sections: 'cart-drawer',
            sections_url: window.location.pathname,
          }),
        });

        const payload = await response.json();
        if (!response.ok) throw payload;

        let cartPayload = payload;
        if (typeof payload.item_count !== 'number' || typeof payload.total_price !== 'number') {
          const cartResponse = await fetch(routesRoot() + 'cart.js', {
            headers: { Accept: 'application/json' },
          });
          if (cartResponse.ok) {
            cartPayload = await cartResponse.json();
            if (payload.sections) cartPayload.sections = payload.sections;
          }
        }

        const sectionHtml = payload.sections && payload.sections['cart-drawer'];
        if (sectionHtml) {
          applySectionHtml(sectionHtml, null, null, cartPayload);
        } else {
          await refreshCartDrawer({ cartPayload: cartPayload });
        }

        announce(strings.itemAdded || strings.updated);
      } catch (error) {
        showError(customerErrorMessage(error));
      } finally {
        requestInFlight = false;
        setDrawerBusy(false);
      }
    };

    const captureExtrasState = () => {
      const noteDetails = cartBody.querySelector('[data-cart-drawer-note]');
      const discountDetails = cartBody.querySelector('[data-cart-drawer-discount]');
      const discountInput = cartBody.querySelector('[data-cart-drawer-discount-input]');
      const noteInput = cartBody.querySelector('[data-cart-drawer-note-input]');

      extrasState = {
        noteOpen: Boolean(noteDetails && noteDetails.open),
        discountOpen: Boolean(discountDetails && discountDetails.open),
        discountValue: discountInput ? discountInput.value : extrasState.discountValue || '',
        noteValue: noteInput ? noteInput.value : extrasState.noteValue,
      };
    };

    const currentDiscountCodes = () =>
      Array.from(cartBody.querySelectorAll('[data-cart-drawer-discount-code]'))
        .map((node) => (node.getAttribute('data-cart-drawer-discount-code') || node.textContent || '').trim())
        .filter(Boolean);

    const findDiscountEntry = (payload, code) => {
      const codes = payload && payload.discount_codes;
      if (!Array.isArray(codes) || !code) return null;

      const needle = String(code).trim().toLowerCase();
      return codes.find((entry) => String(entry.code || '').trim().toLowerCase() === needle) || null;
    };

    const setDiscountError = (message, focusInput) => {
      const errorNode = cartBody.querySelector('[data-cart-drawer-discount-error]');
      const input = cartBody.querySelector('[data-cart-drawer-discount-input]');

      if (errorNode) {
        if (message) {
          errorNode.hidden = false;
          errorNode.textContent = message;
        } else {
          errorNode.hidden = true;
          errorNode.textContent = '';
        }
      }

      if (input) {
        if (message) {
          input.setAttribute('aria-invalid', 'true');
        } else {
          input.removeAttribute('aria-invalid');
        }

        if (focusInput && message) input.focus();
      }
    };

    const applyDrawerExtras = () => {
      const noteDetails = cartBody.querySelector('[data-cart-drawer-note]');
      const discountDetails = cartBody.querySelector('[data-cart-drawer-discount]');
      const trust = cartBody.querySelector('[data-cart-drawer-trust]');
      const noteLabel = cartBody.querySelector('[data-cart-drawer-note-label]');
      const noteInput = cartBody.querySelector('[data-cart-drawer-note-input]');
      const noteFieldLabel = noteDetails && noteDetails.querySelector('label[for="CosmeCartDrawerNote"]');
      const discountLabel = cartBody.querySelector('[data-cart-drawer-discount-label]');
      const discountInput = cartBody.querySelector('[data-cart-drawer-discount-input]');
      const discountFieldLabel = discountDetails && discountDetails.querySelector('label[for="CosmeCartDrawerDiscount"]');
      const discountButton = cartBody.querySelector('[data-cart-drawer-discount-apply]');
      const trustMessage = cartBody.querySelector('[data-cart-drawer-trust-message]');

      if (noteDetails) {
        noteDetails.hidden = cartDialog.dataset.showOrderNote !== 'true';
        noteDetails.open = extrasState.noteOpen;
      }

      if (noteLabel && cartDialog.dataset.orderNoteLabel) {
        noteLabel.textContent = cartDialog.dataset.orderNoteLabel;
      }

      if (noteFieldLabel && cartDialog.dataset.orderNoteLabel) {
        noteFieldLabel.textContent = cartDialog.dataset.orderNoteLabel;
      }

      if (noteInput) {
        if (cartDialog.dataset.orderNotePlaceholder) {
          noteInput.setAttribute('placeholder', cartDialog.dataset.orderNotePlaceholder);
        }
        if (noteDirty && typeof extrasState.noteValue === 'string') {
          noteInput.value = extrasState.noteValue;
        }
      }

      if (discountDetails) {
        discountDetails.hidden = cartDialog.dataset.showDiscount !== 'true';
        discountDetails.open = extrasState.discountOpen;
      }

      if (discountLabel && cartDialog.dataset.discountLabel) {
        discountLabel.textContent = cartDialog.dataset.discountLabel;
      }

      if (discountFieldLabel && cartDialog.dataset.discountPlaceholder) {
        discountFieldLabel.textContent = cartDialog.dataset.discountPlaceholder;
      }

      if (discountInput) {
        if (cartDialog.dataset.discountPlaceholder) {
          discountInput.setAttribute('placeholder', cartDialog.dataset.discountPlaceholder);
        }
        if (extrasState.discountValue) discountInput.value = extrasState.discountValue;
      }

      if (discountButton && cartDialog.dataset.discountButton) {
        discountButton.textContent = cartDialog.dataset.discountButton;
      }

      if (trust) {
        const enabled = cartDialog.dataset.showTrust === 'true';
        const message = (cartDialog.dataset.trustMessage || '').trim();
        const hasIcons = Boolean(trust.querySelector('.cosme-cart-drawer__payment-icon, .icon-svg, svg'));
        trust.hidden = !enabled || (!message && !hasIcons);

        if (trustMessage) {
          trustMessage.textContent = message;
        }

        const trustLine = trust.querySelector('.cosme-cart-drawer__trust-message');
        if (trustLine) trustLine.hidden = !message;
      }
    };

    const saveCartNote = async (note, options) => {
      const silent = options && options.silent;
      noteDirty = false;

      try {
        const response = await fetch(routesRoot() + 'cart/update.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({ note: note }),
        });

        const payload = await response.json();
        if (!response.ok) throw payload;

        if (!silent) announce(strings.noteSaved || strings.updated);
        return payload;
      } catch (error) {
        if (!silent) showError(customerErrorMessage(error));
        throw error;
      }
    };

    const queueNoteSave = (value) => {
      extrasState.noteValue = value;
      noteDirty = true;
      window.clearTimeout(noteTimer);
      noteTimer = window.setTimeout(() => {
        saveCartNote(value, { silent: true }).catch(() => {});
      }, 600);
    };

    const flushNoteSave = async () => {
      window.clearTimeout(noteTimer);
      if (!noteDirty) return;

      const input = cartBody.querySelector('[data-cart-drawer-note-input]');
      const value = input ? input.value : extrasState.noteValue || '';
      await saveCartNote(value, { silent: true }).catch(() => {});
    };

    const updateCartDiscount = async (discountValue, appliedCode, isRemove) => {
      if (requestInFlight) return;

      requestInFlight = true;
      clearError();
      setDiscountError('');
      setDrawerBusy(true);
      extrasState.discountOpen = true;

      try {
        const response = await fetch(routesRoot() + 'cart/update.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            discount: discountValue,
            sections: 'cart-drawer',
            sections_url: window.location.pathname,
          }),
        });

        const payload = await response.json();
        if (!response.ok) throw payload;

        if (appliedCode && !isRemove) {
          const codes = payload.discount_codes;
          if (Array.isArray(codes)) {
            const entry = findDiscountEntry(payload, appliedCode);
            if (!entry || entry.applicable === false) {
              const shopifyMessage =
                (entry && typeof entry.message === 'string' && entry.message.trim()) ||
                (typeof payload.description === 'string' && payload.description.trim()) ||
                strings.discountNotApplied ||
                strings.error;
              extrasState.discountValue = appliedCode;
              const failedHtml = payload.sections && payload.sections['cart-drawer'];
              if (failedHtml) {
                applySectionHtml(failedHtml, null, 'discount', payload);
              }
              setDiscountError(shopifyMessage, true);
              announce(shopifyMessage);
              return;
            }
          }
        }

        extrasState.discountValue = '';
        const sectionHtml = payload.sections && payload.sections['cart-drawer'];
        if (sectionHtml) {
          applySectionHtml(sectionHtml, null, 'discount', payload);
        } else {
          await refreshCartDrawer({ cartPayload: payload });
        }

        if (typeof payload.item_count === 'number') {
          updateCartCount(payload.item_count);
        }

        announce(isRemove ? strings.discountRemoved || strings.updated : strings.discountApplied || strings.updated);
      } catch (error) {
        const message = customerErrorMessage(error);
        setDiscountError(message, true);
        showError(message);
      } finally {
        requestInFlight = false;
        setDrawerBusy(false);
      }
    };

    const applyDiscountCode = () => {
      const input = cartBody.querySelector('[data-cart-drawer-discount-input]');
      if (!input) return;

      const code = input.value.trim();
      extrasState.discountOpen = true;
      extrasState.discountValue = code;

      if (!code) {
        setDiscountError(strings.discountEmpty, true);
        return;
      }

      const existing = currentDiscountCodes().filter(
        (entry) => entry.toLowerCase() !== code.toLowerCase()
      );
      updateCartDiscount(existing.concat([code]).join(','), code, false);
    };

    const removeDiscountCode = (code) => {
      extrasState.discountOpen = true;
      const remaining = currentDiscountCodes().filter(
        (entry) => entry.toLowerCase() !== String(code || '').trim().toLowerCase()
      );
      updateCartDiscount(remaining.join(','), code, true);
    };

    const applySectionHtml = (html, lineKey, focusPref, cartPayload) => {
      if (!html) return false;

      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      const newContent = doc.querySelector('[data-cart-drawer-content]');

      if (!newContent) return false;

      captureExtrasState();
      cartBody.innerHTML = newContent.outerHTML;

      const count =
        cartPayload && typeof cartPayload.item_count === 'number'
          ? cartPayload.item_count
          : Number(newContent.dataset.itemCount || 0);

      updateCartCount(count);
      syncFreeShippingFromDom(cartPayload);
      mountUpsell();
      applyDrawerExtras();
      restoreFocus(lineKey, focusPref);
      return true;
    };

    const fetchSectionHtml = async () => {
      const response = await fetch(routesRoot() + '?sections=cart-drawer');
      if (!response.ok) throw new Error('section');
      const data = await response.json();
      return data['cart-drawer'];
    };

    const refreshCartDrawer = async (options) => {
      const lineKey = options && options.lineKey;
      const focusPref = options && options.focusPref;
      const cartPayload = options && options.cartPayload;

      try {
        const html = await fetchSectionHtml();
        applySectionHtml(html, lineKey, focusPref, cartPayload);
      } catch (error) {
        return;
      }
    };

    const changeLineQuantity = async (lineKey, quantity, focusPref, previousQuantity) => {
      if (!lineKey || requestInFlight) return;

      const item = cartBody.querySelector('[data-cart-item][data-line-key="' + CSS.escape(lineKey) + '"]');
      const parsedQuantity = Number(quantity);

      if (!Number.isFinite(parsedQuantity) || parsedQuantity < 0 || parsedQuantity % 1 !== 0) {
        if (item) {
          const input = item.querySelector('[data-cart-quantity-input]');
          if (input) input.value = String(previousQuantity || input.dataset.currentQuantity || 1);
        }
        return;
      }

      requestInFlight = true;
      clearError();
      setDrawerBusy(true);
      if (item) {
        item.classList.add('is-updating');
        item.setAttribute('aria-busy', 'true');
      }

      try {
        const response = await fetch(routesRoot() + 'cart/change.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            id: lineKey,
            quantity: parsedQuantity,
            sections: 'cart-drawer',
            sections_url: window.location.pathname,
          }),
        });

        const payload = await response.json();

        if (!response.ok) {
          throw payload;
        }

        const sectionHtml = payload.sections && payload.sections['cart-drawer'];
        if (sectionHtml) {
          applySectionHtml(sectionHtml, lineKey, focusPref, payload);
        } else {
          await refreshCartDrawer({ lineKey: lineKey, focusPref: focusPref, cartPayload: payload });
        }

        if (typeof payload.item_count === 'number') {
          updateCartCount(payload.item_count);
        }

        if (parsedQuantity === 0) {
          announce(strings.itemRemoved);
        } else if (parsedQuantity === previousQuantity) {
          announce(strings.updated);
        } else {
          announce(strings.quantityUpdated);
        }
      } catch (error) {
        showError(customerErrorMessage(error));
        await refreshCartDrawer({ lineKey: lineKey, focusPref: focusPref });
      } finally {
        requestInFlight = false;
        setDrawerBusy(false);
        if (item) {
          item.classList.remove('is-updating');
          item.removeAttribute('aria-busy');
        }
      }
    };

    const syncDrawerViewport = () => {
      const viewport = window.visualViewport;
      const height = viewport ? Math.round(viewport.height) : window.innerHeight;
      cartDialog.style.setProperty('--cart-drawer-vh', height + 'px');
    };

    const startDrawerViewportSync = () => {
      syncDrawerViewport();
      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', syncDrawerViewport);
        window.visualViewport.addEventListener('scroll', syncDrawerViewport);
      } else {
        window.addEventListener('resize', syncDrawerViewport);
      }
    };

    const stopDrawerViewportSync = () => {
      if (window.visualViewport) {
        window.visualViewport.removeEventListener('resize', syncDrawerViewport);
        window.visualViewport.removeEventListener('scroll', syncDrawerViewport);
      } else {
        window.removeEventListener('resize', syncDrawerViewport);
      }
    };

    const drawerNeedsRefresh = () => {
      const content = cartBody.querySelector('[data-cart-drawer-content]');
      const badge = header.querySelector('[data-header-cart-count]');
      if (!content || !badge) return false;

      const bodyCount = Number(content.dataset.itemCount);
      const headerCount = Number(badge.textContent);
      if (!Number.isFinite(bodyCount) || !Number.isFinite(headerCount)) return false;
      return bodyCount !== headerCount;
    };

    const openCart = () => {
      if (cartDialog.open) return;

      lastFocusedElement = document.activeElement;
      startDrawerViewportSync();
      cartDialog.showModal();
      cartToggle.setAttribute('aria-expanded', 'true');

      const firstFocusable = getDrawerFocusable()[0];

      if (firstFocusable) {
        firstFocusable.focus();
      }

      syncFreeShippingFromDom();
      applyDrawerExtras();

      if (drawerNeedsRefresh()) {
        refreshCartDrawer();
      }
    };

    const closeCart = () => {
      if (!cartDialog.open) return;

      flushNoteSave();
      stopDrawerViewportSync();
      cartDialog.close();
      cartToggle.setAttribute('aria-expanded', 'false');

      if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
        lastFocusedElement.focus();
      } else {
        cartToggle.focus();
      }
    };

    cartBody.addEventListener('click', (event) => {
      const decrease = event.target.closest('[data-cart-quantity-decrease]');
      const increase = event.target.closest('[data-cart-quantity-increase]');
      const remove = event.target.closest('[data-cart-remove]');
      const discountRemove = event.target.closest('[data-cart-drawer-discount-remove]');

      if (discountRemove && cartBody.contains(discountRemove)) {
        event.preventDefault();
        removeDiscountCode(discountRemove.getAttribute('data-discount-code') || '');
        return;
      }

      if (!decrease && !increase && !remove) return;
      if (!cartBody.contains(event.target)) return;

      const item = event.target.closest('[data-cart-item]');
      if (!item || requestInFlight) {
        event.preventDefault();
        return;
      }

      const input = item.querySelector('[data-cart-quantity-input]');
      const lineKey = (remove && remove.dataset.lineKey) || (input && input.dataset.lineKey) || item.dataset.lineKey;
      const currentQuantity = Number(input && (input.dataset.currentQuantity || input.value));

      if (!lineKey) return;

      if (remove) {
        event.preventDefault();
        changeLineQuantity(lineKey, 0, 'remove', currentQuantity);
        return;
      }

      if (decrease) {
        changeLineQuantity(lineKey, Math.max(0, currentQuantity - 1), 'decrease', currentQuantity);
        return;
      }

      changeLineQuantity(lineKey, currentQuantity + 1, 'increase', currentQuantity);
    });

    cartBody.addEventListener('change', (event) => {
      const input = event.target.closest('[data-cart-quantity-input]');
      if (!input || !cartBody.contains(input) || requestInFlight) return;

      const lineKey = input.dataset.lineKey;
      const previousQuantity = Number(input.dataset.currentQuantity || 0);
      const nextQuantity = Number(input.value);

      changeLineQuantity(lineKey, nextQuantity, 'input', previousQuantity);
    });

    cartBody.addEventListener('input', (event) => {
      const noteInput = event.target.closest('[data-cart-drawer-note-input]');
      if (!noteInput || !cartBody.contains(noteInput)) return;
      queueNoteSave(noteInput.value);
    });

    cartDialog.addEventListener('submit', (event) => {
      const upsellForm = event.target.closest('.cosme-cart-drawer__upsell-form');
      if (upsellForm && cartDialog.contains(upsellForm)) {
        event.preventDefault();
        addUpsellToCart(upsellForm);
        return;
      }

      const discountForm = event.target.closest('[data-cart-drawer-discount-form]');
      if (discountForm && cartDialog.contains(discountForm)) {
        event.preventDefault();
        applyDiscountCode();
        return;
      }

      const checkoutForm = event.target.closest('.cosme-cart-drawer__checkout-form');
      if (checkoutForm && cartDialog.contains(checkoutForm) && noteDirty) {
        event.preventDefault();
        flushNoteSave().finally(() => {
          checkoutForm.submit();
        });
      }
    });

    cartToggle.addEventListener('click', openCart);

    cartCloseButtons.forEach((button) => {
      button.addEventListener('click', closeCart);
    });

    cartDialog.addEventListener('close', () => {
      cartToggle.setAttribute('aria-expanded', 'false');
      stopDrawerViewportSync();
    });

    cartDialog.addEventListener('click', (event) => {
      if (event.target === cartDialog) {
        closeCart();
      }
    });

    cartDialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeCart();
    });

    if (window.__cosmeHeaderCartRefresh) {
      document.removeEventListener('cart:refresh', window.__cosmeHeaderCartRefresh);
    }

    window.__cosmeHeaderCartRefresh = function () {
      refreshCartDrawer();
    };

    document.addEventListener('cart:refresh', window.__cosmeHeaderCartRefresh);

    syncFreeShippingFromDom();
    mountUpsell();
    applyDrawerExtras();
  };

  const startCosmeHeader = () => {
    document.querySelectorAll('.cosme-header').forEach(initCosmeHeader);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startCosmeHeader);
  } else {
    startCosmeHeader();
  }

  document.addEventListener('shopify:section:load', (event) => {
    const header = event.target.querySelector('.cosme-header');

    if (header) {
      initCosmeHeader(header);
    }

    if (event.target.querySelector('[data-header-cart-dialog], [data-cart-drawer-section]')) {
      document.querySelectorAll('.cosme-header').forEach((node) => {
        node.removeAttribute('data-cart-drawer-ready');
        initCosmeHeaderCart(node);
      });
    }
  });
{% endjavascript %}

