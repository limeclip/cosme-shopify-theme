{%- liquid
  assign header_appearance = section.settings.header_appearance | default: 'solid'
  assign sticky_enabled = false
  if section.settings.sticky_header == 'on'
    assign sticky_enabled = true
  endif

  assign initial_scheme = section.settings.color_scheme
  if header_appearance == 'transparent' or header_appearance == 'blur'
    assign initial_scheme = section.settings.transparent_color_scheme
  endif

  assign use_predictive_search = false
  if section.settings.search_style == 'predictive' and settings.enable_predictive_search
    assign use_predictive_search = true
  endif

  assign cart_drawer_enabled = false
  if settings.cart_type == 'drawer'
    assign cart_drawer_enabled = true
  endif
-%}

<div
  class="cosme-header-group full-width {% if header_appearance == 'transparent' or header_appearance == 'blur' %} cosme-header-group--overlay{% endif %}{% if sticky_enabled and section.settings.sticky_behavior == 'hide_on_scroll' %} cosme-header-group--hide-on-scroll{% endif %}{% if settings.enable_animations %} cosme-header-group--animated{% endif %}"
  data-header-group
  data-sticky="{{ sticky_enabled }}"
  style="--header-height: {{ section.settings.header_height }}px;"
>
  <header
    class="cosme-header full-width color-{{ initial_scheme }} cosme-header--layout-{{ section.settings.header_layout }} cosme-header--width-{{ section.settings.header_width }} cosme-header--appearance-{{ header_appearance }}{% if settings.enable_animations %} cosme-header--animated{% endif %}"
    data-header
    data-appearance="{{ header_appearance }}"
    data-scheme-default="{{ section.settings.color_scheme }}"
    data-scheme-transparent="{{ section.settings.transparent_color_scheme }}"
    data-scheme-scrolled="{{ section.settings.scrolled_color_scheme }}"
    data-predictive-search="{{ use_predictive_search }}"
    data-cart-drawer="{{ cart_drawer_enabled }}"
    {{ section.shopify_attributes }}
  >
    <div class="cosme-header__inner">
      <div class="cosme-header__leading">
        <button
          type="button"
          class="cosme-header__menu-toggle"
          data-header-menu-toggle
          aria-expanded="false"
          aria-controls="CosmeHeaderDrawer-{{ section.id }}"
        >
          <span class="cosme-header__menu-icon" data-header-menu-icon>
            {% render 'cosme-icon', icon: 'menu', size: 'lg' %}
          </span>
          <span class="cosme-header__menu-icon cosme-header__menu-icon--close" data-header-menu-close-icon hidden>
            {% render 'cosme-icon', icon: 'close', size: 'lg' %}
          </span>
          <span class="cosme-visually-hidden">{{ 'header.menu' | t }}</span>
        </button>

        {%- if section.settings.show_search -%}
          <button
            type="button"
            class="cosme-header__action cosme-header__action--search cosme-header__action--search-leading"
            data-header-search-toggle
            aria-expanded="false"
            aria-controls="CosmeHeaderSearch-{{ section.id }}"
          >
            {% render 'cosme-icon', icon: 'search', size: 'lg' %}
            <span class="cosme-visually-hidden">{{ 'header.search' | t }}</span>
          </button>
        {%- endif -%}
      </div>

      <a
        class="cosme-header__logo"
        href="{{ routes.root_url }}"
        {% if settings.logo != blank %}
          style="--cosme-header-logo-width: {{ settings.logo_width }}px;"
        {% endif %}
      >
        {%- if settings.logo != blank -%}
          {%- capture logo_sizes -%}{{ settings.logo_width }}px{%- endcapture -%}
          {% render 'cosme-image',
            image: settings.logo,
            class: 'cosme-header__logo-media',
            width: settings.logo_width,
            sizes: logo_sizes,
            loading: 'eager',
            alt: shop.name
          %}
        {%- else -%}
          <span class="cosme-header__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      {%- if section.settings.menu != blank -%}
        <nav class="cosme-header__nav" aria-label="{{ 'header.navigation' | t }}">
          <ul class="cosme-header__menu" role="list">
            {%- for link in section.settings.menu.links -%}
              {%- liquid
                assign is_active = false
                if link.active
                  assign is_active = true
                endif
                if link.child_active
                  assign is_active = true
                endif
              -%}
              <li
                class="cosme-header__item{% if link.links.size > 0 %} cosme-header__item--has-children{% endif %}{% if is_active %} cosme-header__item--active{% endif %}"
              >
                <a
                  href="{{ link.url }}"
                  class="cosme-header__link{% if is_active %} cosme-header__link--active{% endif %}"
                  {% if link.active %}
                    aria-current="page"
                  {% endif %}
                >
                  {{ link.title | escape }}
                  {%- if link.links.size > 0 -%}
                    {% render 'cosme-icon', icon: 'chevron-down', size: 'sm' %}
                  {%- endif -%}
                </a>

                {%- if link.links.size > 0 -%}
                  <ul class="cosme-header__submenu" role="list">
                    {%- for child_link in link.links -%}
                      <li>
                        <a
                          href="{{ child_link.url }}"
                          class="cosme-header__submenu-link{% if child_link.active %} cosme-header__submenu-link--active{% endif %}"
                          {% if child_link.active %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ child_link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <div class="cosme-header__actions">
        {%- if section.settings.show_search -%}
          <button
            type="button"
            class="cosme-header__action cosme-header__action--search cosme-header__action--search-actions"
            data-header-search-toggle
            aria-expanded="false"
            aria-controls="CosmeHeaderSearch-{{ section.id }}"
          >
            {% render 'cosme-icon', icon: 'search', size: 'lg' %}
            <span class="cosme-visually-hidden">{{ 'header.search' | t }}</span>
          </button>
        {%- endif -%}

        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <shopify-account
            class="cosme-header__action cosme-header__action--account cosme-header__action--account-bar"
            menu="{{ section.settings.customer_account_menu }}"
          >
            <span class="cosme-header__account-label" aria-hidden="true">{{ 'header.account' | t }}</span>
            {% render 'cosme-icon', icon: 'account', size: 'lg', class: 'cosme-header__account-icon' %}
            <span class="cosme-visually-hidden">{{ 'header.account' | t }}</span>
          </shopify-account>
        {%- endif -%}

        {%- if section.settings.show_cart -%}
          {%- if cart_drawer_enabled -%}
            <button
              type="button"
              class="cosme-header__action cosme-header__action--cart"
              data-header-cart-toggle
              aria-expanded="false"
              aria-controls="CosmeHeaderCart-{{ section.id }}"
              {% if cart.item_count > 0 %}
                aria-label="{{ 'header.cart_count' | t: count: cart.item_count }}"
              {% endif %}
            >
              {% render 'cosme-icon', icon: 'cart', size: 'lg' %}
              {%- if cart.item_count == 0 -%}
                <span class="cosme-visually-hidden">{{ 'header.cart' | t }}</span>
              {%- else -%}
                <span class="cosme-header__cart-count" data-header-cart-count aria-hidden="true">
                  {{- cart.item_count -}}
                </span>
              {%- endif -%}
            </button>
          {%- else -%}
            <a
              class="cosme-header__action cosme-header__action--cart"
              href="{{ routes.cart_url }}"
              {% if cart.item_count > 0 %}
                aria-label="{{ 'header.cart_count' | t: count: cart.item_count }}"
              {% endif %}
            >
              {% render 'cosme-icon', icon: 'cart', size: 'lg' %}
              {%- if cart.item_count == 0 -%}
                <span class="cosme-visually-hidden">{{ 'header.cart' | t }}</span>
              {%- else -%}
                <span class="cosme-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
              {%- endif -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>

    <dialog
      class="cosme-header__drawer cosme-header__drawer--{{ section.settings.menu_style | default: 'mega_menu_image' }}"
      id="CosmeHeaderDrawer-{{ section.id }}"
      data-header-drawer
      scroll-lock
      aria-label="{{ 'header.navigation_drawer' | t }}"
    >
      {% render 'cosme-header-drawer-content', section: section %}
    </dialog>

    {% render 'cosme-header-search', section: section, use_predictive: use_predictive_search %}

    {%- if cart_drawer_enabled -%}
      <dialog
        class="cosme-header__cart-dialog"
        id="CosmeHeaderCart-{{ section.id }}"
        data-header-cart-dialog
        scroll-lock
        aria-label="{{ 'cart.title' | t }}"
      >
        <div class="cosme-header__cart-panel color-{{ section.settings.color_scheme }}">
          <div class="cosme-header__cart-header">
            <h2 class="cosme-header__cart-title">{{ 'cart.title' | t }}</h2>
            <button
              type="button"
              class="cosme-header__cart-close"
              data-header-cart-close
              aria-controls="CosmeHeaderCart-{{ section.id }}"
            >
              {% render 'cosme-icon', icon: 'close', size: 'lg' %}
              <span class="cosme-visually-hidden">{{ 'cart.close' | t }}</span>
            </button>
          </div>

          <div class="cosme-header__cart-body" data-header-cart-body>
            {% render 'cosme-cart-drawer-content' %}
          </div>
        </div>
      </dialog>
    {%- endif -%}
  </header>
</div>

{% stylesheet %}
  .cosme-header-group {
    position: relative;
    z-index: 30;
  }

  .cosme-header-group--sticky {
    position: sticky;
    top: 0;
  }

  /* .cosme-header-group--overlay {
    height: 0;
  } */

  .cosme-header-group--overlay.cosme-header-group--scrolled {
    height: auto;
  }

  .cosme-header-group--overlay.cosme-header-group--sticky.cosme-header-group--scrolled {
    height: auto;
  }

  .cosme-header-group--overlay.cosme-header-group--sticky {
    position: sticky;
    top: 0;
  }

  .cosme-header-group:not(.cosme-header-group--overlay) {
    /* Solid mode: header occupies space and pushes content below */
    height: auto;
  }

  .cosme-header {
    position: relative;
    z-index: 1;
    color: var(--color-foreground);
    background-color: var(--color-background);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .cosme-header-group--overlay {
    height: auto; /* header занимает своё место */
  }

  .cosme-header-group--overlay .cosme-header--appearance-transparent.cosme-header--scrolled,
  .cosme-header-group--overlay .cosme-header--appearance-blur.cosme-header--scrolled {
    position: relative;
    width: 100%;
  }

  /* -------- Transparent (не прокручен) -------- */
  .cosme-header--appearance-transparent:not(.cosme-header--scrolled) {
    background-color: transparent;
    border-bottom-color: transparent;
    position: relative;
  }

  /* -------- Transparent (прокручен) -------- */
  .cosme-header--appearance-transparent.cosme-header--scrolled {
    background-color: color-mix(in srgb, var(--color-background) 82%, transparent);
    border-bottom-color: transparent;
    position: relative;
  }

  /* -------- Blur (не прокручен) -------- */
  .cosme-header--appearance-blur:not(.cosme-header--scrolled) {
    background-color: color-mix(in srgb, var(--color-background) 72%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom-color: color-mix(in srgb, var(--color-border) 50%, transparent);
    position: relative;
  }

  /* -------- Blur (прокручен) -------- */
  .cosme-header--appearance-blur.cosme-header--scrolled {
    background-color: color-mix(in srgb, var(--color-background) 72%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom-color: color-mix(in srgb, var(--color-border) 50%, transparent);
    position: relative;
  }
  .cosme-header-group--animated.cosme-header-group--hide-on-scroll {
    transition: transform var(--transition-duration) var(--transition-easing);
  }

  .cosme-header-group--animated.cosme-header-group--hide-on-scroll.cosme-header-group--scroll-hidden {
    transform: translateY(-100%);
  }

  .cosme-header--animated.cosme-header--appearance-transparent,
  .cosme-header--animated.cosme-header--appearance-blur {
    transition: background-color var(--transition-duration) var(--transition-easing),
      border-color var(--transition-duration) var(--transition-easing);
  }

  .cosme-header__inner {
    display: grid;
    align-items: center;
    gap: var(--spacing-lg);
    min-height: var(--header-height, 5rem);
    /* padding-block: var(--spacing-md); */
    padding-inline: var(--page-margin);
  }

  .cosme-header--width-page_width .cosme-header__inner {
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .cosme-header__leading {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .cosme-header__menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.55rem;
    height: 2.55rem;
    padding: 0;
    background-color: var(--color-foreground); 
    color: var(--color-background); 
    border: none; 
    border-radius: 50%; 
    cursor: pointer;
  }

  .cosme-header--animated .cosme-header__menu-toggle {
    transition: color var(--transition-duration) var(--transition-easing),
      background-color var(--transition-duration) var(--transition-easing),
      border-color var(--transition-duration) var(--transition-easing);
  }

  .cosme-header__menu-toggle:hover,
  .cosme-header__menu-toggle:focus-visible {
    background-color: var(--color-foreground); 
    color: var(--color-background); 
  }

  .cosme-header__menu-icon {
    display: inline-flex;
  }

  .cosme-header__menu-icon--close {
    display: none;
  }

  .cosme-header__menu-toggle[aria-expanded='true'] [data-header-menu-icon] {
    display: none;
  }

  .cosme-header__menu-toggle[aria-expanded='true'] [data-header-menu-close-icon] {
    display: inline-flex;
  }

  .cosme-header__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    color: var(--color-heading, var(--color-foreground));
    text-decoration: none;
  }

  .cosme-header__logo:hover,
  .cosme-header__logo:focus-visible {
    color: var(--color-heading, var(--color-foreground));
  }

  .cosme-header__logo-media .cosme-image__img,
  .cosme-header__logo-media.cosme-image__img {
    width: var(--cosme-header-logo-width, 7.5rem);
    max-width: 100%;
    height: auto;
  }

  .cosme-header__logo-text {
    font-family: var(--font-heading--family);
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: var(--font-heading--weight);
    line-height: var(--line-height-heading);
    letter-spacing: 0.08em;
    text-transform: lowercase;
  }

  .cosme-header__nav {
    display: none;
  }

  .cosme-header__menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cosme-header__item {
    position: relative;
    margin: 0;
  }

  .cosme-header__link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding-block: var(--spacing-xs);
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: var(--font-body--weight);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .cosme-header__link:hover,
  .cosme-header__link--active,
  .cosme-header__item--active > .cosme-header__link {
    color: var(--color-accent);
  }

  .cosme-header__submenu {
    position: absolute;
    top: calc(100% + var(--spacing-xs));
    left: 0;
    z-index: 40;
    min-width: 12rem;
    margin: 0;
    padding: var(--spacing-sm) 0;
    list-style: none;
    background-color: var(--color-background);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-input);
    opacity: 0;
    visibility: hidden;
    transform: translateY(calc(var(--spacing-xs) * -1));
  }

  .cosme-header--animated .cosme-header__submenu {
    transition: opacity var(--transition-duration) var(--transition-easing),
      transform var(--transition-duration) var(--transition-easing),
      visibility var(--transition-duration) var(--transition-easing);
  }

  .cosme-header__item--has-children:hover .cosme-header__submenu,
  .cosme-header__item--has-children:focus-within .cosme-header__submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .cosme-header__submenu-link {
    display: block;
    padding: var(--spacing-sm) var(--spacing-md);
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .cosme-header__submenu-link:hover,
  .cosme-header__submenu-link--active {
    color: var(--color-accent);
    background-color: var(--color-input-background);
  }

  .cosme-header__actions {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--spacing-md);
  }

  .cosme-header__action,
  shopify-account.cosme-header__action {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    color: var(--color-foreground);
    text-decoration: none;
    background: transparent;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-button);
  }

  .cosme-header--animated .cosme-header__action,
  .cosme-header--animated shopify-account.cosme-header__action {
    transition: color var(--transition-duration) var(--transition-easing);
  }

  .cosme-header__action:hover,
  .cosme-header__action:focus-visible,
  shopify-account.cosme-header__action:hover,
  shopify-account.cosme-header__action:focus-visible {
    color: var(--color-accent);
  }

  .cosme-header__account-label {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: var(--font-body--weight);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cosme-header__account-icon {
    display: inline-flex;
  }

  .cosme-header__cart-count {
    position: absolute;
    top: var(--spacing-xs);
    right: var(--spacing-xs);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1rem;
    height: 1rem;
    padding-inline: var(--spacing-xs);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent-contrast);
    background-color: var(--color-accent);
    border-radius: 999px;
  }

  .cosme-header__action--search-leading,
  .cosme-header__action--search-actions {
    display: none;
  }

  button.cosme-header__action {
    cursor: pointer;
    font: inherit;
  }

  /* -------- Search overlay -------- */
  .cosme-header__search-dialog {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    color: var(--color-foreground);
    background: transparent;
    border: 0;
    overflow: hidden;
  }

  .cosme-header__search-dialog::backdrop {
    background-color: var(--color-overlay);
    opacity: 0;
  }

  .cosme-header--animated .cosme-header__search-dialog,
  .cosme-header--animated .cosme-header__search-dialog::backdrop {
    transition: opacity var(--transition-duration) var(--transition-easing),
      overlay var(--transition-duration) var(--transition-easing) allow-discrete,
      display var(--transition-duration) var(--transition-easing) allow-discrete;
  }

  .cosme-header--animated .cosme-header__search-panel {
    transition: transform var(--transition-duration) var(--transition-easing),
      opacity var(--transition-duration) var(--transition-easing);
  }

  .cosme-header__search-dialog[open]::backdrop {
    opacity: var(--overlay-opacity);
  }

  .cosme-header__search-panel {
    display: flex;
    flex-direction: column;
    width: min(100vw, 40rem);
    max-height: min(100dvh, 32rem);
    margin: var(--spacing-xl) auto 0;
    padding: var(--spacing-xl);
    color: var(--color-foreground);
    background-color: var(--color-background);
    border: var(--border-width) solid var(--color-border);
    transform: translateY(calc(var(--spacing-md) * -1));
    opacity: 0;
  }

  .cosme-header__search-dialog[open] .cosme-header__search-panel {
    transform: translateY(0);
    opacity: 1;
  }

  @starting-style {
    .cosme-header__search-dialog[open]::backdrop {
      opacity: 0;
    }

    .cosme-header__search-dialog[open] .cosme-header__search-panel {
      transform: translateY(calc(var(--spacing-md) * -1));
      opacity: 0;
    }
  }

  .cosme-header__search-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
  }

  .cosme-header__search-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-weight: var(--font-heading--weight);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-heading, var(--color-foreground));
  }

  .cosme-header__search-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: var(--color-foreground);
    background: transparent;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-button);
    cursor: pointer;
  }

  .cosme-header__search-close:hover,
  .cosme-header__search-close:focus-visible {
    color: var(--color-accent);
  }

  .cosme-header__search-form {
    margin: 0;
  }

  .cosme-header__search-field .cosme-form-field__control {
    font-size: 1.125rem;
    padding-block: var(--spacing-md);
  }

  .cosme-header__search-results {
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-md);
    border-top: var(--border-width) solid var(--color-border);
  }

  .cosme-header__search-results[hidden] {
    display: none;
  }

  .cosme-header__search-result {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-md) 0;
    color: var(--color-foreground);
    text-decoration: none;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .cosme-header__search-result:last-child {
