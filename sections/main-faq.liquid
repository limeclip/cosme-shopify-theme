{% javascript %}
  (() => {
    const instances = new WeakMap();

    const formatCount = (root, count) => {
      if (count === 1) {
        return root.dataset.countOne || String(count);
      }

      const other = root.dataset.countOther || String(count);
      return other.replace(/2/, String(count));
    };

    const initFaqAccordion = (root) => {
      if (!root || root.dataset.faqAccordionReady === 'true') return;

      const items = Array.from(root.querySelectorAll('[data-faq-item]'));
      if (items.length === 0) return;

      let seenOpen = false;
      items.forEach((item) => {
        if (!item.open) return;
        if (seenOpen) {
          item.removeAttribute('open');
        } else {
          seenOpen = true;
        }
      });

      items.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (!item.open) return;
          items.forEach((other) => {
            if (other !== item && other.open) {
              other.removeAttribute('open');
            }
          });
        });
      });

      root.dataset.faqAccordionReady = 'true';
    };

    const initFaqFilters = (root) => {
      if (!root || !root.hasAttribute('data-faq-filter') || instances.has(root)) return;

      const items = Array.from(root.querySelectorAll('[data-faq-item]'));
      if (items.length === 0) return;

      const form = root.querySelector('[data-faq-search]');
      const input = root.querySelector('[data-faq-input]');
      const clearButton = root.querySelector('[data-faq-clear]');
      const nav = root.querySelector('[data-faq-nav]');
      const countEl = root.querySelector('[data-faq-count]');
      const emptyEl = root.querySelector('[data-faq-empty]');
      const listEl = root.querySelector('.cosme-faq__list');
      const navButtons = nav ? Array.from(nav.querySelectorAll('[data-faq-category]')) : [];

      let activeCategory = 'all';

      const applyFilters = () => {
        const query = input ? input.value.trim().toLowerCase() : '';
        let visible = 0;

        items.forEach((item) => {
          const category = item.getAttribute('data-faq-category') || '';
          const haystack = item.getAttribute('data-faq-search') || '';
          let match = true;

          if (activeCategory !== 'all') {
            if (category !== activeCategory) {
              match = false;
            }
          }

          if (match) {
            if (query !== '') {
              if (!haystack.includes(query)) {
                match = false;
              }
            }
          }

          item.hidden = !match;
          if (match) visible += 1;
        });

        if (clearButton) {
          clearButton.hidden = query === '';
        }

        if (listEl) {
          listEl.hidden = visible === 0;
        }

        if (emptyEl) {
          emptyEl.hidden = visible !== 0;
        }

        if (countEl) {
          countEl.textContent = formatCount(root, visible);
        }
      };

      const setCategory = (value) => {
        activeCategory = value || 'all';
        navButtons.forEach((button) => {
          const isActive = button.getAttribute('data-faq-category') === activeCategory;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
        applyFilters();
      };

      if (form) {
        form.addEventListener('submit', (event) => {
          event.preventDefault();
        });
      }

      if (input) {
        input.addEventListener('input', applyFilters);
      }

      if (clearButton) {
        clearButton.addEventListener('click', () => {
          if (!input) return;
          input.value = '';
          input.focus();
          applyFilters();
        });
      }

      if (nav) {
        nav.addEventListener('click', (event) => {
          const button = event.target.closest('[data-faq-category]');
          if (!button || !nav.contains(button)) return;
          setCategory(button.getAttribute('data-faq-category'));
        });
      }

      applyFilters();
      instances.set(root, true);
    };

    const initAll = (scope) => {
      const context = scope && scope.querySelectorAll ? scope : document;
      const roots = context.querySelectorAll ? context.querySelectorAll('[data-faq-root]') : [];
      roots.forEach((root) => {
        initFaqAccordion(root);
        initFaqFilters(root);
      });
      if (scope && scope.matches && scope.matches('[data-faq-root]')) {
        initFaqAccordion(scope);
        initFaqFilters(scope);
      }
    };

    initAll(document);

    document.addEventListener('shopify:section:load', (event) => {
      initAll(event.target);
    });
  })();
{% endjavascript %}

