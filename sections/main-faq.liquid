{% liquid
  assign heading_id = 'FaqHeading-' | append: section.id
  assign list_id = 'FaqList-' | append: section.id

  assign eyebrow = section.settings.eyebrow | strip
  assign heading = section.settings.heading | strip
  assign description = section.settings.description | strip
  assign intro_label = section.settings.intro_label | strip

  assign show_eyebrow = false
  if section.settings.show_eyebrow
    if eyebrow != blank
      assign show_eyebrow = true
    endif
  endif

  if heading == blank
    assign heading = page.title | strip
  endif
  if heading == blank
    assign heading = 'sections.faq.heading_fallback' | t
  endif

  assign hero_alignment = section.settings.hero_alignment | default: 'left'
  assign heading_size = section.settings.heading_size | default: 'large'
  assign hero_max_width = section.settings.hero_max_width | default: 'narrow'
  assign hero_spacing_top = section.settings.hero_spacing_top | default: 'large'
  assign hero_spacing_bottom = section.settings.hero_spacing_bottom | default: 'medium'
  assign faq_width = section.settings.faq_width | default: 'wide'
  assign faq_alignment = section.settings.faq_alignment | default: 'left'
  assign question_size = section.settings.question_size | default: 'medium'
  assign answer_size = section.settings.answer_size | default: 'medium'
  assign desktop_columns = section.settings.desktop_columns | default: '2'
  assign content_max_width = section.settings.content_max_width | default: 'medium'
  assign section_spacing_top = section.settings.section_spacing_top | default: 'small'
  assign section_spacing_bottom = section.settings.section_spacing_bottom | default: 'large'

  assign show_category = false
  if section.settings.show_category
    assign show_category = true
  endif

  assign show_numbering = false
  if section.settings.show_numbering
    assign show_numbering = true
  endif

  assign open_first = false
  if section.settings.open_first
    assign open_first = true
  endif

  assign border_width = section.settings.border_width | default: 1
  assign border_opacity = section.settings.border_opacity | default: 40 | divided_by: 100.0
  assign accordion_spacing = section.settings.accordion_spacing | default: 20

  assign enable_search = false
  if section.settings.enable_search
    assign enable_search = true
  endif

  assign enable_category_nav = false
  if section.settings.enable_category_nav
    assign enable_category_nav = true
  endif

  assign show_result_count = false
  if section.settings.show_result_count
    assign show_result_count = true
  endif

  assign search_placeholder = section.settings.search_placeholder | strip
  if search_placeholder == blank
    assign search_placeholder = 'sections.faq.search_placeholder' | t
  endif

  assign search_id = 'FaqSearch-' | append: section.id
  assign nav_id = 'FaqNav-' | append: section.id
  assign count_id = 'FaqCount-' | append: section.id
  assign empty_id = 'FaqEmpty-' | append: section.id

  assign category_keys = '|'
  assign faq_total = 0
  for block in section.blocks
    assign block_question = block.settings.question | strip
    if block_question != blank
      assign faq_total = faq_total | plus: 1
      assign block_category = block.settings.category | strip
      if block_category != blank
        assign block_category_key = block_category | handleize
        assign block_category_token = '|' | append: block_category_key | append: '|'
        unless category_keys contains block_category_token
          assign category_keys = category_keys | append: block_category_key | append: '|'
        endunless
      endif
    endif
  endfor

  assign show_category_nav = false
  if enable_category_nav
    if category_keys != '|'
      assign show_category_nav = true
    endif
  endif

  assign enable_filters = false
  if enable_search
    assign enable_filters = true
  endif
  if show_category_nav
    assign enable_filters = true
  endif

  assign show_tools = false
  if enable_filters
    assign show_tools = true
  endif
  if show_result_count
    assign show_tools = true
  endif

  assign enable_note = false
  if section.settings.enable_note
    assign enable_note = true
  endif
  assign note_title = section.settings.note_title | strip
  assign note_text = section.settings.note_text | strip
  assign show_note = false
  if enable_note
    if note_title != blank
      assign show_note = true
    endif
    if note_text != blank
      assign show_note = true
    endif
  endif

  assign enable_cta = false
  if section.settings.enable_cta
    assign enable_cta = true
  endif
  assign cta_eyebrow = section.settings.cta_eyebrow | strip
  assign cta_heading = section.settings.cta_heading | strip
  assign cta_description = section.settings.cta_description | strip
  assign cta_label = section.settings.cta_button_label | strip
  assign cta_link = section.settings.cta_link | default: '/pages/contact'
  if cta_link == blank
    assign cta_link = '/pages/contact'
  endif
  assign cta_spacing = section.settings.cta_spacing | default: 'medium'
  assign cta_heading_id = 'FaqCtaHeading-' | append: section.id

  assign show_cta = false
  if enable_cta
    if cta_eyebrow != blank
      assign show_cta = true
    endif
    if cta_heading != blank
      assign show_cta = true
    endif
    if cta_description != blank
      assign show_cta = true
    endif
    if cta_label != blank
      assign show_cta = true
    endif
  endif

  assign first_item_opened = false
  assign faq_index = 0
  assign rendered_category_keys = '|'
%}

<section
  id="Faq-{{ section.id }}"
  class="
    cosme-faq
    full-width
    color-{{ section.settings.color_scheme }}
    cosme-faq--align-{{ hero_alignment }}
    cosme-faq--heading-{{ heading_size }}
    cosme-faq--hero-{{ hero_max_width }}
    cosme-faq--hero-top-{{ hero_spacing_top }}
    cosme-faq--hero-bottom-{{ hero_spacing_bottom }}
    cosme-faq--faq-{{ faq_width }}
    cosme-faq--faq-align-{{ faq_alignment }}
    cosme-faq--question-{{ question_size }}
    cosme-faq--answer-{{ answer_size }}
    cosme-faq--cols-{{ desktop_columns }}
    cosme-faq--width-{{ content_max_width }}
    cosme-faq--section-top-{{ section_spacing_top }}
    cosme-faq--section-bottom-{{ section_spacing_bottom }}
    {% if show_numbering %}cosme-faq--numbered{% endif %}
    {% if enable_search %}cosme-faq--has-search{% endif %}
    {% if show_category_nav %}cosme-faq--has-nav{% endif %}
    {% if show_cta %}cosme-faq--has-cta{% endif %}
    {% if settings.enable_animations %}cosme-faq--animated{% endif %}
  "
  style="
    --faq-border-width: {{ border_width }}px;
    --faq-border-opacity: {{ border_opacity }};
    --faq-accordion-spacing: {{ accordion_spacing }}px;
  "
    data-faq-root
  {% if enable_filters %}
    data-faq-filter
  {% endif %}
  data-faq-accordion
  data-count-one="{{ 'sections.faq.result_count.one' | t: count: 1 | escape }}"
  data-count-other="{{ 'sections.faq.result_count.other' | t: count: 2 | escape }}"
  aria-labelledby="{{ heading_id }}"
  {{ section.shopify_attributes }}
>
  <div class="cosme-faq__inner">
    <header class="cosme-faq__hero">
      <div class="cosme-faq__hero-copy">
        {% if show_eyebrow %}
          <p class="cosme-faq__eyebrow">{{ eyebrow | escape }}</p>
        {% endif %}

        <h1 class="cosme-faq__heading" id="{{ heading_id }}">{{ heading | escape }}</h1>

        {% if description != blank %}
          <p class="cosme-faq__description">{{ description | escape }}</p>
        {% endif %}
      </div>
    </header>

    <div class="cosme-faq__body cosme-faq--faq-align-{{ faq_alignment }}">
      {% if intro_label != blank %}
        <p class="cosme-faq__label">{{ intro_label | escape }}</p>
      {% endif %}

      <div class="cosme-faq__content">
        {% if show_tools %}
          <div class="cosme-faq__tools">
            {% if enable_search %}
              <form
                class="cosme-faq__search"
                role="search"
                data-faq-search
                action="{{ request.path }}"
                method="get"
              >
                <label class="cosme-visually-hidden" for="{{ search_id }}">
                  {{ 'sections.faq.search_label' | t }}
                </label>
                <span class="cosme-faq__search-icon" aria-hidden="true">
                  {% render 'cosme-icon', icon: 'search', size: 'sm' %}
                </span>
                <input
                  id="{{ search_id }}"
                  class="cosme-faq__search-input"
                  type="search"
                  placeholder="{{ search_placeholder | escape }}"
                  autocomplete="off"
                  autocorrect="off"
                  autocapitalize="off"
                  spellcheck="false"
                  data-faq-input
                  aria-controls="{{ list_id }}"
                >
                <button
                  class="cosme-faq__search-clear"
                  type="button"
                  data-faq-clear
                  hidden
                >
                  {% render 'cosme-icon', icon: 'close', size: 'sm' %}
                  <span class="cosme-visually-hidden">{{ 'sections.faq.search_clear' | t }}</span>
                </button>
              </form>
            {% endif %}

            {% if show_category_nav %}
              <nav
                class="cosme-faq__nav"
                id="{{ nav_id }}"
                aria-label="{{ 'sections.faq.category_nav_label' | t }}"
                data-faq-nav
              >
                <div class="cosme-faq__nav-track">
                  <button
                    class="cosme-faq__nav-item is-active"
                    type="button"
                    data-faq-category="all"
                    aria-pressed="true"
                  >
                    {{ 'sections.faq.category_all' | t }}
                  </button>
                  {% for block in section.blocks %}
                    {% liquid
                      assign nav_question = block.settings.question | strip
                      assign nav_category = block.settings.category | strip
                    %}
                    {% if nav_question != blank %}
                      {% if nav_category != blank %}
                        {% liquid
                          assign nav_category_key = nav_category | handleize
                          assign nav_category_token = '|' | append: nav_category_key | append: '|'
                        %}
                        {% unless rendered_category_keys contains nav_category_token %}
                          {% assign rendered_category_keys = rendered_category_keys | append: nav_category_key | append: '|' %}
                          <button
                            class="cosme-faq__nav-item"
                            type="button"
                            data-faq-category="{{ nav_category_key | escape }}"
                            aria-pressed="false"
                          >
                            {{ nav_category | escape }}
                          </button>
                        {% endunless %}
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                </div>
              </nav>
            {% endif %}

            {% if show_result_count %}
              <p
                class="cosme-faq__count"
                id="{{ count_id }}"
                data-faq-count
                aria-live="polite"
              >
                {% if faq_total == 1 %}
                  {{ 'sections.faq.result_count.one' | t: count: faq_total }}
                {% else %}
                  {{ 'sections.faq.result_count.other' | t: count: faq_total }}
                {% endif %}
              </p>
            {% endif %}
          </div>
        {% endif %}

      <div class="cosme-faq__list" id="{{ list_id }}" aria-label="{{ 'sections.faq.landmark_label' | t }}">
        {% for block in section.blocks %}
          {% liquid
            assign question = block.settings.question | strip
            assign category = block.settings.category | strip
            assign answer = block.settings.answer
            assign answer_plain = answer | strip_html | strip
            assign category_key = category | handleize
            assign search_blob = question | append: ' ' | append: answer_plain | append: ' ' | append: category | downcase
          %}

          {% if question != blank %}
            {% liquid
              assign faq_index = faq_index | plus: 1
              assign faq_number = faq_index
              if faq_index < 10
                assign faq_number = faq_index | prepend: '0'
              endif

              assign item_open = false
              if block.settings.open_by_default
                assign item_open = true
              endif
              if item_open == false
                if open_first
                  unless first_item_opened
                    assign item_open = true
                  endunless
                endif
              endif
              if item_open
                assign first_item_opened = true
              endif

              assign item_id = 'FaqItem-' | append: section.id | append: '-' | append: block.id
            %}

            <details
              class="cosme-faq__item"
              id="{{ item_id }}"
              data-faq-item
              data-faq-category="{{ category_key | escape }}"
              data-faq-search="{{ search_blob | escape }}"
              {% if item_open %}
                open
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <summary class="cosme-faq__summary">
                {% if show_numbering %}
                  <span class="cosme-faq__number" aria-hidden="true">{{ faq_number }}</span>
                {% endif %}

                <span class="cosme-faq__summary-copy">
                  {% if show_category %}
                    {% if category != blank %}
                      <span class="cosme-faq__category">{{ category | escape }}</span>
                    {% endif %}
                  {% endif %}
                  <span class="cosme-faq__question">{{ question | escape }}</span>
                </span>

                <span class="cosme-faq__icon" aria-hidden="true">
                  <span class="cosme-faq__icon-plus">
                    {% render 'cosme-icon', icon: 'plus', size: 'sm' %}
                  </span>
                  <span class="cosme-faq__icon-minus">
                    {% render 'cosme-icon', icon: 'minus', size: 'sm' %}
                  </span>
                </span>
              </summary>

              <div class="cosme-faq__panel">
                {% if answer_plain != blank %}
                  <div class="cosme-faq__answer">{{ answer }}</div>
                {% endif %}
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>

        <div
          class="cosme-faq__empty"
          id="{{ empty_id }}"
          data-faq-empty
          role="status"
          aria-live="polite"
          hidden
        >
          <p class="cosme-faq__empty-heading">{{ 'sections.faq.empty_heading' | t }}</p>
          <p class="cosme-faq__empty-text">{{ 'sections.faq.empty_text' | t }}</p>
        </div>

        {% if show_note %}
          <aside class="cosme-faq__note" aria-label="{{ 'sections.faq.note_label' | t }}">
            {% if note_title != blank %}
              <p class="cosme-faq__note-title">{{ note_title | escape }}</p>
            {% endif %}
            {% if note_text != blank %}
              <p class="cosme-faq__note-text">{{ note_text | escape }}</p>
            {% endif %}
          </aside>
        {% endif %}
      </div>
    </div>
  </div>

  {% if show_cta %}
    <div
      class="cosme-faq__cta color-{{ section.settings.cta_color_scheme }} cosme-faq__cta--spacing-{{ cta_spacing }}"
      {% if cta_heading != blank %}
        aria-labelledby="{{ cta_heading_id }}"
      {% else %}
        aria-label="{{ 'sections.faq.cta_landmark' | t }}"
      {% endif %}
    >
      <div class="cosme-faq__cta-inner">
        {% if cta_eyebrow != blank %}
          <p class="cosme-faq__cta-eyebrow">{{ cta_eyebrow | escape }}</p>
        {% endif %}

        {% if cta_heading != blank %}
          <h2 class="cosme-faq__cta-heading" id="{{ cta_heading_id }}">{{ cta_heading | escape }}</h2>
        {% endif %}

        {% if cta_description != blank %}
          <p class="cosme-faq__cta-description">{{ cta_description | escape }}</p>
        {% endif %}

        {% if cta_label != blank %}
          {% render 'cosme-button',
            label: cta_label,
            url: cta_link,
            style: 'primary',
            class: 'cosme-faq__cta-button'
          %}
        {% endif %}
      </div>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .cosme-faq {
    overflow-x: clip;
    min-width: 0;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .cosme-faq__inner {
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    min-width: 0;
  }

  .cosme-faq--width-narrow .cosme-faq__inner {
    max-width: 52rem;
  }

  .cosme-faq--width-medium .cosme-faq__inner {
    max-width: var(--page-width);
  }

  .cosme-faq--width-wide .cosme-faq__inner {
    max-width: var(--page-width);
  }

  .cosme-faq--section-top-small .cosme-faq__inner {
    padding-block-start: calc(var(--spacing-section) * 0.2);
  }

  .cosme-faq--section-top-medium .cosme-faq__inner {
    padding-block-start: clamp(1.5rem, 4vw, calc(var(--spacing-section) * 0.55));
  }

  .cosme-faq--section-top-large .cosme-faq__inner {
    padding-block-start: clamp(2rem, 6vw, var(--spacing-section));
  }

  .cosme-faq--section-bottom-small .cosme-faq__inner {
    padding-block-end: calc(var(--spacing-section) * 0.35);
  }

  .cosme-faq--section-bottom-medium .cosme-faq__inner {
    padding-block-end: clamp(2rem, 5vw, calc(var(--spacing-section) * 0.75));
  }

  .cosme-faq--section-bottom-large .cosme-faq__inner {
    padding-block-end: clamp(2.75rem, 7vw, var(--spacing-section));
  }

  .cosme-faq--has-cta.cosme-faq--section-bottom-small .cosme-faq__inner,
  .cosme-faq--has-cta.cosme-faq--section-bottom-medium .cosme-faq__inner,
  .cosme-faq--has-cta.cosme-faq--section-bottom-large .cosme-faq__inner {
    padding-block-end: clamp(2rem, 5vw, 3.5rem);
  }

  .cosme-faq__hero {
    padding-block-start: clamp(2rem, 6vw, 5rem);
    padding-block-end: clamp(1.75rem, 4vw, 3rem);
  }

  .cosme-faq--hero-top-small .cosme-faq__hero {
    padding-block-start: clamp(1.5rem, 4vw, 2.5rem);
  }

  .cosme-faq--hero-top-medium .cosme-faq__hero {
    padding-block-start: clamp(2.25rem, 6vw, 4rem);
  }

  .cosme-faq--hero-top-large .cosme-faq__hero {
    padding-block-start: clamp(3rem, 8vw, 6.25rem);
  }

  .cosme-faq--hero-bottom-small .cosme-faq__hero {
    padding-block-end: clamp(1.25rem, 3vw, 2rem);
  }

  .cosme-faq--hero-bottom-medium .cosme-faq__hero {
    padding-block-end: clamp(2rem, 5vw, 3.5rem);
  }

  .cosme-faq--hero-bottom-large .cosme-faq__hero {
    padding-block-end: clamp(2.75rem, 6vw, 4.5rem);
  }

  .cosme-faq__hero-copy {
    max-width: 36rem;
  }

  .cosme-faq--hero-medium .cosme-faq__hero-copy {
    max-width: 44rem;
  }

  .cosme-faq--hero-wide .cosme-faq__hero-copy {
    max-width: 54rem;
  }

  .cosme-faq--align-center .cosme-faq__hero-copy {
    margin-inline: auto;
    text-align: center;
  }

  .cosme-faq__eyebrow {
    margin: 0 0 var(--spacing-sm);
    font-size: 0.6875rem;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-faq__heading {
    margin: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-heading, var(--color-foreground));
  }

  .cosme-faq--heading-small .cosme-faq__heading {
    font-size: clamp(1.625rem, 4vw, 2.25rem);
  }

  .cosme-faq--heading-medium .cosme-faq__heading {
    font-size: clamp(1.875rem, 5vw, 2.875rem);
  }

  .cosme-faq--heading-large .cosme-faq__heading {
    font-size: clamp(2rem, 5.8vw, 3.5rem);
  }

  .cosme-faq__description {
    max-width: 34rem;
    margin: var(--spacing-md) 0 0;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .cosme-faq--align-center .cosme-faq__description {
    margin-inline: auto;
  }

  .cosme-faq__body {
    display: grid;
    gap: var(--spacing-lg);
    min-width: 0;
  }

  .cosme-faq--faq-align-center .cosme-faq__body {
    justify-items: center;
    margin-inline: auto;
    width: 100%;
    max-width: min(100%, 46rem);
  }

  .cosme-faq--faq-align-center .cosme-faq__content {
    width: 100%;
  }

  .cosme-faq__label {
    margin: 0;
    font-size: 0.6875rem;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-faq__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
    min-width: 0;
    width: 100%;
  
  }

  .cosme-faq__tools {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-lg);
    min-width: 0;
    max-width: 100%;
  }

  .cosme-faq__search {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    width: 100%;
    max-width: 28rem;
    min-width: 0;
    padding-block: 0.65rem;
    padding-inline: 0;
    border-block-end: var(--faq-border-width, var(--border-width)) solid
      color-mix(in srgb, var(--color-border) calc(var(--faq-border-opacity, 0.4) * 100%), transparent);
    background: transparent;
  }

  .cosme-faq__search-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--color-muted);
  }

  .cosme-faq__search-input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-foreground);
    font-size: 0.9375rem;
    line-height: 1.4;
    appearance: none;
  }

  .cosme-faq__search-input::-webkit-search-decoration,
  .cosme-faq__search-input::-webkit-search-cancel-button,
  .cosme-faq__search-input::-webkit-search-results-button,
  .cosme-faq__search-input::-webkit-search-results-decoration {
    appearance: none;
  }

  .cosme-faq__search-input::placeholder {
    color: var(--color-muted);
  }

  .cosme-faq__search-input:focus {
    outline: none;
  }

  .cosme-faq__search:focus-within {
    border-block-end-color: var(--color-foreground);
  }

  .cosme-faq__search-input:focus-visible {
    outline: none;
  }

  .cosme-faq__search-clear {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-muted);
  }

  .cosme-faq__search-clear[hidden] {
    display: none;
  }

  .cosme-faq__search-clear:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-accent);
    outline-offset: 3px;
    color: var(--color-foreground);
  }

  @media (hover: hover) {
    .cosme-faq__search-clear:hover {
      color: var(--color-foreground);
    }
  }

  .cosme-faq__nav {
    min-width: 0;
    width: 100%;
    max-width: 100%;
  }

  .cosme-faq__nav-track {
    display: flex;
