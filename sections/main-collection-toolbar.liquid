  (() => {
    const SCROLL_LOCK_CLASS = 'cosme-collection-filters-scroll-lock';
    const FIXED_CLASS = 'cosme-collection-toolbar--fixed';
    const PLACEHOLDER_CLASS = 'cosme-collection-toolbar__sticky-placeholder';
    const READY_ATTRIBUTE = 'data-toolbar-ready';

    const lockScroll = () => {
      document.documentElement.classList.add(SCROLL_LOCK_CLASS);
      document.body.classList.add(SCROLL_LOCK_CLASS);
    };

    const unlockScroll = () => {
      document.documentElement.classList.remove(SCROLL_LOCK_CLASS);
      document.body.classList.remove(SCROLL_LOCK_CLASS);
    };

    const getStickyOffset = () => {
      const value = getComputedStyle(document.documentElement).getPropertyValue('--header-sticky-offset').trim();

      const parsed = parseFloat(value);

      return Number.isFinite(parsed) ? parsed : 0;
    };

    const initStickyToolbar = (root) => {
      if (!root || !root.classList.contains('cosme-collection-toolbar--sticky')) {
        return;
      }

      if (root.dataset.stickyReady === 'true') {
        return;
      }

      const bar = root.querySelector('.cosme-collection-toolbar__bar');

      /*
       * If there is no toolbar bar, there is nothing to make sticky.
       * Horizontal collection links remain completely unaffected.
       */
      if (!bar) {
        return;
      }

      root.dataset.stickyReady = 'true';

      const placeholder = document.createElement('div');

      placeholder.className = PLACEHOLDER_CLASS;
      placeholder.setAttribute('aria-hidden', 'true');

      /*
       * Placeholder occupies the original space of the bar
       * while the bar is position: fixed.
       */
      bar.parentNode.insertBefore(placeholder, bar);

      let isFixed = false;
      let ticking = false;

      const resetFixedStyles = () => {
        bar.style.width = '';
        bar.style.left = '';
        bar.style.right = '';
        bar.style.margin = '';
      };

      const activateFixed = () => {
        if (isFixed) return;

        const rect = bar.getBoundingClientRect();

        placeholder.style.height = `${rect.height}px`;
        placeholder.classList.add('is-active');

        bar.classList.add('cosme-collection-toolbar__bar--sticky');

        /*
         * Preserve the exact horizontal position and width
         * of the original toolbar bar.
         */
        bar.style.width = `${rect.width}px`;
        bar.style.left = `${rect.left}px`;
        bar.style.right = 'auto';
        bar.style.margin = '0';

        isFixed = true;
      };

      const deactivateFixed = () => {
        if (!isFixed) return;

        bar.classList.remove('cosme-collection-toolbar__bar--sticky');

        resetFixedStyles();

        placeholder.style.height = '';
        placeholder.classList.remove('is-active');

        isFixed = false;
      };

      const updateSticky = () => {
        ticking = false;

        if (!document.documentElement.contains(root)) {
          return;
        }

        const offset = getStickyOffset();

        /*
         * Before the bar becomes fixed:
         * check the bar itself.
         */
        if (!isFixed) {
          const rect = bar.getBoundingClientRect();

          if (rect.top <= offset) {
            activateFixed();
          }

          return;
        }

        /*
         * Once fixed, the placeholder represents the bar's
         * original position in the document.
         */
        const placeholderRect = placeholder.getBoundingClientRect();

        if (placeholderRect.top > offset) {
          deactivateFixed();
          return;
        }

