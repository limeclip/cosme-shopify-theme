{% liquid
  assign show_filters = section.settings.show_filters
  assign show_sorting = section.settings.show_sorting
  assign show_count = section.settings.show_product_count
  assign sticky_toolbar = section.settings.sticky_toolbar
  assign filter_count = collection.filters.size | default: 0
  assign has_filters = false
  if filter_count > 0
    assign has_filters = true
  endif

  assign show_filter_controls = false
  if show_filters
    if has_filters
      assign show_filter_controls = true
    endif
  endif

  assign product_count = collection.products_count | default: 0
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign active_filter_count = 0
  assign has_price_filter = false

  for filter in collection.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != blank
        assign has_price_filter = true
      endif
      if filter.max_value.value != blank
        assign has_price_filter = true
      endif
    endif
  endfor

  if has_price_filter
    assign active_filter_count = active_filter_count | plus: 1
  endif

  assign has_active_filters = false
  if active_filter_count > 0
    assign has_active_filters = true
  endif

  assign clear_url = collection.url
  if collection.sort_by != blank
    if collection.sort_by != collection.default_sort_by
      assign clear_url = collection.url | append: '?sort_by=' | append: collection.sort_by
    endif
  endif

  assign heading_id = 'CollectionFiltersHeading-' | append: section.id
  assign sort_id = 'CollectionSort-' | append: section.id
  assign dialog_id = 'CollectionFilters-' | append: section.id
  assign form_id = 'CollectionFilterForm-' | append: section.id
  assign sort_form_id = 'CollectionSortForm-' | append: section.id
  assign all_collections_url = routes.all_products_collection_url
  assign current_collection_handle = collection.handle
  assign current_collection_url = collection.url
  assign shop_collection_count = 0
  for c in shop.collections
    assign shop_collection_count = shop_collection_count | plus: 1
  endfor
  if shop_collection_count < 2
    assign shop_collection_count = 0
    for c in collections
      assign shop_collection_count = shop_collection_count | plus: 1
    endfor
  endif

  assign show_collection_dropdown = false
  if section.settings.show_collection_dropdown
    if shop.collections.size > 1
      assign show_collection_dropdown = true
    endif
    if shop_collection_count > 1
      assign show_collection_dropdown = true
    endif
  endif

  assign nav_collections = section.settings.collections_to_show
  assign nav_collection_count = 0
  if nav_collections != blank
    assign nav_collection_count = nav_collections.size
  endif

  assign show_horizontal_links = false
  if section.settings.show_horizontal_links
    if nav_collection_count > 1
      assign show_horizontal_links = true
    endif
  endif

  assign show_all_collections_link = section.settings.show_all_collections_link
  assign all_collections_active = false
  if current_collection_url == all_collections_url
    assign all_collections_active = true
  endif
  if current_collection_handle == 'all'
    assign all_collections_active = true
  endif

  assign show_toolbar_bar = false
  if show_filter_controls
    assign show_toolbar_bar = true
  endif
  if show_sorting
    assign show_toolbar_bar = true
  endif
  if show_count
    assign show_toolbar_bar = true
  endif
  if show_collection_dropdown
    assign show_toolbar_bar = true
  endif

  assign render_toolbar = false
  if show_toolbar_bar
    assign render_toolbar = true
  endif
  if show_horizontal_links
    assign render_toolbar = true
  endif
  if has_active_filters
    assign render_toolbar = true
  endif
%}

{% if render_toolbar %}
  <section
    class="
      cosme-collection-toolbar
      full-width
      color-{{ section.settings.color_scheme }}
      {% if sticky_toolbar %}cosme-collection-toolbar--sticky{% endif %}
      {% if settings.enable_animations %}cosme-collection-toolbar--animated{% endif %}
    "
    data-collection-toolbar
    data-sticky-toolbar="{% if sticky_toolbar %}true{% else %}false{% endif %}"
    aria-label="{{ 'collections.toolbar' | t }}"
    {{ section.shopify_attributes }}
  >
    <div class="cosme-collection-toolbar__inner">
      {% if show_horizontal_links %}
        <nav
          class="cosme-collection-toolbar__links cosme-collection-toolbar__links--align-{{ section.settings.horizontal_links_alignment | default: 'center' }}"
          aria-label="{{ 'collections.collection_links' | t }}"
        >
          <ul class="cosme-collection-toolbar__links-list" role="list">
            {% if show_all_collections_link %}
              <li>
                <a
                  class="cosme-collection-toolbar__link{% if all_collections_active %} cosme-collection-toolbar__link--active{% endif %}"
                  href="{{ all_collections_url }}"
                  {% if all_collections_active %}
                    aria-current="page"
                  {% endif %}
                >
                  {{ 'collections.all_collections' | t }}
                </a>
              </li>
            {% endif %}
            {% for nav_collection in nav_collections limit: 6 %}
              {% liquid
                assign link_active = false
                if nav_collection.handle == current_collection_handle
                  assign link_active = true
                endif
              %}
              <li>
                <a
                  class="cosme-collection-toolbar__link{% if link_active %} cosme-collection-toolbar__link--active{% endif %}"
                  href="{{ nav_collection.url }}"
                  {% if link_active %}
                    aria-current="page"
                  {% endif %}
                >
                  {{ nav_collection.title | escape }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}

      {% if show_toolbar_bar %}
        <div class="cosme-collection-toolbar__bar">
          <div class="cosme-collection-toolbar__start">
            {% if show_collection_dropdown %}
              <div class="cosme-dropdown cosme-dropdown--collection" data-cosme-dropdown>
                {% assign current_collection_title = 'collections.all_collections' | t %}

                {% if collection.handle != 'all' %}
                  {% for c in collections %}
                    {% if c.handle == collection.handle %}
                      {% assign current_collection_title = c.title %}
                      {% break %}
                    {% endif %}
                  {% endfor %}
                {% endif %}

                <button
                  type="button"
                  class="cosme-dropdown__trigger"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  data-dropdown-trigger
                >
                  <span data-dropdown-label>
                    {{ current_collection_title | escape }}
                  </span>

                  {% render 'cosme-icon', icon: 'chevron-down', size: 'sm' %}
                </button>

                <div
                  class="cosme-dropdown__menu"
                  data-dropdown-menu
                  role="listbox"
                  aria-label="{{ 'collections.collection_dropdown' | t }}"
                >
                  <button
                    type="button"
                    class="cosme-dropdown__option{% if all_collections_active %} is-selected{% endif %}"
                    role="option"
                    aria-selected="{% if all_collections_active %}true{% else %}false{% endif %}"
                    data-dropdown-option
                    data-url="{{ all_collections_url }}"
                  >
                    <span>{{ 'collections.all_collections' | t }}</span>

                    {% if all_collections_active %}
                      <span class="cosme-dropdown__check">✓</span>
                    {% endif %}
                  </button>

                  {% for c in collections %}
                    {% if c.handle != 'all' %}
                      <button
                        type="button"
                        class="cosme-dropdown__option{% if c.handle == current_collection_handle %} is-selected{% endif %}"
                        role="option"
                        aria-selected="{% if c.handle == current_collection_handle %}true{% else %}false{% endif %}"
                        data-dropdown-option
                        data-url="{{ c.url }}"
                      >
                        <span>{{ c.title | escape }}</span>

                        {% if c.handle == current_collection_handle %}
                          <span class="cosme-dropdown__check">✓</span>
                        {% endif %}
                      </button>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% endif %}
            {% if show_filter_controls %}
              <button
                type="button"
                class="cosme-collection-toolbar__filters-button"
                data-filter-open
                aria-expanded="false"
                aria-controls="{{ dialog_id }}"
                aria-haspopup="dialog"
              >
                <span>{{ 'collections.filters' | t }}</span>
                {% render 'cosme-icon', icon: 'plus', size: 'sm' %}
                {% if has_active_filters %}
                  <span class="cosme-collection-toolbar__filters-count">{{ active_filter_count }}</span>
                {% endif %}
              </button>
            {% endif %}
          </div>

          {% if show_count %}
            <p class="cosme-collection-toolbar__count" data-collection-count>
              {{ 'collections.products_count' | t: count: product_count }}
            </p>
          {% endif %}

          <div class="cosme-collection-toolbar__end">
            {% if show_sorting %}
              {% if collection.sort_options.size > 0 %}
                <form
                  id="{{ sort_form_id }}"
                  class="cosme-collection-toolbar__sort"
                  method="get"
                  action="{{ collection.url }}"
                >
                  {% for filter in collection.filters %}
                    {% if filter.type == 'price_range' %}
                      {% if filter.min_value.value != blank %}
                        <input
                          type="hidden"
                          name="{{ filter.min_value.param_name }}"
                          value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                        >
                      {% endif %}
                      {% if filter.max_value.value != blank %}
                        <input
                          type="hidden"
                          name="{{ filter.max_value.param_name }}"
                          value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                        >
                      {% endif %}
                    {% else %}
                      {% for value in filter.active_values %}
                        <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
                      {% endfor %}
                    {% endif %}
                  {% endfor %}

                  <label class="cosme-collection-toolbar__sort-label" for="{{ sort_id }}">
                    {{ 'collections.sort_by' | t }}
                  </label>
                  <div class="cosme-dropdown" data-cosme-dropdown>
                    <select
                      id="{{ sort_id }}"
                      name="sort_by"
                      data-sort-select
                      class="cosme-dropdown__native"
                      aria-hidden="true"
                      tabindex="-1"
                    >
                      {% for option in collection.sort_options %}
                        <option
                          value="{{ option.value | escape }}"
                          {% if option.value == sort_by %}
                            selected
                          {% endif %}
                        >
                          {{ option.name | escape }}
                        </option>
                      {% endfor %}
                    </select>

                    <button
                      type="button"
                      class="cosme-dropdown__trigger"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      data-dropdown-trigger
                    >
                      <span data-dropdown-label>
                        {% for option in collection.sort_options %}
                          {% if option.value == sort_by %}
                            {{ option.name | escape }}
                          {% endif %}
                        {% endfor %}
                      </span>

                      {% render 'cosme-icon', icon: 'chevron-down', size: 'sm' %}
                    </button>

                    <div
                      class="cosme-dropdown__menu"
                      data-dropdown-menu
                      role="listbox"
                    >
                      {% for option in collection.sort_options %}
                        <button
                          type="button"
                          class="cosme-dropdown__option{% if option.value == sort_by %} is-selected{% endif %}"
                          role="option"
                          aria-selected="{% if option.value == sort_by %}true{% else %}false{% endif %}"
                          data-dropdown-option
                          data-value="{{ option.value | escape }}"
                        >
                          <span>{{ option.name | escape }}</span>

                          {% if option.value == sort_by %}
                            <span class="cosme-dropdown__check">✓</span>
                          {% endif %}
                        </button>
                      {% endfor %}
                    </div>
                  </div>
                  <button class="cosme-visually-hidden" type="submit">
                    {{ 'collections.sort_by' | t }}
                  </button>
                </form>
              {% endif %}
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if has_active_filters %}
        <div class="cosme-collection-toolbar__chips" aria-label="{{ 'collections.active_filters' | t }}">
          {% for filter in collection.filters %}
            {% if filter.type == 'price_range' %}
              {% liquid
                assign price_chip_value = ''
                if filter.min_value.value != blank
                  assign price_min = filter.min_value.value | money
                  assign price_chip_value = price_min
                  if filter.max_value.value != blank
                    assign price_max = filter.max_value.value | money
                    assign price_chip_value = price_min | append: '–' | append: price_max
                  endif
                elsif filter.max_value.value != blank
                  assign price_chip_value = filter.max_value.value | money
                endif
              %}
              {% if price_chip_value != blank %}
                <a
                  class="cosme-collection-toolbar__chip"
                  href="{{ filter.url_to_remove }}"
                  aria-label="{{ 'collections.remove_filter' | t: label: filter.label, value: price_chip_value }}"
                >
                  <span>{{ 'collections.filter_chip' | t: label: filter.label, value: price_chip_value }}</span>
                  {% render 'cosme-icon', icon: 'close', size: 'sm' %}
                </a>
              {% endif %}
            {% else %}
              {% for value in filter.active_values %}
                <a
                  class="cosme-collection-toolbar__chip"
                  href="{{ value.url_to_remove }}"
                  aria-label="{{ 'collections.remove_filter' | t: label: filter.label, value: value.label }}"
                >
                  <span>{{ 'collections.filter_chip' | t: label: filter.label, value: value.label }}</span>
                  {% render 'cosme-icon', icon: 'close', size: 'sm' %}
                </a>
              {% endfor %}
            {% endif %}
          {% endfor %}

          <a class="cosme-collection-toolbar__clear" href="{{ clear_url }}">
            {{ 'collections.clear_all' | t }}
          </a>
        </div>
      {% endif %}
    </div>

    {% if show_filter_controls %}
      <dialog
        class="cosme-collection-filters color-{{ section.settings.color_scheme }}"
        id="{{ dialog_id }}"
        data-filter-dialog
        aria-labelledby="{{ heading_id }}"
        aria-modal="true"
      >
        <div class="cosme-collection-filters__panel">
          <div class="cosme-collection-filters__header">
            <h2 class="cosme-collection-filters__heading" id="{{ heading_id }}" tabindex="-1">
              {{ 'collections.filters' | t }}
            </h2>
            <button
              type="button"
              class="cosme-collection-filters__close"
              data-filter-close
              aria-label="{{ 'collections.close_filters' | t }}"
            >
              {% render 'cosme-icon', icon: 'close', size: 'md' %}
            </button>
          </div>

          <form
            id="{{ form_id }}"
            class="cosme-collection-filters__form"
            method="get"
            action="{{ collection.url }}"
          >
            <input type="hidden" name="sort_by" value="{{ sort_by | escape }}">

            <div class="cosme-collection-filters__body">
              {% for filter in collection.filters %}
                {% liquid
                  assign show_group = false
                  assign group_open = false
                  if filter.type == 'price_range'
                    assign show_group = true
                    if filter.min_value.value != blank
                      assign group_open = true
                    endif
                    if filter.max_value.value != blank
                      assign group_open = true
                    endif
                  endif
                  if filter.values.size > 0
                    assign show_group = true
                  endif
                  if filter.active_values.size > 0
                    assign group_open = true
                  endif
                  if forloop.first
                    assign group_open = true
                  endif
                %}

                {% if show_group %}
                  <details
                    class="cosme-collection-filters__group"
                    {% if group_open %}
                      open
                    {% endif %}
                  >
                    <summary class="cosme-collection-filters__summary">
                      <span>{{ filter.label | escape }}</span>
                      {% render 'cosme-icon', icon: 'chevron-down', size: 'sm' %}
                    </summary>

                    <div class="cosme-collection-filters__values">
                      {% if filter.type == 'price_range' %}
                        {% liquid
                          assign min_placeholder = 0 | money_without_currency | replace: ',', ''
                          assign max_placeholder = filter.range_max | money_without_currency | replace: ',', ''
                        %}
                        <div class="cosme-collection-filters__price">
                          <label class="cosme-collection-filters__price-field">
                            <span>{{ 'collections.price_from' | t }}</span>
                            <input
                              class="cosme-collection-filters__price-input"
                              type="number"
                              name="{{ filter.min_value.param_name }}"
                              inputmode="decimal"
                              min="0"
                              max="{{ max_placeholder }}"
                              placeholder="{{ min_placeholder }}"
                              {% if filter.min_value.value != blank %}
                                value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                              {% endif %}
                            >
                          </label>
                          <label class="cosme-collection-filters__price-field">
                            <span>{{ 'collections.price_to' | t }}</span>
                            <input
                              class="cosme-collection-filters__price-input"
                              type="number"
                              name="{{ filter.max_value.param_name }}"
                              inputmode="decimal"
                              min="0"
                              max="{{ max_placeholder }}"
                              placeholder="{{ max_placeholder }}"
                              {% if filter.max_value.value != blank %}
                                value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                              {% endif %}
                            >
                          </label>
                        </div>
                      {% else %}
                        <ul class="cosme-collection-filters__list" role="list">
                          {% for value in filter.values %}
                            {% liquid
                              assign value_disabled = false
                              if value.count == 0
                                unless value.active
                                  assign value_disabled = true
                                endunless
                              endif
                              assign filter_param_id = filter.param_name | replace: '.', '-' | replace: '[', '-' | replace: ']', ''
                              assign input_id = 'Filter-' | append: section.id | append: '-' | append: filter_param_id | append: '-' | append: forloop.index
                              assign has_swatch = false
                              if value.swatch != blank
                                assign has_swatch = true
                              endif
                            %}
                            <li class="cosme-collection-filters__item">
                              <label
                                class="cosme-collection-filters__option{% if value_disabled %} cosme-collection-filters__option--disabled{% endif %}{% if has_swatch %} cosme-collection-filters__option--swatch{% endif %}"
                                for="{{ input_id }}"
                              >
                                <input
                                  id="{{ input_id }}"
                                  class="cosme-collection-filters__checkbox"
                                  type="checkbox"
                                  name="{{ value.param_name }}"
                                  value="{{ value.value }}"
                                  {% if value.active %}
                                    checked
                                  {% endif %}
                                  {% if value_disabled %}
                                    disabled
                                  {% endif %}
                                >
                                {% if has_swatch %}
                                  <span
                                    class="cosme-collection-filters__swatch"
                                    aria-hidden="true"
                                    {% if value.swatch.image %}
                                      style="background-image: url({{ value.swatch.image | image_url: width: 80 }});"
                                    {% elsif value.swatch.color %}
                                      style="background-color: {{ value.swatch.color }};"
                                    {% endif %}
                                  ></span>
                                {% endif %}
                                <span class="cosme-collection-filters__option-label">{{ value.label | escape }}</span>
                                {% if value.count != blank %}
                                  <span class="cosme-collection-filters__option-count">{{ value.count }}</span>
                                {% endif %}
                              </label>
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </div>
                  </details>
                {% endif %}
              {% endfor %}
            </div>

            <div class="cosme-collection-filters__footer">
              <a class="cosme-collection-filters__clear" href="{{ clear_url }}">
                {{ 'collections.clear_all' | t }}
              </a>
              {% assign apply_label = 'collections.apply' | t %}
              {% render 'cosme-button',
                label: apply_label,
                type: 'submit',
                style: 'primary',
                class: 'cosme-collection-filters__apply'
              %}
            </div>
          </form>
        </div>
      </dialog>
    {% endif %}
  </section>
{% endif %}

{% stylesheet %}
  .cosme-collection-toolbar {
    background-color: var(--color-background);
    color: var(--color-foreground);
    position: relative;
    overflow: visible;
  }

  .cosme-collection-toolbar--sticky {
    position: relative;
    z-index: 20;
  }

  /*
 * Sticky applies only to the toolbar controls bar.
 * The horizontal collection links remain in normal document flow.
 */
  .cosme-collection-toolbar__bar--sticky {
    position: fixed;
    top: var(--header-sticky-offset, 0px);
    z-index: 100;
    box-sizing: border-box;
    background-color: var(--color-background);
  }
  .cosme-collection-toolbar__bar--sticky {
    box-sizing: border-box;
    padding-block: var(--spacing-xs);
    background-color: var(--color-background);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .cosme-collection-toolbar__sticky-placeholder {
    display: none;
    width: 100%;
  }

  .cosme-collection-toolbar__sticky-placeholder.is-active {
    display: block;
  }

  .cosme-collection-toolbar__inner {
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding: var(--spacing-md) var(--page-margin);
    border-bottom: var(--border-width) solid var(--color-border);
    overflow: visible;
  }

  .cosme-collection-toolbar__bar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: var(--spacing-md);
  min-width: 0;
}

.cosme-collection-toolbar__start {
  justify-self: start;
  min-width: 0;
}

.cosme-collection-toolbar__count {
  grid-column: 2;
  justify-self: center;
  margin: 0;
  text-align: center;
}

.cosme-collection-toolbar__end {
  grid-column: 3;
  justify-self: end;
  min-width: 0;
}

  .cosme-collection-toolbar__links {
    overflow-x: auto;

    margin-inline: auto;
    margin-block-end: var(--spacing-md);

    -webkit-overflow-scrolling: touch;
    padding-block-end: var(--spacing-md);
    /* border-bottom: var(--border-width) solid var(--color-border); */
  }

  .cosme-collection-toolbar__links:last-child {
    margin-block-end: 0;
  }

  .cosme-collection-toolbar__links-list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-lg);
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
  }
  .cosme-collection-toolbar__links--align-left .cosme-collection-toolbar__links-list {
    justify-content: flex-start;
  }
  .cosme-collection-toolbar__links--align-center .cosme-collection-toolbar__links-list {
    justify-content: center;
  }
  .cosme-collection-toolbar__links--align-right .cosme-collection-toolbar__links-list {
    justify-content: flex-end;
  }
  .cosme-collection-toolbar__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cosme-collection-toolbar__link:hover,
  .cosme-collection-toolbar__link--active {
    color: var(--color-accent);
  }

  .cosme-collection-toolbar__link--active {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cosme-collection-toolbar__start,
  .cosme-collection-toolbar__end,
  .cosme-collection-toolbar__sort {
    min-width: 0;
  }

  .cosme-collection-toolbar__start {
    display: flex;
    align-items: center;
    gap: var(--spacing-xl);
  }

  .cosme-collection-toolbar__start .cosme-collection-toolbar__sort-control {
    flex: 0 0 auto;
  }

  .cosme-collection-toolbar__end {
    justify-self: end;
  }

  .cosme-collection-toolbar__filters-button,
  .cosme-collection-toolbar__sort-select,
  .cosme-collection-switcher {
    font-family: inherit;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground);
    background: transparent;
    cursor: pointer;
  }

  .cosme-collection-toolbar__filters-button {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    min-height: 2.75rem;
    padding: 0;
    border: 0;
  }

  .cosme-collection-toolbar__filters-button:hover,
  .cosme-collection-toolbar__clear:hover,
  .cosme-collection-toolbar__chip:hover {
    color: var(--color-accent);
  }

  .cosme-collection-toolbar__filters-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.35rem;
    border-radius: 999px;
