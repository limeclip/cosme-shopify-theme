        const options = dropdown.querySelectorAll('[data-dropdown-option]');
        const nativeSelect = dropdown.querySelector('[data-sort-select]');
        const label = dropdown.querySelector('[data-dropdown-label]');

        if (!trigger || !menu) return;

        const close = () => {
          dropdown.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
        };

        const open = () => {
          document.querySelectorAll('[data-cosme-dropdown].is-open').forEach((item) => {
            if (item !== dropdown) {
              item.classList.remove('is-open');
              item.querySelector('[data-dropdown-trigger]')?.setAttribute('aria-expanded', 'false');
            }
          });

          dropdown.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        };

        trigger.addEventListener('click', (event) => {
          event.preventDefault();

          if (dropdown.classList.contains('is-open')) {
            close();
          } else {
            open();
          }
        });

        options.forEach((option) => {
          option.addEventListener('click', () => {
            const value = option.dataset.value;
            const url = option.dataset.url;

            if (url) {
              window.location.href = url;
              return;
            }

            if (nativeSelect && value) {
              nativeSelect.value = value;

              if (label) {
                label.textContent = option.querySelector('span')?.textContent.trim() || '';
              }

              nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));
            }

            close();
          });
        });

        trigger.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            close();
            return;
          }

          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();

            if (dropdown.classList.contains('is-open')) {
              close();
            } else {
              open();
            }
          }

          if (event.key === 'ArrowDown') {
            event.preventDefault();
            open();
            options[0]?.focus();
          }
        });

        options.forEach((option, index) => {
          option.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
              close();
              trigger.focus();
              return;
            }

            if (event.key === 'ArrowDown') {
              event.preventDefault();
              options[index + 1]?.focus();
            }

            if (event.key === 'ArrowUp') {
              event.preventDefault();

              if (index === 0) {
                trigger.focus();
              } else {
                options[index - 1]?.focus();
              }
            }
          });
        });
      });

      document.addEventListener('click', (event) => {
        dropdowns.forEach((dropdown) => {
          if (!dropdown.contains(event.target)) {
            dropdown.classList.remove('is-open');

            dropdown.querySelector('[data-dropdown-trigger]')?.setAttribute('aria-expanded', 'false');
          }
        });
      });
      initStickyToolbar(root);
    };

    const initAllToolbars = () => {
      document.querySelectorAll('[data-collection-toolbar]').forEach(initToolbar);
    };

    initAllToolbars();

    document.addEventListener('shopify:section:load', (event) => {
      const root = event.target.querySelector('[data-collection-toolbar]');

      if (root) {
        initToolbar(root);
      }
    });

    document.addEventListener('shopify:section:unload', (event) => {
      const root = event.target.querySelector('[data-collection-toolbar]');

      if (!root) return;

      root.dataset.stickyReady = 'false';
      root.removeAttribute(READY_ATTRIBUTE);
    });
  })();
{% endjavascript %}

