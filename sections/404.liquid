{% liquid
  assign heading_id = 'NotFoundHeading-' | append: section.id
  assign search_id = 'NotFoundSearch-' | append: section.id
  assign search_input_id = 'NotFoundSearchInput-' | append: section.id

  assign eyebrow = section.settings.eyebrow | strip
  assign heading = section.settings.heading | strip
  assign description = section.settings.description | strip
  assign primary_label = section.settings.primary_label | strip
  assign secondary_label = section.settings.secondary_label | strip
  assign search_label = section.settings.search_label | strip

  if heading == blank
    assign heading = '404.title' | t
  endif

  if primary_label == blank
    assign primary_label = '404.continue_shopping' | t
  endif

  if secondary_label == blank
    assign secondary_label = '404.back_to_home' | t
  endif

  if search_label == blank
    assign search_label = '404.search_label' | t
  endif

  assign show_search = false
  if section.settings.show_search
    assign show_search = true
  endif

  assign search_submit_label = blank
  if show_search
    assign search_submit_label = 'search.submit' | t
  endif

  assign show_image = false
  if section.settings.show_image
    if section.settings.image != blank
      assign show_image = true
    endif
  endif

  case section.settings.image_ratio
    when 'square'
      assign image_aspect_ratio = '1/1'
    when 'landscape'
      assign image_aspect_ratio = '3/2'
    when 'wide'
      assign image_aspect_ratio = '16/9'
    else
      assign image_aspect_ratio = '4/5'
  endcase

  assign image_alt = section.settings.image.alt | default: heading
  assign shop_url = routes.all_products_collection_url
  assign home_url = routes.root_url
%}

<main
  id="NotFound-{{ section.id }}"
  class="
    cosme-404
    full-width
    color-{{ section.settings.color_scheme }}
    {% if show_image %}cosme-404--has-image{% endif %}
    {% if settings.enable_animations %}cosme-404--animated{% endif %}
  "
  aria-labelledby="{{ heading_id }}"
  {{ section.shopify_attributes }}
>
  <div class="cosme-404__inner">
    {% if show_image %}
      <div class="cosme-404__media">
        {% render 'cosme-image',
          image: section.settings.image,
          alt: image_alt,
          class: 'cosme-404__image',
          width: 900,
          loading: 'eager',
          aspect_ratio: image_aspect_ratio,
          sizes: '(min-width: 768px) 22rem, 70vw'
        %}
      </div>
    {% endif %}

    <div class="cosme-404__content">
      {% if eyebrow != blank %}
        <p class="cosme-404__code" aria-hidden="true">{{ eyebrow | escape }}</p>
      {% endif %}

      <h1 class="cosme-404__title" id="{{ heading_id }}">{{ heading | escape }}</h1>

      {% if description != blank %}
        <p class="cosme-404__description">{{ description | escape }}</p>
      {% endif %}

      <div class="cosme-404__actions">
        {% render 'cosme-button',
          label: primary_label,
          url: shop_url,
          style: 'primary',
          class: 'cosme-404__cta'
        %}
        {% render 'cosme-button',
          label: secondary_label,
          url: home_url,
          style: 'tertiary',
          class: 'cosme-404__cta-secondary'
        %}
      </div>

      {% if show_search %}
        <form
          id="{{ search_id }}"
          class="cosme-404__search"
          action="{{ routes.search_url }}"
          method="get"
          role="search"
        >
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[prefix]" value="last">

          {% render 'cosme-form-field',
            label: search_label,
            id: search_input_id,
            name: 'q',
            type: 'search',
            autocomplete: 'off',
            class: 'cosme-404__search-field'
          %}

          {% render 'cosme-button',
            label: search_submit_label,
            type: 'submit',
            style: 'secondary',
            class: 'cosme-404__search-submit'
          %}
        </form>
      {% endif %}
    </div>
  </div>
</main>

{% stylesheet %}
  .cosme-404 {
    overflow-x: clip;
    min-width: 0;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .cosme-404__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: var(--page-width);
    min-width: 0;
    min-height: min(70svh, 46rem);
    margin-inline: auto;
    padding: clamp(3rem, 8vw, 6.5rem) var(--page-margin);
    text-align: center;
  }

  .cosme-404__media {
    width: min(100%, 18rem);
    margin-block-end: var(--spacing-xl);
    overflow: hidden;
  }

  .cosme-404__image,
  .cosme-404__media .cosme-image {
    width: 100%;
  }

  .cosme-404__media .cosme-image__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cosme-404__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 38rem;
    min-width: 0;
  }

  .cosme-404__code {
    margin: 0 0 var(--spacing-md);
    font-family: var(--font-heading--family);
    font-size: clamp(3.5rem, 12vw, 7.5rem);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    line-height: 0.9;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .cosme-404__title {
    margin: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-heading, var(--color-foreground));
  }

  .cosme-404__description {
    max-width: 32rem;
    margin: var(--spacing-md) 0 0;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .cosme-404__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-md) var(--spacing-xl);
    margin-block-start: var(--spacing-xl);
  }

  .cosme-404__cta {
    min-width: 10.5rem;
  }

  .cosme-404__cta-secondary {
    min-height: 2.75rem;
    padding-block: var(--spacing-sm);
  }

  .cosme-404__search {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-sm);
    width: 100%;
    max-width: 24rem;
    margin-block-start: var(--spacing-2xl);
    text-align: start;
  }

  .cosme-404__search-submit {
    width: 100%;
  }

  @media screen and (min-width: 768px) {
    .cosme-404__inner {
      min-height: min(78svh, 52rem);
    }

    .cosme-404__media {
      width: min(100%, 20rem);
    }

    .cosme-404__search {
      flex-direction: row;
      align-items: flex-end;
    }

    .cosme-404__search-field {
      flex: 1 1 auto;
      min-width: 0;
    }

    .cosme-404__search-submit {
      width: auto;
      flex: 0 0 auto;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .cosme-404--animated .cosme-404__code,
    .cosme-404--animated .cosme-404__title,
    .cosme-404--animated .cosme-404__description,
    .cosme-404--animated .cosme-404__actions,
    .cosme-404--animated .cosme-404__search,
    .cosme-404--animated .cosme-404__media {
      animation: cosme-404-enter 0.7s var(--transition-easing, ease) both;
    }

    .cosme-404--animated .cosme-404__title {
      animation-delay: 0.06s;
    }

    .cosme-404--animated .cosme-404__description {
      animation-delay: 0.12s;
    }

    .cosme-404--animated .cosme-404__actions {
      animation-delay: 0.18s;
    }

    .cosme-404--animated .cosme-404__search {
      animation-delay: 0.24s;
    }
  }

  @keyframes cosme-404-enter {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "enabled_on": {
    "templates": ["404"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.not_found.settings.eyebrow",
      "default": "404"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.not_found.settings.heading",
      "default": "We couldn't find that page."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.not_found.settings.description",
      "default": "The page you're looking for may have moved or no longer exists."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:sections.not_found.settings.primary_label",
      "default": "Continue shopping"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:sections.not_found.settings.secondary_label",
      "default": "Back to home"
    },
    {
      "type": "header",
      "content": "t:sections.not_found.settings.search_header"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:sections.not_found.settings.show_search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "t:sections.not_found.settings.search_label",
      "default": "Search Cosme",
      "visible_if": "{{ section.settings.show_search }}"
    },
    {
      "type": "header",
      "content": "t:sections.not_found.settings.image_header"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.not_found.settings.show_image",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.not_found.settings.image_ratio",
      "options": [
        { "value": "portrait", "label": "t:sections.blog.settings.ratio_portrait" },
        { "value": "square", "label": "t:sections.blog.settings.ratio_square" },
        { "value": "landscape", "label": "t:sections.blog.settings.ratio_landscape" },
        { "value": "wide", "label": "t:sections.blog.settings.ratio_wide" }
      ],
      "default": "portrait",
      "visible_if": "{{ section.settings.show_image }}"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
