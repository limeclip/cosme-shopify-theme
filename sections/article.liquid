{% liquid
  assign heading_id = 'ArticleHeading-' | append: section.id
  assign section_spacing = section.settings.section_spacing | default: 'medium'
  assign journal_url = article.blog.url | default: blog.url
  assign journal_title = article.blog.title | default: blog.title
  assign eyebrow_label = journal_title

  assign excerpt_text = article.excerpt | strip_html | strip
  assign show_excerpt = false
  if section.settings.show_excerpt
    if excerpt_text != blank
      assign show_excerpt = true
    endif
  endif

  assign author_name = article.author | strip
  assign show_author = false
  if section.settings.show_author
    if author_name != blank
      assign show_author = true
    endif
  endif

  assign reading_minutes = 0
  if section.settings.show_reading_time
    assign article_plain = article.content | strip_html | strip
    if article_plain != blank
      assign word_count = article_plain | split: ' ' | size
      assign reading_minutes = word_count | plus: 199 | divided_by: 200
      if reading_minutes < 1
        assign reading_minutes = 1
      endif
    endif
  endif

  assign show_date = section.settings.show_date
  assign show_meta = false
  if show_date
    if article.published_at != blank
      assign show_meta = true
    endif
  endif
  if show_author
    assign show_meta = true
  endif
  if reading_minutes > 0
    assign show_meta = true
  endif

  assign hero_alt = article.title
  if article.image != blank
    if article.image.alt != blank
      assign hero_alt = article.image.alt
    endif
  endif

  case section.settings.hero_image_ratio
    when 'wide'
      assign hero_ratio = '16/9'
      assign hero_height = 900
    when 'square'
      assign hero_ratio = '1/1'
      assign hero_height = 1200
    else
      assign hero_ratio = '16/10'
      assign hero_height = 1000
  endcase

  assign share_url = canonical_url | default: article.url
  assign share_title = article.title | strip_html
  assign share_url_encoded = share_url | url_encode
  assign share_title_encoded = share_title | url_encode
  assign pin_media = blank
  if article.image != blank
    assign pin_media = article.image | image_url: width: 1600
  endif

  assign previous_article = blog.previous_article
  assign next_article = blog.next_article
  assign show_pager = false
  if previous_article != blank
    assign show_pager = true
  endif
  if next_article != blank
    assign show_pager = true
  endif

  assign related_limit = section.settings.related_count | default: 3 | plus: 0
  if related_limit < 1
    assign related_limit = 1
  endif
  assign related_handles = ','
  assign related_found = 0
  assign show_related = false
  assign related_heading = section.settings.related_heading | strip
  if related_heading == blank
    assign related_heading = 'blog.related_stories' | t
  endif
  assign related_description = section.settings.related_description | strip
  assign related_heading_id = 'ArticleRelated-' | append: section.id

  if section.settings.show_related
    for related_article in blog.articles
      if related_found >= related_limit
        break
      endif
      unless related_article.id == article.id
        assign tagged_match = false
        if article.tags.size > 0
          if related_article.tags.size > 0
            for tag in related_article.tags
              if article.tags contains tag
                assign tagged_match = true
              endif
            endfor
          endif
        endif
        if tagged_match
          assign related_handles = related_handles | append: related_article.handle | append: ','
          assign related_found = related_found | plus: 1
        endif
      endunless
    endfor

    for related_article in blog.articles
      if related_found >= related_limit
        break
      endif
      unless related_article.id == article.id
        assign related_token = ',' | append: related_article.handle | append: ','
        assign already_related = false
        if related_handles contains related_token
          assign already_related = true
        endif
        unless already_related
          assign related_handles = related_handles | append: related_article.handle | append: ','
          assign related_found = related_found | plus: 1
        endunless
      endunless
    endfor

    if related_found > 0
      assign show_related = true
    endif
  endif

  assign related_cols = related_found
  if related_cols > 3
    assign related_cols = 3
  endif
  assign related_handle_list = related_handles | split: ','

  assign show_newsletter = section.settings.show_newsletter
  assign newsletter_eyebrow = section.settings.newsletter_eyebrow | strip
  assign newsletter_heading = section.settings.newsletter_heading | strip
  assign newsletter_description = section.settings.newsletter_description | strip
  assign newsletter_button_label = section.settings.newsletter_button_label | strip
  if newsletter_button_label == blank
    assign newsletter_button_label = 'blog.newsletter_submit' | t
  endif
  assign newsletter_email_label = 'blog.newsletter_email_label' | t
  assign newsletter_form_id = 'ArticleNewsletter-' | append: section.id
  assign newsletter_email_id = 'ArticleNewsletterEmail-' | append: section.id
  assign newsletter_success_id = 'ArticleNewsletterSuccess-' | append: section.id
  assign newsletter_heading_id = 'ArticleNewsletterHeading-' | append: section.id
%}

<article
  id="Article-{{ section.id }}"
  class="cosme-article full-width color-{{ section.settings.color_scheme }} cosme-article--spacing-{{ section_spacing }}{% if settings.enable_animations %} cosme-article--animated{% endif %}"
  aria-labelledby="{{ heading_id }}"
  {{ section.shopify_attributes }}
>
  <script type="application/ld+json">
    {{ article | structured_data }}
  </script>

  <div class="cosme-article__inner">
    {% if section.settings.show_back_link %}
      {% if journal_url != blank %}
        <a class="cosme-article__back" href="{{ journal_url }}">
          {% render 'cosme-icon', icon: 'chevron-left', size: 'sm', class: 'cosme-article__back-icon' %}
          <span>{{ 'blog.back_to_journal' | t }}</span>
        </a>
      {% endif %}
    {% endif %}

    <header class="cosme-article__header">
      {% if eyebrow_label != blank %}
        <p class="cosme-article__eyebrow">{{ eyebrow_label | escape }}</p>
      {% endif %}

      <h1 class="cosme-article__title" id="{{ heading_id }}">{{ article.title | escape }}</h1>

      {% if show_excerpt %}
        <p class="cosme-article__excerpt">{{ excerpt_text | escape }}</p>
      {% endif %}

      {% if show_meta %}
        <p class="cosme-article__meta">
          {% if show_date %}
            {% if article.published_at != blank %}
              {{ article.published_at | time_tag: format: 'date' }}
            {% endif %}
          {% endif %}
          {% if show_date %}
            {% if article.published_at != blank %}
              {% if show_author %}
                <span class="cosme-article__meta-sep" aria-hidden="true">·</span>
              {% elsif reading_minutes > 0 %}
                <span class="cosme-article__meta-sep" aria-hidden="true">·</span>
              {% endif %}
            {% endif %}
          {% endif %}
          {% if show_author %}
            <span>{{ author_name | escape }}</span>
            {% if reading_minutes > 0 %}
              <span class="cosme-article__meta-sep" aria-hidden="true">·</span>
            {% endif %}
          {% endif %}
          {% if reading_minutes > 0 %}
            <span>{{ 'blog.reading_time' | t: count: reading_minutes }}</span>
          {% endif %}
        </p>
      {% endif %}
    </header>

    {% if article.image != blank %}
      <div class="cosme-article__hero">
        {% render 'cosme-image',
          image: article.image,
          alt: hero_alt,
          class: 'cosme-article__hero-image',
          width: 1800,
          height: hero_height,
          crop: 'center',
          sizes: '(min-width: 990px) min(92vw, 1200px), 100vw',
          loading: 'eager',
          fetchpriority: 'high',
          aspect_ratio: hero_ratio
        %}
      </div>
    {% endif %}

    <div class="cosme-article__layout">
      {% if section.settings.show_share %}
        <div
          class="cosme-article__share"
          data-article-share-root
          data-share-url="{{ share_url | escape }}"
          data-share-title="{{ share_title | escape }}"
          data-string-copied="{{ 'blog.share_copied' | t | escape }}"
          data-string-copy-failed="{{ 'blog.share_copy_failed' | t | escape }}"
        >
          <p class="cosme-article__share-label" id="ArticleShareLabel-{{ section.id }}">
            {{ 'blog.share' | t }}
          </p>
          <ul class="cosme-article__share-list" role="list" aria-labelledby="ArticleShareLabel-{{ section.id }}">
            <li>
              <a
                class="cosme-article__share-link"
                href="https://www.facebook.com/sharer/sharer.php?u={{ share_url_encoded }}"
                target="_blank"
                rel="noopener noreferrer"
              >
                {% render 'cosme-icon', icon: 'facebook', size: 'xl' %}
                <span class="cosme-visually-hidden">{{ 'blog.share_facebook' | t }}</span>
              </a>
            </li>
            <li>
              <a
                class="cosme-article__share-link"
                href="https://twitter.com/intent/tweet?url={{ share_url_encoded }}&text={{ share_title_encoded }}"
                target="_blank"
                rel="noopener noreferrer"
              >
                {% render 'cosme-icon', icon: 'x', size: 'xl' %}
                <span class="cosme-visually-hidden">{{ 'blog.share_x' | t }}</span>
              </a>
            </li>
            {% if pin_media != blank %}
              <li>
                <a
                  class="cosme-article__share-link"
                  href="https://pinterest.com/pin/create/button/?url={{ share_url_encoded }}&description={{ share_title_encoded }}&media={{ pin_media | url_encode }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {% render 'cosme-icon', icon: 'pinterest', size: 'xl' %}
                  <span class="cosme-visually-hidden">{{ 'blog.share_pinterest' | t }}</span>
                </a>
              </li>
            {% endif %}
            <li>
              <button
                class="cosme-article__share-link"
                type="button"
                data-article-share
                hidden
              >
                {% render 'cosme-icon', icon: 'external-link', size: 'xl' %}
                <span class="cosme-visually-hidden">{{ 'blog.share_native' | t }}</span>
              </button>
            </li>
            <li>
              <button class="cosme-article__share-link" type="button" data-article-copy>
                {% render 'cosme-icon', icon: 'copy', size: 'xl' %}
                <span class="cosme-visually-hidden">{{ 'blog.copy_link' | t }}</span>
              </button>
            </li>
          </ul>
          <p class="cosme-visually-hidden" data-share-status role="status" aria-live="polite"></p>
        </div>
      {% endif %}

      <div class="cosme-article__content">
        {{ article.content }}

        {% if show_author %}
          <p class="cosme-article__byline">{{ 'blog.written_by' | t: author: author_name }}</p>
        {% endif %}
      </div>
    </div>

    {% if show_pager %}
      <nav class="cosme-article__pager" aria-label="{{ 'blog.article_navigation' | t }}">
        {% if previous_article != blank %}
          <a
            class="cosme-article__pager-link cosme-article__pager-link--prev"
            href="{{ previous_article.url }}"
            aria-label="{{ 'blog.previous_article_label' | t: title: previous_article.title | escape }}"
          >
            <span class="cosme-article__pager-label">
              {% render 'cosme-icon', icon: 'chevron-left', size: 'sm', class: 'cosme-article__pager-icon' %}
              <span>{{ 'blog.previous_article' | t }}</span>
            </span>
            <span class="cosme-article__pager-title">{{ previous_article.title | escape }}</span>
          </a>
        {% endif %}

        {% if next_article != blank %}
          <a
            class="cosme-article__pager-link cosme-article__pager-link--next"
            href="{{ next_article.url }}"
            aria-label="{{ 'blog.next_article_label' | t: title: next_article.title | escape }}"
          >
            <span class="cosme-article__pager-label">
              <span>{{ 'blog.next_article' | t }}</span>
              {% render 'cosme-icon', icon: 'chevron-right', size: 'sm', class: 'cosme-article__pager-icon' %}
            </span>
            <span class="cosme-article__pager-title">{{ next_article.title | escape }}</span>
          </a>
        {% endif %}
      </nav>
    {% endif %}

    {% if show_related %}
      <section
        class="cosme-article__related"
        style="--related-cols: {{ related_cols }};"
        aria-labelledby="{{ related_heading_id }}"
      >
        <header class="cosme-article__related-header">
          <h2 class="cosme-article__related-heading" id="{{ related_heading_id }}">
            {{ related_heading | escape }}
          </h2>
          {% if related_description != blank %}
            <p class="cosme-article__related-description">{{ related_description | escape }}</p>
          {% endif %}
        </header>

        <ul class="cosme-article__related-grid" role="list">
          {% for related_handle in related_handle_list %}
            {% if related_handle != blank %}
              {% liquid
                assign related_key = blog.handle | append: '/' | append: related_handle
                assign related_article = articles[related_key]
                if related_article == blank
                  for candidate_article in blog.articles
                    if candidate_article.handle == related_handle
                      assign related_article = candidate_article
                      break
                    endif
                  endfor
                endif
              %}
              {% if related_article != blank %}
                {% unless related_article.id == article.id %}
                  <li class="cosme-article__related-item">
                    <a
                      class="cosme-article__related-link"
                      href="{{ related_article.url }}"
                      aria-label="{{ 'blog.read_article_label' | t: title: related_article.title | escape }}"
                    >
                      {% render 'cosme-article-card',
                        article: related_article,
                        aspect_ratio: '4/5',
                        image_width: 900,
                        image_height: 1125,
                        sizes: '(min-width: 990px) 30vw, 92vw',
                        heading_tag: 'h3',
                        loading: 'lazy',
                        featured: false,
                        show_excerpt: false,
                        show_date: true,
                        show_reading_time: false,
                        show_category: true,
                        show_cta: true,
                        show_index: false,
                        category_label: journal_title,
                        placeholder_name: 'image'
                      %}
                    </a>
                  </li>
                {% endunless %}
              {% endif %}
            {% endif %}
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    {% if blog.comments_enabled? %}
      <section class="cosme-article__comments" aria-labelledby="ArticleComments-{{ section.id }}">
        <h2 class="cosme-article__comments-heading" id="ArticleComments-{{ section.id }}">
          {{ 'blog.article_comments' | t }}
        </h2>

        <div id="comments">
          {% paginate article.comments by 10 %}
            {% if article.comments_count > 0 %}
              <ol class="cosme-article__comment-list" role="list">
                {% for comment in article.comments %}
                  <li class="cosme-article__comment">
                    <p class="cosme-article__comment-meta">
                      <span>{{ comment.author | escape }}</span>
                      <span class="cosme-article__meta-sep" aria-hidden="true">·</span>
                      {{ comment.created_at | time_tag: format: 'date' }}
                    </p>
                    <div class="cosme-article__comment-body">{{ comment.content }}</div>
                  </li>
                {% endfor %}
              </ol>
            {% endif %}

            {% if paginate.pages > 1 %}
              <nav class="cosme-article__comments-pagination" aria-label="{{ 'blog.pagination' | t }}">
                {{ paginate | default_pagination: anchor: 'comments' }}
              </nav>
            {% endif %}
          {% endpaginate %}
        </div>

        {% assign comment_name_label = 'blog.comment_form_name' | t %}
        {% assign comment_email_label = 'blog.comment_form_email' | t %}
        {% assign comment_body_label = 'blog.comment_form_body' | t %}
        {% assign comment_submit_label = 'blog.comment_form_submit' | t %}
        {% form 'new_comment', article %}
          <h3 class="cosme-article__comment-form-title">{{ 'blog.comment_form_title' | t }}</h3>
          {{ form.errors | default_errors }}
          {% render 'cosme-form-field',
            label: comment_name_label,
            id: 'ArticleCommentAuthor',
            name: 'comment[author]',
            value: form.author,
            required: true,
            autocomplete: 'name'
          %}
          {% render 'cosme-form-field',
            label: comment_email_label,
            id: 'ArticleCommentEmail',
            name: 'comment[email]',
            type: 'email',
            value: form.email,
            required: true,
            autocomplete: 'email'
          %}
          {% render 'cosme-form-field',
            label: comment_body_label,
            id: 'ArticleCommentBody',
            name: 'comment[body]',
            type: 'textarea',
            value: form.body,
            required: true,
            rows: 5
          %}
          {% render 'cosme-button',
            label: comment_submit_label,
            type: 'submit',
            style: 'outline'
            class: 'cosme-article__comment-submit'
          %}
        {% endform %}
      </section>
    {% endif %}
  </div>

  {% if show_newsletter %}
    <section
      class="cosme-article__newsletter color-{{ section.settings.newsletter_color_scheme }}"
      {% if newsletter_heading != blank %}
        aria-labelledby="{{ newsletter_heading_id }}"
      {% else %}
        aria-label="{{ 'blog.newsletter_label' | t }}"
      {% endif %}
    >
      <div class="cosme-article__newsletter-inner">
        {% if newsletter_eyebrow != blank %}
          <p class="cosme-article__newsletter-eyebrow">{{ newsletter_eyebrow | escape }}</p>
        {% endif %}

        {% if newsletter_heading != blank %}
          <h2 class="cosme-article__newsletter-heading" id="{{ newsletter_heading_id }}">
            {{ newsletter_heading | escape }}
          </h2>
        {% endif %}

        {% if newsletter_description != blank %}
          <p class="cosme-article__newsletter-description">{{ newsletter_description | escape }}</p>
        {% endif %}

        {% form 'customer', id: newsletter_form_id, class: 'cosme-article__newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="hidden" name="customer[accepts_marketing]" value="true">

          {% liquid
            assign newsletter_error = blank
            assign newsletter_posted = false
            if form.posted_successfully?
              assign newsletter_posted = true
            endif
            if form.errors
              assign newsletter_error = 'blog.newsletter_error' | t
            endif
          %}

          {% if newsletter_posted %}
            <p
              class="cosme-article__newsletter-status"
              id="{{ newsletter_success_id }}"
              role="status"
              aria-live="polite"
              tabindex="-1"
            >
              {{ 'blog.newsletter_success' | t }}
            </p>
          {% endif %}

          {% render 'cosme-form-field',
            label: newsletter_email_label,
            id: newsletter_email_id,
            name: 'contact[email]',
            type: 'email',
            value: form.email,
            required: true,
            autocomplete: 'email',
            error: newsletter_error,
            class: 'cosme-article__newsletter-field'
          %}

          {% render 'cosme-button',
            label: newsletter_button_label,
            type: 'submit',
            style: 'primary',
            class: 'cosme-article__newsletter-submit'
          %}
        {% endform %}
      </div>
    </section>
  {% endif %}
</article>

{% stylesheet %}
  .cosme-article {
    overflow-x: clip;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .cosme-article__inner {
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    min-width: 0;
  }

  .cosme-article--spacing-small .cosme-article__inner {
    padding-block: calc(var(--spacing-section) * 0.4);
  }

  .cosme-article--spacing-medium .cosme-article__inner {
    padding-block: clamp(1.5rem, 3.5vw, calc(var(--spacing-section) * 0.7));
  }

  .cosme-article--spacing-large .cosme-article__inner {
    padding-block: clamp(2rem, 4.5vw, var(--spacing-section));
  }

  .cosme-article__back {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    min-height: 2.75rem;
    margin: 0 0 var(--spacing-lg);
    color: var(--color-muted);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .cosme-article__back:focus-visible {
    color: var(--color-foreground);
    outline: var(--focus-ring-width) solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .cosme-article__back:hover {
      color: var(--color-foreground);
    }
  }

  .cosme-article--animated .cosme-article__back-icon {
    transition: transform var(--transition-duration) var(--transition-easing);
  }

  .cosme-article--animated .cosme-article__back:hover .cosme-article__back-icon,
  .cosme-article--animated .cosme-article__back:focus-visible .cosme-article__back-icon {
    transform: translateX(-0.15em);
  }

  .cosme-article__header {
    max-width: 44rem;
    margin-inline: auto;
    margin-block-end: var(--spacing-xl);
    text-align: center;
  }

  .cosme-article__eyebrow {
    margin: 0 0 var(--spacing-sm);
    font-size: 0.6875rem;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-article__title {
    margin: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 6.5vw, 3.25rem);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-heading, var(--color-foreground));
  }

  .cosme-article__excerpt {
    margin: var(--spacing-md) auto 0;
    max-width: 38rem;
    font-size: 1.0625rem;
    line-height: var(--line-height-body);
    color: var(--color-muted);
  }

  .cosme-article__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35em 0.5em;
    margin: var(--spacing-md) 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-article__meta time,
  .cosme-article__comment-meta time {
    font-style: normal;
  }

  .cosme-article__meta-sep {
    color: var(--color-border);
  }

  .cosme-article__hero {
    width: 100%;
    margin-block-end: var(--spacing-2xl);
  }
.cosme-image {
  border-radius: var(--radius-card);
}
  .cosme-article__hero-image {
    width: 100%;
    border-radius: var(--radius-card);
  }

  .cosme-article__layout {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
    min-width: 0;
  }

  .cosme-article__content {
    order: 1;
    width: 100%;
    min-width: 0;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-foreground);
    overflow-wrap: anywhere;
    overflow-x: auto;
  }

  .cosme-article__share {
    order: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .cosme-article__share-label {
    margin: 0;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-article__share-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cosme-article__share-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    text-decoration: none;
  }

  .cosme-article__share-link:focus-visible {
    color: var(--color-foreground);
    outline: var(--focus-ring-width) solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .cosme-article__share-link:hover {
      color: var(--color-foreground);
    }
  }

  .cosme-article__content > * {
