{% javascript %}
  (() => {
    if (window._cosmeArticleShare) return;
    window._cosmeArticleShare = true;

    const initShare = (root) => {
      if (!root) return;
      const nativeButton = root.querySelector('[data-article-share]');
      if (nativeButton && navigator.share) {
        nativeButton.hidden = false;
      }
    };

    document.querySelectorAll('[data-article-share-root]').forEach(initShare);

    document.addEventListener('click', async (event) => {
      const nativeButton = event.target.closest('[data-article-share]');
      const copyButton = event.target.closest('[data-article-copy]');
      if (!nativeButton && !copyButton) return;

      const root = event.target.closest('[data-article-share-root]');
      if (!root) return;

      const url = root.dataset.shareUrl || window.location.href;
      const title = root.dataset.shareTitle || document.title;
      const status = root.querySelector('[data-share-status]');

      try {
        if (nativeButton) {
          if (!navigator.share) return;
          await navigator.share({ title, url });
          return;
        }

        await navigator.clipboard.writeText(url);
        if (status) status.textContent = root.dataset.stringCopied || '';
      } catch (error) {
        if (error && error.name === 'AbortError') return;
        if (status) status.textContent = root.dataset.stringCopyFailed || '';
      }
    });

    document.addEventListener('shopify:section:load', (event) => {
      event.target.querySelectorAll('[data-article-share-root]').forEach(initShare);
    });
  })();
{% endjavascript %}

