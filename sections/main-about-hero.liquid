{% liquid
  assign heading_id = 'AboutHeading-' | append: section.id

  assign eyebrow = section.settings.eyebrow | strip
  assign heading = section.settings.heading | strip
  assign description = section.settings.description | strip
  assign image_alt = section.settings.image_alt | strip

  if heading == blank
    assign heading = page.title | strip
  endif
  if heading == blank
    assign heading = 'sections.about.heading_fallback' | t
  endif

  assign text_alignment = section.settings.text_alignment | default: 'left'
  assign content_width = section.settings.content_width | default: 'medium'
  assign section_spacing = section.settings.section_spacing | default: 'large'

  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign has_desktop_image = false
  assign has_mobile_image = false

  if desktop_image != blank
    assign has_desktop_image = true
  endif
  if mobile_image != blank
    assign has_mobile_image = true
  endif

  assign has_image = false
  if has_desktop_image
    assign has_image = true
  endif
  if has_mobile_image
    assign has_image = true
  endif

  assign hero_image = desktop_image
  if has_desktop_image == false
    if has_mobile_image
      assign hero_image = mobile_image
    endif
  endif

  if image_alt == blank
    if hero_image != blank
      if hero_image.alt != blank
        assign image_alt = hero_image.alt
      endif
    endif
  endif
  if image_alt == blank
    assign image_alt = heading
  endif

  case section.settings.image_ratio
    when 'portrait'
      assign image_aspect_ratio = '4/5'
    when 'square'
      assign image_aspect_ratio = '1/1'
    when 'wide'
      assign image_aspect_ratio = '16/9'
    when 'adapt'
      if hero_image != blank
        assign image_aspect_ratio = hero_image.aspect_ratio
      else
        assign image_aspect_ratio = '3/2'
      endif
    else
      assign image_aspect_ratio = '3/2'
  endcase

  assign image_sizes = '(min-width: 1440px) 1400px, 100vw'
%}

<section
  id="AboutHero-{{ section.id }}"
  class="
    cosme-about-hero
    full-width
    color-{{ section.settings.color_scheme }}
    cosme-about-hero--align-{{ text_alignment }}
    cosme-about-hero--width-{{ content_width }}
    cosme-about-hero--spacing-{{ section_spacing }}
    {% if has_image %}cosme-about-hero--has-image{% endif %}
    {% if settings.enable_animations %}cosme-about-hero--animated{% endif %}
  "
  style="--about-hero-ratio: {{ image_aspect_ratio }};"
  aria-labelledby="{{ heading_id }}"
  {{ section.shopify_attributes }}
>
  <div class="cosme-about-hero__inner">
    <header class="cosme-about-hero__copy">
      {% if eyebrow != blank %}
        <p class="cosme-about-hero__eyebrow">{{ eyebrow | escape }}</p>
      {% endif %}

      <h1 class="cosme-about-hero__heading" id="{{ heading_id }}">{{ heading | escape }}</h1>

      {% if description != blank %}
        <p class="cosme-about-hero__description">
          {{ description | escape | newline_to_br }}
        </p>
      {% endif %}
    </header>

    <div class="cosme-about-hero__media">
      {%- if has_image -%}
        {%- if has_desktop_image and has_mobile_image -%}
          <div class="cosme-about-hero__frame">
            <picture>
              <source
                media="(max-width: 749px)"
                srcset="
                  {{ mobile_image | image_url: width: 500 }} 500w,
                  {{ mobile_image | image_url: width: 750 }} 750w,
                  {{ mobile_image | image_url: width: 1000 }} 1000w,
                  {{ mobile_image | image_url: width: 1400 }} 1400w
                "
                sizes="100vw"
              >
              {{
                desktop_image
                | image_url: width: 2400
                | image_tag:
                  class: 'cosme-about-hero__img',
                  alt: image_alt,
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '750, 990, 1200, 1500, 1800, 2400',
                  sizes: image_sizes
              }}
            </picture>
          </div>
        {%- else -%}
          {% render 'cosme-image',
            image: hero_image,
            alt: image_alt,
            class: 'cosme-about-hero__image',
            width: 2400,
            sizes: image_sizes,
            loading: 'eager',
            fetchpriority: 'high',
            aspect_ratio: image_aspect_ratio
          %}
        {%- endif -%}
      {%- else -%}
        <div class="cosme-about-hero__fallback" aria-hidden="true">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'cosme-about-hero__placeholder-svg' }}
          {% if request.design_mode %}
            <p class="cosme-about-hero__fallback-hint">
              {{ 'sections.about.image_placeholder' | t }}
            </p>
          {% endif %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .cosme-about-hero {
    overflow-x: clip;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .cosme-about-hero__inner {
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .cosme-about-hero--spacing-small .cosme-about-hero__inner {
    padding-block: clamp(1.75rem, 4vw, 3rem);
  }

  .cosme-about-hero--spacing-medium .cosme-about-hero__inner {
    padding-block: clamp(2.25rem, 5.5vw, 4.5rem);
  }

  .cosme-about-hero--spacing-large .cosme-about-hero__inner {
    padding-block: clamp(2.5rem, 7vw, 6.5rem);
  }

  .cosme-about-hero__copy {
    max-width: 36rem;
    margin-block-end: clamp(1.75rem, 4vw, 3rem);
  }

  .cosme-about-hero--width-medium .cosme-about-hero__copy {
    max-width: 44rem;
  }

  .cosme-about-hero--width-wide .cosme-about-hero__copy {
    max-width: 56rem;
  }

  .cosme-about-hero--align-center .cosme-about-hero__copy {
    margin-inline: auto;
    text-align: center;
  }

  .cosme-about-hero--align-right .cosme-about-hero__copy {
    margin-inline-start: auto;
    text-align: right;
  }

  .cosme-about-hero__eyebrow {
    margin: 0 0 var(--spacing-sm);
    font-size: 0.6875rem;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-about-hero__heading {
    margin: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-heading--family);
    font-size: clamp(2.25rem, 7vw, 4.75rem);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-heading, var(--color-foreground));
  }

  .cosme-about-hero__description {
    max-width: 36rem;
    margin: var(--spacing-md) 0 0;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .cosme-about-hero--align-center .cosme-about-hero__description {
    margin-inline: auto;
  }

  .cosme-about-hero--align-right .cosme-about-hero__description {
    margin-inline-start: auto;
  }

  .cosme-about-hero__media,
  .cosme-about-hero__frame,
  .cosme-about-hero__image,
  .cosme-about-hero__fallback {
    min-width: 0;
  }

  .cosme-about-hero__frame,
  .cosme-about-hero__fallback {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: var(--about-hero-ratio);
    border-radius: 0;
  }

  .cosme-about-hero__frame picture,
  .cosme-about-hero__frame img,
  .cosme-about-hero__img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cosme-about-hero__img {
    object-fit: cover;
    object-position: center;
  }

  .cosme-about-hero__image.cosme-image {
    border-radius: 0;
  }

  .cosme-about-hero__fallback {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: var(--spacing-lg);
    background: linear-gradient(
      165deg,
      var(--color-background-2, #f5f5f5) 0%,
      var(--color-background) 48%,
      color-mix(in srgb, var(--color-accent, #1f1e20) 8%, var(--color-background-2, #f5f5f5)) 100%
    );
  }

  .cosme-about-hero__fallback-hint {
    margin: 0;
    max-width: 22rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-about-hero__placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0);
    opacity: 0.35;
  }

  .color-scheme-2 .cosme-about-hero__placeholder-svg {
    filter: brightness(0) invert(1);
    opacity: 0.25;
  }

  @media screen and (min-width: 750px) {
    .cosme-about-hero__description {
      font-size: 1.125rem;
    }
  }

  @media screen and (min-width: 990px) {
    .cosme-about-hero--spacing-large .cosme-about-hero__inner {
      padding-block: clamp(3.5rem, 8vw, 7.5rem);
    }

    .cosme-about-hero__copy {
      margin-block-end: clamp(2.5rem, 5vw, 4rem);
    }

    .cosme-about-hero__heading {
      font-size: clamp(3.25rem, 6vw, 5.25rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .cosme-about-hero--animated .cosme-about-hero__copy,
    .cosme-about-hero--animated .cosme-about-hero__media {
      animation: cosme-about-hero-enter 0.8s var(--transition-easing, ease) both;
    }

    .cosme-about-hero--animated .cosme-about-hero__media {
      animation-delay: 0.12s;
    }
  }

  @keyframes cosme-about-hero-enter {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.about_hero",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.about.settings.eyebrow",
      "default": "ABOUT COSME"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.about.settings.heading",
      "default": "Beauty, thoughtfully considered."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.about.settings.description",
      "default": "Cosme is a modern approach to beauty — thoughtful formulas, intentional rituals, and products designed to become part of everyday life."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.about.settings.text_alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.about.settings.content_width",
      "options": [
        { "value": "narrow", "label": "t:options.page_width.narrow" },
        { "value": "medium", "label": "t:options.size.medium" },
        { "value": "wide", "label": "t:options.page_width.wide" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.about.settings.image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.about.settings.mobile_image",
      "info": "t:sections.about.settings.mobile_image_info"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.about.settings.image_alt",
      "info": "t:sections.about.settings.image_alt_info"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.about.settings.image_ratio",
      "options": [
        { "value": "portrait", "label": "t:sections.blog.settings.ratio_portrait" },
        { "value": "square", "label": "t:sections.blog.settings.ratio_square" },
        { "value": "landscape", "label": "t:sections.blog.settings.ratio_landscape" },
        { "value": "wide", "label": "t:sections.blog.settings.ratio_wide" },
        { "value": "adapt", "label": "t:sections.about.settings.ratio_adapt" }
      ],
      "default": "landscape"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:labels.section_spacing"
    },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "small", "label": "t:options.size.small" },
        { "value": "medium", "label": "t:options.size.medium" },
        { "value": "large", "label": "t:options.size.large" }
      ],
      "default": "large"
    }
  ],
  "presets": [
    {
      "name": "t:general.about_hero"
    }
  ]
}
{% endschema %}
