{% liquid
  assign columns = section.settings.columns | default: 'auto'
  assign alignment = section.settings.alignment | default: 'center'
  assign icon_position = section.settings.icon_position | default: 'top'
  assign icon_size = section.settings.icon_size | default: 20
  assign section_spacing = section.settings.section_spacing | default: 'medium'
  assign show_dividers = false
  if section.settings.show_dividers
    assign show_dividers = true
  endif

  assign visible_count = 0
  for block in section.blocks
    if block.type == 'benefit'
      assign benefit_heading = block.settings.heading | strip
      assign benefit_description = block.settings.description | strip
      assign benefit_icon = block.settings.icon
      assign benefit_link = block.settings.link
      assign benefit_link_label = block.settings.link_label | strip
      assign has_content = false
      if benefit_heading != blank
        assign has_content = true
      endif
      if benefit_description != blank
        assign has_content = true
      endif
      if benefit_icon != blank
        assign has_content = true
      endif
      if benefit_link != blank
        if benefit_link_label != blank
          assign has_content = true
        endif
      endif
      if has_content
        assign visible_count = visible_count | plus: 1
      endif
    endif
  endfor

  assign grid_cols = 4
  if columns == 'auto'
    if visible_count <= 1
      assign grid_cols = 1
    elsif visible_count == 2
      assign grid_cols = 2
    elsif visible_count == 3
      assign grid_cols = 3
    elsif visible_count == 4
      assign grid_cols = 4
    else
      assign grid_cols = 3
    endif
  else
    assign grid_cols = columns | plus: 0
    if visible_count > 0
      if visible_count < grid_cols
        assign grid_cols = visible_count
      endif
    endif
  endif

  assign item_index = 0
  assign link_fallback = 'sections.benefits.link_fallback' | t
%}

<section
  id="Benefits-{{ section.id }}"
  class="
    cosme-benefits
    full-width
    color-{{ section.settings.color_scheme }}
    cosme-benefits--cols-{{ grid_cols }}
    cosme-benefits--count-{{ visible_count }}
    cosme-benefits--align-{{ alignment }}
    cosme-benefits--icon-{{ icon_position }}
    cosme-benefits--spacing-{{ section_spacing }}
    {% if show_dividers %}cosme-benefits--dividers{% endif %}
    {% if settings.enable_animations %}cosme-benefits--animated{% endif %}
  "
  style="
    --benefits-icon-size: {{ icon_size }}px;
    --benefits-cols: {{ grid_cols }};
  "
  aria-label="{{ 'sections.benefits.landmark_label' | t }}"
  {{ section.shopify_attributes }}
>
  {% if visible_count > 0 %}
    <div class="cosme-benefits__inner">
      <ul class="cosme-benefits__list">
        {% for block in section.blocks %}
          {% if block.type == 'benefit' %}
            {% liquid
              assign benefit_heading = block.settings.heading | strip
              assign benefit_description = block.settings.description | strip
              assign benefit_icon = block.settings.icon
              assign benefit_link = block.settings.link
              assign benefit_link_label = block.settings.link_label | strip
              assign has_content = false
              assign has_copy = false
              assign link_aria = ''

              if benefit_heading != blank
                assign has_content = true
                assign has_copy = true
              endif
              if benefit_description != blank
                assign has_content = true
                assign has_copy = true
              endif
              if benefit_icon != blank
                assign has_content = true
              endif
              if benefit_link != blank
                if benefit_link_label != blank
                  assign has_content = true
                  assign has_copy = true
                endif
              endif

              if benefit_link != blank
                if benefit_heading == blank
                  if benefit_description == blank
                    if benefit_link_label == blank
                      assign link_aria = link_fallback
                    endif
                  endif
                endif
              endif
            %}

            {% if has_content %}
              {% liquid
                assign item_index = item_index | plus: 1
                assign item_delay = item_index | minus: 1 | times: 40
              %}
              <li
                class="cosme-benefits__item"
                style="--benefits-delay: {{ item_delay }}ms;"
                {{ block.shopify_attributes }}
              >
                {% if benefit_link != blank %}
                  <a
                    class="cosme-benefits__content"
                    href="{{ benefit_link }}"
                    {% if link_aria != blank %}
                      aria-label="{{ link_aria | escape }}"
                    {% endif %}
                  >
                    {% if benefit_icon != blank %}
                      <span class="cosme-benefits__icon">
                        {% render 'cosme-icon', icon: benefit_icon, size: 'lg' %}
                      </span>
                    {% endif %}
                    {% if has_copy %}
                      <div class="cosme-benefits__copy">
                        {% if benefit_heading != blank %}
                          <p class="cosme-benefits__heading">{{ benefit_heading | escape }}</p>
                        {% endif %}
                        {% if benefit_description != blank %}
                          <p class="cosme-benefits__description">{{ benefit_description | escape }}</p>
                        {% endif %}
                        {% if benefit_link_label != blank %}
                          <p class="cosme-benefits__link-label">{{ benefit_link_label | escape }}</p>
                        {% endif %}
                      </div>
                    {% endif %}
                  </a>
                {% else %}
                  <div class="cosme-benefits__content">
                    {% if benefit_icon != blank %}
                      <span class="cosme-benefits__icon">
                        {% render 'cosme-icon', icon: benefit_icon, size: 'lg' %}
                      </span>
                    {% endif %}
                    {% if has_copy %}
                      <div class="cosme-benefits__copy">
                        {% if benefit_heading != blank %}
                          <p class="cosme-benefits__heading">{{ benefit_heading | escape }}</p>
                        {% endif %}
                        {% if benefit_description != blank %}
                          <p class="cosme-benefits__description">{{ benefit_description | escape }}</p>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              </li>
            {% endif %}
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .cosme-benefits {
    background-color: var(--color-background);
    color: var(--color-foreground);
    overflow-x: hidden;
    max-width: 100%;
  }

  .cosme-benefits__inner {
    width: 100%;
    max-width: var(--page-width);
    min-width: 0;
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .cosme-benefits--spacing-small .cosme-benefits__inner {
    padding-block: calc(var(--spacing-section) * 0.38);
  }

  .cosme-benefits--spacing-medium .cosme-benefits__inner {
    padding-block: clamp(1.75rem, 4.5vw, calc(var(--spacing-section) * 0.65));
  }

  .cosme-benefits--spacing-large .cosme-benefits__inner {
    padding-block: clamp(2.5rem, 6.5vw, calc(var(--spacing-section) * 0.95));
  }

  .cosme-benefits__list {
    --benefits-col-gap: clamp(1rem, 3.2vw, 2.75rem);

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    column-gap: var(--benefits-col-gap);
    row-gap: var(--spacing-md);
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cosme-benefits--count-1 .cosme-benefits__list {
    grid-template-columns: minmax(0, 1fr);
  }

  .cosme-benefits__item {
    position: relative;
    min-width: 0;
    max-width: 100%;
  }

  .cosme-benefits__content {
    display: flex;
    gap: 0.625rem;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    color: inherit;
    text-decoration: none;
  }

  a.cosme-benefits__content:hover .cosme-benefits__heading {
    color: var(--color-accent);
  }

  a.cosme-benefits__content:hover .cosme-benefits__link-label {
    text-decoration-color: var(--color-accent);
  }

  a.cosme-benefits__content:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-accent);
    outline-offset: 6px;
  }

  .cosme-benefits--icon-top .cosme-benefits__content {
    flex-direction: column;
    align-items: flex-start;
  }

  .cosme-benefits--icon-left .cosme-benefits__content {
    flex-direction: row;
    align-items: flex-start;
  }

  .cosme-benefits--align-left .cosme-benefits__content {
    text-align: start;
  }

  .cosme-benefits--align-center.cosme-benefits--icon-top .cosme-benefits__content {
    align-items: center;
    text-align: center;
  }

  .cosme-benefits--align-center.cosme-benefits--icon-left .cosme-benefits__content {
    justify-content: center;
    text-align: start;
  }

  .cosme-benefits--align-center.cosme-benefits--icon-left .cosme-benefits__icon {
    margin-block-start: 0.12em;
  }

  .cosme-benefits__icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--color-heading);
  }

  .cosme-benefits__icon .cosme-icon {
    width: var(--benefits-icon-size, 1.25rem);
    height: var(--benefits-icon-size, 1.25rem);
  }

  .cosme-benefits__copy {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    min-width: 0;
  }

  .cosme-benefits--align-center.cosme-benefits--icon-top .cosme-benefits__copy {
    align-items: center;
  }

  .cosme-benefits__heading,
  .cosme-benefits__description,
  .cosme-benefits__link-label {
    margin: 0;
    max-width: 100%;
  }

  .cosme-benefits__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: 0.9375rem;
    line-height: 1.3;
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-heading);
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .cosme-benefits__description,
  .cosme-benefits__link-label {
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: var(--font-body--weight);
    line-height: 1.45;
    color: var(--color-muted);
    overflow-wrap: break-word;
  }

  .cosme-benefits__link-label {
    color: var(--color-foreground);
    text-underline-offset: 0.18em;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-border) 80%, var(--color-foreground));
  }

  .cosme-benefits--dividers .cosme-benefits__item::after {
    content: '';
    position: absolute;
    top: 14%;
    bottom: 14%;
    inset-inline-end: calc(var(--benefits-col-gap, 1.5rem) / -2);
    width: 1px;
    background-color: var(--color-border);
    pointer-events: none;
  }

  .cosme-benefits--dividers .cosme-benefits__item:last-child::after,
  .cosme-benefits--dividers .cosme-benefits__item:nth-child(2n)::after {
    content: none;
  }

  .cosme-benefits--animated .cosme-benefits__item {
    animation: cosme-benefits-reveal var(--animation-duration) var(--transition-easing) both;
    animation-delay: var(--benefits-delay, 0ms);
  }

  @keyframes cosme-benefits-reveal {
    from {
      opacity: 0;
      transform: translateY(0.35rem);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cosme-benefits--animated .cosme-benefits__item {
      animation: none;
    }
  }

  @media (max-width: 749px) {
    .cosme-benefits--spacing-medium .cosme-benefits__inner,
    .cosme-benefits--spacing-large .cosme-benefits__inner {
      padding-block: var(--spacing-lg);
    }

    .cosme-benefits__list {
      --benefits-col-gap: var(--spacing-md);

      row-gap: var(--spacing-md);
    }

    .cosme-benefits--icon-left .cosme-benefits__content {
      gap: 0.5rem;
    }

    .cosme-benefits__heading {
      font-size: 0.875rem;
    }

    .cosme-benefits__description,
    .cosme-benefits__link-label {
      font-size: 0.75rem;
    }
  }

  @media (min-width: 750px) {
    .cosme-benefits__list {
      row-gap: var(--spacing-lg);
    }
  }

  @media (min-width: 990px) {
    .cosme-benefits__list {
      grid-template-columns: repeat(var(--benefits-cols, 4), minmax(0, 1fr));
    }

    .cosme-benefits--cols-1 .cosme-benefits__list {
      grid-template-columns: minmax(0, 22rem);
      justify-content: center;
    }

    .cosme-benefits--icon-top .cosme-benefits__content {
      gap: 0.75rem;
    }

    .cosme-benefits--icon-left .cosme-benefits__content {
      gap: 0.75rem;
    }

    .cosme-benefits--dividers .cosme-benefits__item:nth-child(2n)::after {
      content: '';
    }

    .cosme-benefits--dividers .cosme-benefits__item:last-child::after,
    .cosme-benefits--cols-2.cosme-benefits--dividers .cosme-benefits__item:nth-child(2n)::after,
    .cosme-benefits--cols-3.cosme-benefits--dividers .cosme-benefits__item:nth-child(3n)::after,
    .cosme-benefits--cols-4.cosme-benefits--dividers .cosme-benefits__item:nth-child(4n)::after {
      content: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.benefits.name",
  "tag": "div",
  "class": "section-benefits",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.benefits.settings.columns",
      "info": "t:sections.benefits.settings.columns_info",
      "options": [
        {
          "value": "auto",
          "label": "t:sections.benefits.settings.columns_auto"
        },
        {
          "value": "2",
          "label": "t:sections.benefits.settings.columns_2"
        },
        {
          "value": "3",
          "label": "t:sections.benefits.settings.columns_3"
        },
        {
          "value": "4",
          "label": "t:sections.benefits.settings.columns_4"
        }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "t:sections.benefits.settings.show_dividers",
      "default": true
    },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "t:labels.section_spacing",
      "options": [
        {
          "value": "small",
          "label": "t:options.size.small"
        },
        {
          "value": "medium",
          "label": "t:options.size.medium"
        },
        {
          "value": "large",
          "label": "t:options.size.large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "t:sections.benefits.settings.icon_header"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "t:sections.benefits.settings.icon_size",
      "min": 16,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "t:sections.benefits.settings.icon_position",
      "options": [
        {
          "value": "top",
          "label": "t:sections.benefits.settings.icon_position_top"
        },
        {
          "value": "left",
          "label": "t:sections.benefits.settings.icon_position_left"
        }
      ],
      "default": "top"
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "t:sections.benefits.blocks.benefit.name",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "options": [
            {
              "value": "",
              "label": "t:options.none"
            },
            {
              "value": "shipping",
              "label": "t:sections.benefits.blocks.benefit.icon_shipping"
            },
            {
              "value": "return",
              "label": "t:sections.benefits.blocks.benefit.icon_return"
            },
            {
              "value": "secure",
              "label": "t:sections.benefits.blocks.benefit.icon_secure"
            },
            {
              "value": "support",
              "label": "t:sections.benefits.blocks.benefit.icon_support"
            },
            {
              "value": "gift",
              "label": "t:sections.benefits.blocks.benefit.icon_gift"
            },
            {
              "value": "star",
              "label": "t:sections.benefits.blocks.benefit.icon_star"
            },
            {
              "value": "discount",
              "label": "t:sections.benefits.blocks.benefit.icon_discount"
            }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Free shipping"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:sections.benefits.blocks.benefit.description",
          "default": "On orders over $75"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link",
          "info": "t:sections.benefits.blocks.benefit.link_info"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:labels.link_label",
          "info": "t:sections.benefits.blocks.benefit.link_label_info",
          "visible_if": "{{ block.settings.link != blank }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.benefits.name",
      "settings": {
        "columns": "auto",
        "alignment": "center",
        "show_dividers": true,
        "section_spacing": "medium",
        "icon_size": 20,
        "icon_position": "top",
        "color_scheme": "scheme-1"
      },
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "shipping",
            "heading": "Free shipping",
            "description": "On orders over $75"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "return",
            "heading": "Easy returns",
            "description": "30-day hassle-free returns"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "secure",
            "heading": "Secure checkout",
            "description": "Safe and secure payments"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "support",
            "heading": "Customer care",
            "description": "We're here whenever you need us"
          }
        }
      ]
    }
  ]
}
{% endschema %}
