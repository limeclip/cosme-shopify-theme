{% liquid
  assign heading_id = 'AboutCtaHeading-' | append: section.id

  assign eyebrow = section.settings.eyebrow | strip
  assign heading = section.settings.heading | strip
  assign description = section.settings.description | strip
  assign primary_label = section.settings.primary_label | strip
  assign primary_link = section.settings.primary_link
  assign secondary_label = section.settings.secondary_label | strip
  assign secondary_link = section.settings.secondary_link

  assign alignment = section.settings.alignment | default: 'left'
  assign section_spacing = section.settings.section_spacing | default: 'large'

  assign section_enabled = false
  if section.settings.enable
    assign section_enabled = true
  endif

  if heading == blank
    assign heading = 'sections.about_cta.heading_fallback' | t
  endif

  if primary_link == blank
    assign primary_link = routes.collections_url
  endif

  assign show_primary = false
  if primary_label != blank
    if primary_link != blank
      assign show_primary = true
    endif
  endif

  assign show_secondary = false
  if section.settings.show_secondary_cta
    if secondary_label != blank
      if secondary_link != blank
        assign show_secondary = true
      endif
    endif
  endif

  assign has_actions = false
  if show_primary
    assign has_actions = true
  endif
  if show_secondary
    assign has_actions = true
  endif

  assign render_section = false
  if section_enabled
    assign render_section = true
  endif

  assign show_disabled_notice = false
  if section_enabled == false
    if request.design_mode
      assign show_disabled_notice = true
    endif
  endif
%}

{% if render_section %}
  <section
    id="AboutCta-{{ section.id }}"
    class="
      cosme-about-cta
      full-width
      color-{{ section.settings.color_scheme }}
      cosme-about-cta--align-{{ alignment }}
      cosme-about-cta--spacing-{{ section_spacing }}
      {% if settings.enable_animations %}cosme-about-cta--animated{% endif %}
    "
    aria-labelledby="{{ heading_id }}"
    {{ section.shopify_attributes }}
  >
    <div class="cosme-about-cta__inner">
      <div class="cosme-about-cta__copy">
        <div class="cosme-about-cta__rule" aria-hidden="true"></div>

        {% if eyebrow != blank %}
          <p class="cosme-about-cta__eyebrow">{{ eyebrow | escape }}</p>
        {% endif %}

        <h2 class="cosme-about-cta__heading" id="{{ heading_id }}">
          {{ heading | escape }}
        </h2>

        {% if description != blank %}
          <p class="cosme-about-cta__description">
            {{ description | escape | newline_to_br }}
          </p>
        {% endif %}

        {% if has_actions %}
          <div class="cosme-about-cta__actions">
            {% if show_primary %}
              {% render 'cosme-button',
                label: primary_label,
                url: primary_link,
                style: 'primary',
                class: 'cosme-about-cta__primary'
              %}
            {% endif %}

            {% if show_secondary %}
              {% render 'cosme-button',
                label: secondary_label,
                url: secondary_link,
                style: 'tertiary',
                class: 'cosme-about-cta__secondary'
              %}
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{% elsif show_disabled_notice %}
  <section
    id="AboutCta-{{ section.id }}"
    class="
      cosme-about-cta
      cosme-about-cta--disabled
      full-width
      color-{{ section.settings.color_scheme }}
      cosme-about-cta--spacing-small
    "
    aria-label="{{ 'sections.about_cta.landmark_label' | t }}"
    {{ section.shopify_attributes }}
  >
    <div class="cosme-about-cta__inner">
      <p class="cosme-about-cta__notice">
        {{ 'sections.about_cta.disabled_notice' | t }}
      </p>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .cosme-about-cta {
    overflow-x: clip;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .cosme-about-cta__inner {
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .cosme-about-cta--spacing-small .cosme-about-cta__inner {
    padding-block: clamp(3rem, 8vw, 5.5rem);
  }

  .cosme-about-cta--spacing-medium .cosme-about-cta__inner {
    padding-block: clamp(4rem, 10vw, 7.5rem);
  }

  .cosme-about-cta--spacing-large .cosme-about-cta__inner {
    padding-block: clamp(5rem, 12vw, 9.5rem);
  }

  .cosme-about-cta__copy {
    max-width: 40rem;
    min-width: 0;
  }

  .cosme-about-cta--align-center .cosme-about-cta__copy {
    margin-inline: auto;
    text-align: center;
  }

  .cosme-about-cta--align-right .cosme-about-cta__copy {
    margin-inline-start: auto;
    text-align: right;
  }

  .cosme-about-cta__rule {
    width: 2.5rem;
    height: 1px;
    margin-block: 0 var(--spacing-lg);
    background-color: var(--color-border, currentColor);
  }

  .cosme-about-cta--align-center .cosme-about-cta__rule {
    margin-inline: auto;
  }

  .cosme-about-cta--align-right .cosme-about-cta__rule {
    margin-inline-start: auto;
  }

  .cosme-about-cta__eyebrow {
    margin: 0 0 var(--spacing-md);
    font-size: 0.6875rem;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-about-cta__heading {
    margin: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-heading--family);
    font-size: clamp(2.25rem, 7vw, 4.25rem);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    line-height: 1.08;
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-heading, var(--color-foreground));
  }

  .cosme-about-cta__description {
    max-width: 32rem;
    margin: var(--spacing-lg) 0 0;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }

  .cosme-about-cta--align-center .cosme-about-cta__description {
    margin-inline: auto;
  }

  .cosme-about-cta--align-right .cosme-about-cta__description {
    margin-inline-start: auto;
  }

  .cosme-about-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-md) var(--spacing-lg);
    margin-block-start: clamp(1.75rem, 4vw, 2.5rem);
  }

  .cosme-about-cta--align-center .cosme-about-cta__actions {
    justify-content: center;
  }

  .cosme-about-cta--align-right .cosme-about-cta__actions {
    justify-content: flex-end;
  }

  .cosme-about-cta__primary,
  .cosme-about-cta__secondary {
    max-width: 100%;
    overflow-wrap: anywhere;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .cosme-about-cta__notice {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media screen and (min-width: 750px) {
    .cosme-about-cta__description {
      font-size: 1.125rem;
    }
  }

  @media screen and (min-width: 990px) {
    .cosme-about-cta--spacing-large .cosme-about-cta__inner {
      padding-block: clamp(6rem, 11vw, 10.5rem);
    }

    .cosme-about-cta__copy {
      max-width: 46rem;
    }

    .cosme-about-cta__heading {
      font-size: clamp(3rem, 5.4vw, 5rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .cosme-about-cta--animated .cosme-about-cta__copy {
      animation: cosme-about-cta-enter 0.85s var(--transition-easing, ease) both;
    }
  }

  @keyframes cosme-about-cta-enter {
    from {
      opacity: 0;
      transform: translateY(0.6rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.about_cta",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "t:sections.about_cta.settings.enable",
      "info": "t:sections.about_cta.settings.enable_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.about_cta.settings.eyebrow",
      "default": "DISCOVER COSME"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.about_cta.settings.heading",
      "default": "Make beauty part of your ritual."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.about_cta.settings.description",
      "default": "Explore our considered collection of skincare and beauty essentials."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.about_cta.settings.alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:general.actions"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:sections.about_cta.settings.primary_label",
      "default": "SHOP ALL"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "t:sections.about_cta.settings.primary_link"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_cta",
      "label": "t:sections.about_cta.settings.show_secondary_cta",
      "default": true
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:sections.about_cta.settings.secondary_label",
      "default": "READ THE JOURNAL",
      "visible_if": "{{ section.settings.show_secondary_cta }}"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:sections.about_cta.settings.secondary_link",
      "visible_if": "{{ section.settings.show_secondary_cta }}"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:labels.section_spacing"
    },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "small", "label": "t:options.size.small" },
        { "value": "medium", "label": "t:options.size.medium" },
        { "value": "large", "label": "t:options.size.large" }
      ],
      "default": "large"
    }
  ],
  "presets": [
    {
      "name": "t:general.about_cta"
    }
  ]
}
{% endschema %}
