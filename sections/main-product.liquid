{% javascript %}
  (function () {
    if (window._cosmeMainProduct) return;
    window._cosmeMainProduct = true;

    const stringsFrom = (section) => ({
      adding: section?.dataset.stringAdding || 'Adding…',
      added: section?.dataset.stringAdded || 'Added to cart',
      error: section?.dataset.stringError || 'Unable to add to cart. Please try again.',
      copied: section?.dataset.stringCopied || 'Link copied',
      copyFailed: section?.dataset.stringCopyFailed || 'Unable to copy link',
    });

    const parseHtml = (text) => new DOMParser().parseFromString(text, 'text/html');

    const clampQuantity = (input, nextValue) => {
      const min = Number(input.min || 1);
      const max = input.max ? Number(input.max) : Number.POSITIVE_INFINITY;
      return Math.min(max, Math.max(min, nextValue));
    };

    const refreshPaymentButton = () => {
      if (window.Shopify && Shopify.PaymentButton && typeof Shopify.PaymentButton.init === 'function') {
        Shopify.PaymentButton.init();
      }
    };

    const replaceProductRoot = (section, html, focusId) => {
      const doc = parseHtml(html);
      const incoming = doc.querySelector('[data-product-root]');
      const current = section.querySelector('[data-product-root]');
      if (!incoming || !current) return;

      const quantityInput = current.querySelector('[data-quantity-input]');
      const quantity = quantityInput ? quantityInput.value : '1';

      current.replaceWith(incoming);

      const nextQuantity = incoming.querySelector('[data-quantity-input]');
      if (nextQuantity) nextQuantity.value = clampQuantity(nextQuantity, Number(quantity) || 1);

      const incomingSticky = doc.querySelector('[data-sticky-atc-inner]');
      const currentSticky = section.querySelector('[data-sticky-atc-inner]');
      if (incomingSticky && currentSticky) currentSticky.replaceWith(incomingSticky);

      refreshPaymentButton();
      section.dispatchEvent(new CustomEvent('cosme:product-updated', { bubbles: true }));

      if (focusId) {
        const focusTarget = incoming.querySelector(`#${CSS.escape(focusId)}`);
        if (focusTarget) focusTarget.focus();
      }
    };

    const updateVariant = async (section, optionInput) => {
  const selected = Array.from(section.querySelectorAll('[data-option-value-id]:checked'))
    .map((input) => input.dataset.optionValueId)
    .filter(Boolean);

  const productUrl = optionInput.dataset.productUrl || section.dataset.productUrl || window.location.pathname;
  const url = new URL(productUrl, window.location.origin);
  url.searchParams.set('section_id', section.dataset.sectionId);
  if (selected.length) url.searchParams.set('option_values', selected.join(','));

  const response = await fetch(url.toString());
  if (!response.ok) return;

  const html = await response.text();

  // Если изменение пришло из sticky — не фокусируемся
  const focusId = window._cosmeVariantFromSticky ? null : optionInput.id;
  replaceProductRoot(section, html, focusId);
  window._cosmeVariantFromSticky = false;

  const variantInput = section.querySelector('[data-product-variant-id]');
  const historyUrl = new URL(window.location.href);
  if (variantInput && variantInput.value) {
    historyUrl.searchParams.set('variant', variantInput.value);
  } else {
    historyUrl.searchParams.delete('variant');
  }
  window.history.replaceState({}, '', historyUrl.toString());
};
    const desktopGalleryQuery = window.matchMedia('(min-width: 768px)');

    const syncStickyGallery = (section) => {
      const media = section.querySelector('[data-product-media]');
      const info = section.querySelector('[data-product-info]');
      if (!media || !info) return;

      const offsetRaw = getComputedStyle(document.documentElement).getPropertyValue('--header-sticky-offset').trim();
      const offset = Number.parseFloat(offsetRaw) || 0;
      const available = window.innerHeight - offset;
      const shouldStick =
        desktopGalleryQuery.matches &&
        info.offsetHeight > media.offsetHeight &&
        info.offsetHeight > window.innerHeight &&
        media.offsetHeight <= available;

      media.classList.toggle('is-sticky', shouldStick);
    };

    const observeStickyGallery = (section) => {
      const media = section.querySelector('[data-product-media]');
      const info = section.querySelector('[data-product-info]');
      if (!media || !info) return;

      section._galleryStickyResize?.disconnect();
      section._galleryStickyIO?.disconnect();

      const run = () => syncStickyGallery(section);
      const resizeObserver = new ResizeObserver(run);
      resizeObserver.observe(info);
      resizeObserver.observe(media);
      section._galleryStickyResize = resizeObserver;

      const intersectionObserver = new IntersectionObserver(run, { threshold: [0, 1] });
      intersectionObserver.observe(info);
      section._galleryStickyIO = intersectionObserver;

      if (!section._galleryStickyToggleBound) {
        section.addEventListener(
          'toggle',
          (event) => {
            if (event.target.closest('[data-product-info]')) syncStickyGallery(section);
          },
          true
        );
        section._galleryStickyToggleBound = true;
      }

      run();
    };

    const addToCart = async (form, submitButton) => {
      const section = form.closest('[data-main-product]');
      const strings = stringsFrom(section);
      const statuses = [
        form.querySelector('[data-product-form-status]'),
        section?.querySelector('[data-sticky-atc-status]'),
      ].filter(Boolean);
      const buttons = Array.from(
        new Set(
          [
            submitButton,
            form.querySelector('.cosme-product-form__submit'),
            section?.querySelector('.cosme-sticky-atc__submit'),
          ].filter(Boolean)
        )
      );
      const originalLabels = buttons.map((button) => button.textContent);
      const originalDisabled = buttons.map((button) => button.disabled);
      const variantInput = form.querySelector('[data-product-variant-id]');
      const quantityInput = form.querySelector('[data-quantity-input]');

      if (!variantInput || !variantInput.value || submitButton.disabled) return;

      buttons.forEach((button) => {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        button.textContent = strings.adding;
      });
      statuses.forEach((status) => {
        status.textContent = '';
        status.classList.remove('is-error');
      });

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            id: Number(variantInput.value),
            quantity: Number(quantityInput?.value || 1),
          }),
        });

        if (!response.ok) {
          const payload = await response.json().catch(() => ({}));
          throw new Error(payload.description || strings.error);
        }

        document.dispatchEvent(new CustomEvent('cart:refresh'));

        const cartToggle = document.querySelector('[data-header-cart-toggle]');
        if (cartToggle) {
          cartToggle.click();
        }

        statuses.forEach((status) => {
          status.textContent = strings.added;
        });
      } catch (error) {
        statuses.forEach((status) => {
          status.textContent = error.message || strings.error;
          status.classList.add('is-error');
        });
      } finally {
        buttons.forEach((button, index) => {
          button.disabled = originalDisabled[index];
          button.removeAttribute('aria-busy');
          button.textContent = originalLabels[index];
        });
      }
    };

    const shareProduct = async (button) => {
      const section = button.closest('[data-main-product]');
      const strings = stringsFrom(section);
      const url = button.dataset.shareUrl || window.location.href;
      const title = button.dataset.shareTitle || document.title;
      const status = button.parentElement?.querySelector('[data-share-status]');

      try {
        if (navigator.share) {
          await navigator.share({ title, url });
          return;
        }

        await navigator.clipboard.writeText(url);
        if (status) status.textContent = strings.copied;
      } catch (error) {
        if (error && error.name === 'AbortError') return;
        if (status) status.textContent = strings.copyFailed;
      }
    };

    document.addEventListener('change', (event) => {
      const quantityInput = event.target.closest('[data-quantity-input]');
      if (quantityInput) {
        quantityInput.value = clampQuantity(quantityInput, Number(quantityInput.value || 1));
        return;
      }

      const optionInput = event.target.closest('[data-option-value-id]');
      const section = event.target.closest('[data-main-product]');
      if (!optionInput || !section) return;
      updateVariant(section, optionInput);
    });

    document.addEventListener('click', (event) => {
      const decrease = event.target.closest('[data-quantity-decrease]');
      const increase = event.target.closest('[data-quantity-increase]');
      if (decrease || increase) {
        const form = event.target.closest('[data-product-form]');
        const input = form?.querySelector('[data-quantity-input]');
        if (!input) return;
        const delta = decrease ? -1 : 1;
        input.value = clampQuantity(input, Number(input.value || 1) + delta);
        return;
      }

      const shareButton = event.target.closest('[data-product-share]');
      if (shareButton) shareProduct(shareButton);
    });

    document.addEventListener('submit', (event) => {
      const form = event.target.closest('[data-product-form]');
      if (!form) return;

      const submitter = event.submitter;
      const isAddToCart =
        !submitter || submitter.name === 'add' || submitter.classList.contains('cosme-product-form__submit');
      if (!isAddToCart) return;

      event.preventDefault();
      const submitButton =
        (submitter && submitter.name === 'add' && submitter) ||
        form.querySelector('[name="add"], .cosme-product-form__submit');
      if (submitButton) addToCart(form, submitButton);
    });

    document.querySelectorAll('[data-main-product]').forEach(observeStickyGallery);

    document.addEventListener('cosme:product-updated', (event) => {
      const section = event.target.closest('[data-main-product]') || event.target;
      if (section?.matches?.('[data-main-product]')) observeStickyGallery(section);
    });

    document.addEventListener('shopify:section:load', (event) => {
      const section = event.target.querySelector('[data-main-product]');
      if (section) observeStickyGallery(section);
    });

    desktopGalleryQuery.addEventListener('change', () => {
      document.querySelectorAll('[data-main-product]').forEach(observeStickyGallery);
    });

    window.addEventListener('resize', () => {
      document.querySelectorAll('[data-main-product]').forEach(syncStickyGallery);
    });
  })();
  document.addEventListener('click', function (e) {
  const link = e.target.closest('.cosme-main-product__rating-link');
  if (!link) return;
  const href = link.getAttribute('href');
  if (!href || !href.startsWith('#')) return;
  e.preventDefault();

  const tabsContainer = document.querySelector('.cosme-product-tabs');
  if (!tabsContainer) return;

  // Ищем кнопку вкладки Reviews
  const reviewTabButton = tabsContainer.querySelector('[data-product-tab][aria-controls="ProductReviews"]');
  if (reviewTabButton) {
    reviewTabButton.click(); // эмулируем клик
  }

  tabsContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
});
{% endjavascript %}

