{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = product.featured_media

  if current_variant
    if current_variant.featured_media
      assign featured_media = current_variant.featured_media
    endif
  endif

  assign product_form_id = 'ProductForm-' | append: section.id
  assign button_style = section.settings.button_style | default: 'primary'
  assign info_align = section.settings.info_alignment | default: 'left'
  assign gallery_width = section.settings.gallery_width | default: 58
  assign gallery_spacing = section.settings.gallery_spacing | default: 48
  assign image_spacing = section.settings.image_spacing | default: 12
  assign content_width = section.settings.content_width | default: 'page'
  assign info_width = section.settings.info_width | default: 440

  assign product_available = product.available
  if current_variant
    assign product_available = current_variant.available
  endif

  assign atc_label = 'products.add_to_cart_button' | t
  assign atc_disabled = false
  if current_variant == blank
    assign atc_disabled = true
    assign atc_label = 'products.unavailable' | t
  elsif product_available == false
    assign atc_disabled = true
    assign atc_label = 'products.badge.sold_out' | t
  endif

  assign max_quantity = false
  if current_variant
    if current_variant.inventory_management != blank
      if current_variant.inventory_policy == 'deny'
        if current_variant.inventory_quantity > 0
          assign max_quantity = current_variant.inventory_quantity
        else
          assign max_quantity = 1
        endif
      endif
    endif
  endif

  assign variant_id = ''
  if current_variant
    assign variant_id = current_variant.id
  endif
%}

<section
  id="MainProduct-{{ section.id }}"
  class="cosme-main-product full-width color-{{ section.settings.color_scheme }} cosme-main-product--align-{{ info_align }} cosme-main-product--width-{{ content_width }}"
  style="
    --product-media-width: {{ gallery_width }}%;
    --product-info-width: {{ info_width }}px;
    --product-gallery-gap: {{ gallery_spacing }}px;
    --product-image-gap: {{ image_spacing }}px;
  "
  data-main-product
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  data-product-title="{{ product.title | escape }}"
  data-string-adding="{{ 'products.add_to_cart_adding' | t }}"
  data-string-added="{{ 'products.add_to_cart_added' | t }}"
  data-string-error="{{ 'products.add_to_cart_error' | t }}"
  data-string-copied="{{ 'products.share.copied' | t }}"
  data-string-copy-failed="{{ 'products.share.copy_failed' | t }}"
  data-cart-type="{{ settings.cart_type }}"
  aria-label="{{ product.title | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="cosme-main-product__inner" data-product-root>
    <div class="cosme-main-product__media" data-product-media>
      {% render 'cosme-product-gallery',
        product: product,
        featured_media: featured_media,
        sizes: '(min-width: 990px) 50vw, 100vw',
        layout: section.settings.gallery_layout,
        thumbnail_position: section.settings.thumbnail_position,
        aspect: section.settings.image_aspect,
        fit: section.settings.image_fit,
        focal: section.settings.image_focal,
        show_thumbnails: section.settings.show_thumbnails,
        show_arrows: section.settings.show_arrows,
        show_media_count: section.settings.show_media_count,
        enable_zoom: section.settings.enable_zoom,
        enable_lightbox: section.settings.enable_lightbox,
        enable_video_controls: section.settings.enable_video_controls
      %}
    </div>

    <div class="cosme-main-product__info" data-product-info>
      {% liquid
        assign accordion_icon = section.settings.accordion_icon_style | default: 'plus_minus'
        assign accordion_first_opened = false
      %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'vendor' %}
            {% if product.vendor != blank %}
              <p class="cosme-main-product__vendor" {{ block.shopify_attributes }}>{{ product.vendor | escape }}</p>
            {% endif %}

          {% when 'title' %}
            {% liquid
              assign heading_tag = block.settings.heading_tag | default: 'h1'
              if heading_tag != 'h1'
                if heading_tag != 'h2'
                  assign heading_tag = 'h1'
                endif
              endif
            %}
            <{{ heading_tag }} class="cosme-main-product__title" {{ block.shopify_attributes }}>
              {{- product.title | escape -}}
            </{{ heading_tag }}>

          {% when 'rating' %}
            {% liquid
              assign rating_number = 0
              assign rating_count = 0
              assign has_rating = false
              assign rating_metafield = product.metafields.reviews.rating.value
              assign rating_count_metafield = product.metafields.reviews.rating_count.value

              if rating_count_metafield != blank
                assign rating_count = rating_count_metafield | plus: 0
              endif

              if rating_metafield.rating
                assign rating_number = rating_metafield.rating | plus: 0
              elsif rating_metafield != blank
                assign rating_number = rating_metafield | plus: 0
              endif

              if rating_number > 0
                assign has_rating = true
              endif
              if rating_count > 0
                assign has_rating = true
              endif
            %}
            {% if has_rating %}
              {% liquid
                assign rating_display = rating_number | round: 1
              %}
              <div class="cosme-main-product__rating" {{ block.shopify_attributes }}>
                {% if block.settings.reviews_link != blank %}
                  <a class="cosme-main-product__rating-link" href="{{ block.settings.reviews_link }}">
                {% endif %}
                <span class="cosme-visually-hidden">
                  {{ 'products.rating.summary' | t: rating: rating_display, count: rating_count }}
                </span>
                <span class="cosme-main-product__stars" aria-hidden="true">
                  {% for i in (1..5) %}
                    {% liquid
                      assign star_floor = i | minus: 1
                      assign star_fill = 0
                      if rating_number >= i
                        assign star_fill = 100
                      else
                        if rating_number > star_floor
                          assign star_fill = rating_number | minus: star_floor | times: 100
                        endif
                      endif
                    %}
                    <span class="cosme-main-product__star" style="--star-fill: {{ star_fill }}%;">
                      <span class="cosme-main-product__star-base">
                        {% render 'cosme-icon', icon: 'star', size: 'sm' %}
                      </span>
                      <span class="cosme-main-product__star-fill">
                        {% render 'cosme-icon', icon: 'star', size: 'sm' %}
                      </span>
                    </span>
                  {% endfor %}
                </span>
                <span class="cosme-main-product__rating-text" aria-hidden="true">
                  {% if rating_count > 0 %}
                    {{ 'products.rating.count' | t: rating: rating_display, count: rating_count }}
                  {% else %}
                    {{ 'products.rating.value' | t: rating: rating_display }}
                  {% endif %}
                </span>
                {% if block.settings.reviews_link != blank %}
                  </a>
                {% endif %}
              </div>
            {% endif %}

          {% when 'price' %}
            <div class="cosme-main-product__price" data-product-price {{ block.shopify_attributes }}>
              {% if current_variant %}
                {% render 'cosme-price', variant: current_variant, show_from: false, show_unit_price: true %}
              {% else %}
                {% render 'cosme-price', product: product, show_unit_price: true %}
              {% endif %}
              {%- if cart.taxes_included -%}
                <div class="cosme-product__tax-note">
                  {{ 'products.product.include_taxes' | t }}
                </div>
              {%- endif -%}
            </div>

          {% when 'availability' %}
            {% liquid
              assign availability_status = ''
              if product_available
                assign availability_status = 'in_stock'
                if current_variant
                  if current_variant.inventory_management != blank
                    if current_variant.inventory_quantity > 0
                      if current_variant.inventory_quantity <= block.settings.low_stock_threshold
                        assign availability_status = 'low_stock'
                      endif
                    endif
                  endif
                endif
              else
                assign availability_status = 'sold_out'
              endif
            %}
            {% if availability_status != blank %}
              <p
                class="cosme-main-product__availability cosme-main-product__availability--{{ availability_status }}"
                data-product-availability
                {{ block.shopify_attributes }}
              >
                {% case availability_status %}
                  {% when 'in_stock' %}
                    {{ 'products.availability.in_stock' | t }}
                  {% when 'low_stock' %}
                    {{ 'products.availability.low_stock' | t }}
                  {% when 'sold_out' %}
                    {{ 'products.availability.sold_out' | t }}
                {% endcase %}
              </p>
            {% endif %}

          {% when 'variant_picker' %}
            <div data-variant-picker-form-anchor {{ block.shopify_attributes }}>
              {% render 'cosme-variant-picker', product: product, section_id: section.id %}
            </div>
            <script>
              (function () {
                const formId = {{ product_form_id | json }};
                const applyVariantPickerForm = (root) => {
                  const section = root && root.matches && root.matches('[data-main-product]')
                    ? root
                    : document.getElementById('MainProduct-{{ section.id }}') || document.querySelector('[data-main-product]');
                  const scope = section || document;
                  scope.querySelectorAll('[data-variant-picker-form-anchor] input').forEach((input) => {
                    input.setAttribute('form', formId);
                  });
                };
                applyVariantPickerForm(document.getElementById('MainProduct-{{ section.id }}'));
                document.addEventListener('cosme:product-updated', (event) => {
                  const section = event.target.closest('[data-main-product]') || event.target;
                  applyVariantPickerForm(section);
                });
                document.addEventListener('shopify:section:load', (event) => {
                  applyVariantPickerForm(event.target.querySelector('[data-main-product]') || event.target);
                });
              })();
            </script>

          {% when 'quantity' %}
            <div class="cosme-product-form__quantity" {{ block.shopify_attributes }}>
              <label class="cosme-product-form__quantity-label" for="Quantity-{{ section.id }}">
                {{ 'products.quantity' | t }}
              </label>
              <div class="cosme-product-form__quantity-control">
                <button
                  type="button"
                  class="cosme-product-form__quantity-button"
                  data-quantity-decrease
                  aria-label="{{ 'products.decrease_quantity' | t }}"
                >
                  {% render 'cosme-icon', icon: 'minus', size: 'sm' %}
                </button>
                <input
                  id="Quantity-{{ section.id }}"
                  class="cosme-product-form__quantity-input"
                  type="number"
                  name="quantity"
                  form="{{ product_form_id }}"
                  value="1"
                  min="1"
                  {% if max_quantity %}
                    max="{{ max_quantity }}"
                  {% endif %}
                  inputmode="numeric"
                  data-quantity-input
                >
                <button
                  type="button"
                  class="cosme-product-form__quantity-button"
                  data-quantity-increase
                  aria-label="{{ 'products.increase_quantity' | t }}"
                >
                  {% render 'cosme-icon', icon: 'plus', size: 'sm' %}
                </button>
              </div>
            </div>

          {% when 'buy_buttons' %}
            {% form 'product', product, id: product_form_id, class: 'cosme-product-form', data-product-form: '' %}
              <div {{ block.shopify_attributes }}>
                <input
                  type="hidden"
                  name="id"
                  value="{{ variant_id }}"
                  data-product-variant-id
                  {% if current_variant == blank %}
                    disabled
                  {% endif %}
                >

                {% if block.settings.show_buy_it_now %}
                  <div
                    class="cosme-product-form__buy-now{% if atc_disabled %} is-disabled{% endif %}{% if section.settings.buy_now_style == 'outline' %} cosme-product-form__buy-now--outline{% endif %}"
                    data-buy-now
                  >
                    {{ form | payment_button }}
                  </div>
                {% endif %}

                <div class="cosme-product-form__actions" data-product-atc-sentinel>
                  {% render 'cosme-button',
                    label: atc_label,
                    type: 'submit',
                    style: button_style,
                    disabled: atc_disabled,
                    name: 'add',
                    class: 'cosme-product-form__submit'
                  %}
                  <div class="cosme-product__payment-terms">
                    {{ form | payment_terms }}
                  </div>
                </div>

                <p class="cosme-product-form__status" data-product-form-status aria-live="polite"></p>
              </div>
            {% endform %}

          {% when 'pickup_availability' %}
            {%- liquid
              assign pickup_enabled = false
              if product.selected_or_first_available_variant
                for availability in product.selected_or_first_available_variant.store_availabilities
                  if availability.pick_up_enabled
                    assign pickup_enabled = true
                    break
                  endif
                endfor
              endif
            -%}
            {%- if pickup_enabled -%}
              <div
                class="cosme-pickup-availability"
                data-pickup-availability
                data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                data-section-id="{{ section.id }}"
                {{ block.shopify_attributes }}
              >
                <button
                  type="button"
                  class="cosme-pickup-availability__toggle"
                  data-pickup-toggle
                  aria-expanded="false"
                >
                  <span class="cosme-pickup-availability__icon" aria-hidden="true">
                    {% render 'cosme-icon', icon: 'map-pin', size: 'sm' %}
                  </span>
                  <span class="cosme-pickup-availability__summary">
                    {%- liquid
                      assign first_available = blank
                      assign first_unavailable = blank
                      for availability in product.selected_or_first_available_variant.store_availabilities
                        if availability.pick_up_enabled
                          if availability.available and first_available == blank
                            assign first_available = availability
                          elsif availability.available == false and first_unavailable == blank
                            assign first_unavailable = availability
                          endif
                        endif
                      endfor
                      if first_available
                        echo 'products.product.pickup_availability.pick_up_available_at' | t: location_name: first_available.location.name
                      elsif first_unavailable
                        echo 'products.product.pickup_availability.pick_up_unavailable_at' | t: location_name: first_unavailable.location.name
                      endif
                    -%}
                  </span>
                  <span class="cosme-pickup-availability__chevron" aria-hidden="true">
                    {% render 'cosme-icon', icon: 'chevron-down', size: 'sm' %}
                  </span>
                </button>

                <div class="cosme-pickup-availability__panel" data-pickup-panel hidden>
                  <ul class="cosme-pickup-availability__list" role="list">
                    {% for availability in product.selected_or_first_available_variant.store_availabilities %}
                      {%- if availability.pick_up_enabled -%}
                        <li class="cosme-pickup-availability__item">
                          <p class="cosme-pickup-availability__location">
                            <strong>{{ availability.location.name | escape }}</strong>
                          </p>
                          {%- if availability.available -%}
                            <p class="cosme-pickup-availability__status cosme-pickup-availability__status--available">
                              {{ 'products.product.pickup_availability.available' | t }}
                              {%- if availability.pick_up_time != blank -%}
                                · {{ availability.pick_up_time | escape }}
                              {%- endif -%}
                            </p>
                          {%- else -%}
                            <p class="cosme-pickup-availability__status cosme-pickup-availability__status--unavailable">
                              {{ 'products.product.pickup_availability.unavailable' | t }}
                            </p>
                          {%- endif -%}
                          {%- if availability.location.address -%}
                            <p class="cosme-pickup-availability__address">
                              {{ availability.location.address | format_address }}
                            </p>
                          {%- endif -%}
                        </li>
                      {%- endif -%}
                    {% endfor %}
                  </ul>
                </div>
              </div>
            {%- endif -%}

          {% when 'gift_card_recipient' %}
            {%- if product.gift_card? -%}
              <div class="cosme-gift-card-recipient" data-gift-card-recipient {{ block.shopify_attributes }}>
                <label class="cosme-gift-card-recipient__toggle">
                  <input
                    type="checkbox"
                    name="properties[__shopify_send_gift_card_to_recipient]"
                    value="true"
                    form="{{ product_form_id }}"
                    data-gift-card-recipient-toggle
                  >
                  <span>{{ 'products.product.gift_card_recipient.checkbox' | t }}</span>
                </label>

                <div class="cosme-gift-card-recipient__fields" data-gift-card-recipient-fields hidden>
                  <div class="cosme-form-field">
                    <label for="GiftCardRecipientEmail-{{ section.id }}" class="cosme-form-field__label">
                      {{ 'products.product.gift_card_recipient.recipient_email' | t }}
                    </label>
                    <input
                      type="email"
                      id="GiftCardRecipientEmail-{{ section.id }}"
                      name="properties[Recipient email]"
                      class="cosme-form-field__control"
                      autocomplete="email"
                      form="{{ product_form_id }}"
                      data-gift-card-recipient-email
                    >
                    <p class="cosme-form-field__error" data-gift-card-recipient-error hidden>
                      {{ 'products.product.gift_card_recipient.error_email' | t }}
                    </p>
                  </div>

                  <div class="cosme-form-field">
                    <label for="GiftCardRecipientName-{{ section.id }}" class="cosme-form-field__label">
                      {{ 'products.product.gift_card_recipient.recipient_name' | t }}
                    </label>
                    <input
                      type="text"
                      id="GiftCardRecipientName-{{ section.id }}"
                      name="properties[Recipient name]"
                      class="cosme-form-field__control"
                      autocomplete="name"
                      form="{{ product_form_id }}"
                    >
                  </div>

                  <div class="cosme-form-field">
                    <label for="GiftCardRecipientMessage-{{ section.id }}" class="cosme-form-field__label">
                      {{ 'products.product.gift_card_recipient.message' | t }}
                    </label>
                    <textarea
                      id="GiftCardRecipientMessage-{{ section.id }}"
                      name="properties[Message]"
                      class="cosme-form-field__control"
                      rows="3"
                      form="{{ product_form_id }}"
                    ></textarea>
                  </div>

                  <div class="cosme-form-field">
                    <label for="GiftCardRecipientSendOn-{{ section.id }}" class="cosme-form-field__label">
                      {{ 'products.product.gift_card_recipient.send_on' | t }}
                    </label>
                    <input
                      type="date"
                      id="GiftCardRecipientSendOn-{{ section.id }}"
                      name="properties[Send on]"
                      class="cosme-form-field__control"
                      form="{{ product_form_id }}"
                    >
                    <p class="cosme-form-field__hint">
                      {{ 'products.product.gift_card_recipient.send_on_info' | t }}
                    </p>
                  </div>
                </div>
              </div>
            {%- endif -%}

          {% when 'trust' %}
            <div class="cosme-main-product__trust" {{ block.shopify_attributes }}>
              {% render 'cosme-trust-bar',
                item_1_icon: 'shipping',
                item_1_heading: block.settings.trust_shipping,
                item_2_icon: 'secure',
                item_2_heading: block.settings.trust_payment,
                item_3_icon: 'return',
                item_3_heading: block.settings.trust_returns
              %}
            </div>

          {% when 'meta' %}
            {% liquid
              assign show_sku = false
              if block.settings.show_sku
                if current_variant.sku != blank
                  assign show_sku = true
                endif
              endif

              assign show_vendor = false
              if block.settings.show_vendor
                if product.vendor != blank
                  assign show_vendor = true
                endif
              endif

              assign show_type = false
              if block.settings.show_type
                if product.type != blank
                  assign show_type = true
                endif
              endif

              assign show_meta = false
              if show_sku
                assign show_meta = true
              endif
              if show_vendor
                assign show_meta = true
              endif
              if show_type
                assign show_meta = true
              endif
            %}
            {% if show_meta %}
              <dl class="cosme-main-product__meta" {{ block.shopify_attributes }}>
                {% if show_sku %}
                  <div class="cosme-main-product__meta-row">
                    <dt>{{ 'products.meta.sku' | t }}</dt>
                    <dd>{{ current_variant.sku | escape }}</dd>
                  </div>
                {% endif %}
                {% if show_vendor %}
                  <div class="cosme-main-product__meta-row">
                    <dt>{{ 'products.meta.vendor' | t }}</dt>
                    <dd>{{ product.vendor | escape }}</dd>
                  </div>
                {% endif %}
                {% if show_type %}
                  <div class="cosme-main-product__meta-row">
                    <dt>{{ 'products.meta.type' | t }}</dt>
                    <dd>{{ product.type | escape }}</dd>
                  </div>
                {% endif %}
              </dl>
            {% endif %}

          {% when 'share' %}
            <div class="cosme-main-product__share" {{ block.shopify_attributes }}>
              <span class="cosme-main-product__share-label">{{ 'products.share.label' | t }}</span>
              <button
                type="button"
                class="cosme-main-product__share-button"
                data-product-share
                data-share-url="{{ shop.url | append: product.url }}"
                data-share-title="{{ product.title | escape }}"
              >
                {% render 'cosme-icon', icon: 'external-link', size: 'sm' %}
                <span>{{ 'products.share.action' | t }}</span>
              </button>
              <span class="cosme-visually-hidden" data-share-status aria-live="polite"></span>
            </div>

          {% when 'description' %}
            {% liquid
              assign row_enabled = true
              if block.settings.enabled == false
                assign row_enabled = false
              endif
              assign row_heading = block.settings.heading | strip
              assign description_excerpt = ''
              if row_enabled
                if section.settings.show_description
                  assign short_description_field = product.metafields.custom.short_description
                  if short_description_field != blank
                    assign description_excerpt = short_description_field | metafield_text | strip
                  endif
                  if description_excerpt == blank
                    if product.description != blank
                      assign description_excerpt = product.description | strip_html | strip | truncate: 200
                    endif
                  endif
                endif
              endif
              if row_heading == blank
                assign row_heading = 'products.details.description' | t
              endif
              assign row_open = false
              if description_excerpt != blank
                if section.settings.open_first_accordion
                  unless accordion_first_opened
                    assign row_open = true
                    assign accordion_first_opened = true
                  endunless
                endif
              endif
              assign row_id = 'ProductAccordion-' | append: section.id | append: '-' | append: block.id
            %}
            {% if description_excerpt != blank %}
              <div
                class="cosme-product-details cosme-product-details--inline cosme-product-details--icon-{{ accordion_icon }}"
                {{ block.shopify_attributes }}
              >
                <div class="cosme-product-details__accordion">
                  <details
                    class="cosme-product-details__item"
                    id="{{ row_id }}"
                    {% if row_open %}
                      open
                    {% endif %}
                  >
                    <summary class="cosme-product-details__summary">
                      <span class="cosme-product-details__title">{{ row_heading | escape }}</span>
                      <span class="cosme-product-details__icon" aria-hidden="true">
                        {% if accordion_icon == 'chevron' %}
                          {% render 'cosme-icon', icon: 'chevron-down', size: 'sm' %}
                        {% else %}
                          <span class="cosme-product-details__icon-plus">
                            {% render 'cosme-icon', icon: 'plus', size: 'sm' %}
                          </span>
                          <span class="cosme-product-details__icon-minus">
                            {% render 'cosme-icon', icon: 'minus', size: 'sm' %}
                          </span>
                        {% endif %}
                      </span>
                    </summary>
                    <div class="cosme-product-details__panel">
                      <div class="cosme-product-details__content">
                        <p>{{ description_excerpt | escape }}</p>
                      </div>
                    </div>
                  </details>
                </div>
              </div>
            {% endif %}

          {% when 'information' %}
            {% liquid
              assign row_enabled = true
              if block.settings.enabled == false
                assign row_enabled = false
              endif
              assign row_heading = block.settings.heading | strip
              if row_heading == blank
                assign row_heading = 'products.details.information' | t
              endif
              assign row_content = ''
            %}
            {% if row_enabled %}
              {% capture row_content %}
                {% render 'cosme-metafield',
                  product: product,
                  namespace: block.settings.metafield_namespace,
                  key: block.settings.metafield_key
                %}
              {% endcapture %}
              {% assign metafield_plain = row_content | strip_html | strip %}
              {% if metafield_plain == blank %}
                {% if block.settings.content != blank %}
                  {% capture row_content %}
                    <div class="cosme-rte">{{ block.settings.content }}</div>
                  {% endcapture %}
                {% else %}
                  {% assign row_content = '' %}
                {% endif %}
              {% endif %}
            {% endif %}
            {% liquid
              assign row_plain = row_content | strip_html | strip
              assign row_open = false
              if row_plain != blank
                if section.settings.open_first_accordion
                  unless accordion_first_opened
                    assign row_open = true
                    assign accordion_first_opened = true
                  endunless
                endif
              endif
              assign row_id = 'ProductAccordion-' | append: section.id | append: '-' | append: block.id
            %}
            {% if row_plain != blank %}
              <div
                class="cosme-product-details cosme-product-details--inline cosme-product-details--icon-{{ accordion_icon }}"
                {{ block.shopify_attributes }}
              >
                <div class="cosme-product-details__accordion">
                  <details
                    class="cosme-product-details__item"
                    id="{{ row_id }}"
                    {% if row_open %}
                      open
                    {% endif %}
                  >
                    <summary class="cosme-product-details__summary">
                      <span class="cosme-product-details__title">{{ row_heading | escape }}</span>
                      <span class="cosme-product-details__icon" aria-hidden="true">
                        {% if accordion_icon == 'chevron' %}
                          {% render 'cosme-icon', icon: 'chevron-down', size: 'sm' %}
                        {% else %}
                          <span class="cosme-product-details__icon-plus">
                            {% render 'cosme-icon', icon: 'plus', size: 'sm' %}
                          </span>
                          <span class="cosme-product-details__icon-minus">
                            {% render 'cosme-icon', icon: 'minus', size: 'sm' %}
                          </span>
                        {% endif %}
                      </span>
                    </summary>
                    <div class="cosme-product-details__panel">
                      <div class="cosme-product-details__content">
                        {{ row_content }}
                      </div>
                    </div>
                  </details>
                </div>
              </div>
            {% endif %}

          {% when '@app' %}
            {% render block %}
        {% endcase %}
      {% endfor %}
    </div>
  </div>

  {% liquid
    assign sticky_enabled = section.settings.enable_sticky_atc
    assign sticky_desktop = section.settings.sticky_atc_desktop
    assign sticky_mobile = section.settings.sticky_atc_mobile
    assign sticky_image = product.featured_image

    if current_variant.featured_image
      assign sticky_image = current_variant.featured_image
    elsif featured_media.preview_image
      assign sticky_image = featured_media.preview_image
    endif
  %}

  {% if sticky_enabled %}
    {% if sticky_desktop or sticky_mobile %}
      {% render 'cosme-sticky-atc',
        product: product,
        current_variant: current_variant,
        image: sticky_image,
        product_form_id: product_form_id,
        section_id: section.id,
        atc_label: atc_label,
        atc_disabled: atc_disabled,
        button_style: button_style,
        color_scheme: section.settings.sticky_atc_color_scheme,
        enable_desktop: sticky_desktop,
        enable_mobile: sticky_mobile,
        show_image: section.settings.sticky_atc_show_image,
        show_title: section.settings.sticky_atc_show_title,
        show_price: section.settings.sticky_atc_show_price,
        show_variant: section.settings.sticky_atc_show_variant
      %}
    {% endif %}
  {% endif %}
</section>

{% stylesheet %}
  .cosme-main-product {
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .cosme-main-product__inner {
    display: grid;
    gap: var(--product-gallery-gap, 3rem);
    width: 100%;
    max-width: var(--content-width);
    min-width: 0;
    margin-inline: auto;
    padding: var(--spacing-section) var(--page-margin);
    overflow-x: clip;
  }

  .cosme-main-product--width-full .cosme-main-product__inner {
    max-width: none;
  }

  .cosme-main-product__info {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--spacing-sm);
    row-gap: var(--spacing-md);
    align-content: start;
    min-width: 0;
    max-width: var(--product-info-width, none);
  }

  .cosme-main-product__info > * {
    grid-column: 1 / -1;
  }

  .cosme-main-product__info > .cosme-product-form__quantity {
    grid-column: 1 / 2;
    align-self: end;
  }

  .cosme-main-product__info > .cosme-product-form,
  .cosme-main-product__info > .cosme-product-form > div {
    display: contents;
  }

  .cosme-main-product__info .cosme-product-form__buy-now {
    grid-column: 2 / -1;
    align-self: end;
    margin-block-start: 0;
  }

  .cosme-main-product__info .cosme-product-form__actions {
    grid-column: 1 / -1;
    margin-block-start: 0;
  }

  .cosme-main-product__info .cosme-product-form__status {
    grid-column: 1 / -1;
    margin-block-start: 0;
  }
  .cosme-main-product--align-center .cosme-main-product__info {
    text-align: center;
    align-items: center;
  }

  .cosme-main-product__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }

  .cosme-main-product__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 2.4vw, 2.75rem);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    line-height: 1.15;
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-heading);
  }

  .cosme-main-product__vendor {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-main-product__rating,
  .cosme-main-product__rating-link {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-sm);
    color: var(--color-muted);
    text-decoration: none;
  }

  .cosme-main-product__rating-link:hover,
  .cosme-main-product__rating-link:focus-visible {
    color: var(--color-foreground);
  }

  .cosme-main-product__stars {
    display: inline-flex;
    gap: 0.125rem;
  }

  .cosme-main-product__star {
    position: relative;
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    color: var(--color-border);
  }

  .cosme-main-product__star .cosme-icon {
    width: 1rem;
    height: 1rem;
  }

  .cosme-main-product__star-base,
  .cosme-main-product__star-fill {
    display: flex;
    width: 100%;
    height: 100%;
  }

  .cosme-main-product__star-fill {
    position: absolute;
    inset: 0 auto 0 0;
    overflow: hidden;
    width: var(--star-fill, 0%);
    color: var(--color-accent);
  }

  .cosme-main-product__star-fill .cosme-icon svg {
    fill: currentcolor;
    stroke: currentcolor;
  }

  .cosme-main-product__rating-text {
    font-size: 0.8125rem;
  }

  .cosme-main-product__price .cosme-price {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-heading);
  }

  .cosme-main-product__price .cosme-price__compare {
    font-size: 0.9375rem;
    font-weight: 400;
  }

  .cosme-main-product__availability {
    margin: 0;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-main-product__availability--in_stock,
  .cosme-main-product__availability--low_stock {
    color: var(--color-success);
  }

  .cosme-main-product__availability--sold_out {
    color: var(--color-error);
  }

  .cosme-product-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    width: 100%;
  }

  .cosme-variant-picker {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .cosme-variant-picker__option {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .cosme-variant-picker__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs) var(--spacing-sm);
    margin-block-end: var(--spacing-sm);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-variant-picker__legend-value {
    color: var(--color-foreground);
    text-transform: none;
    letter-spacing: 0;
  }

  .cosme-variant-picker__values {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .cosme-variant-picker__values--swatches {
    gap: var(--spacing-sm);
  }

  .cosme-variant-picker__label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color var(--transition-duration) var(--transition-easing),
      border-color var(--transition-duration) var(--transition-easing),
      color var(--transition-duration) var(--transition-easing);
  }

  .cosme-variant-picker__label--pill {
    min-height: 2.5rem;
    min-width: 2.75rem;
    padding: 0.4rem 0.9rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-button);
    color: var(--color-foreground);
    background: transparent;
  }

  .cosme-variant-picker__value input:checked + .cosme-variant-picker__label--pill {
    background-color: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background);
  }

  .cosme-variant-picker__label--swatch {
    padding: 0.15rem;
    border: var(--border-width) solid transparent;
    border-radius: 50%;
  }

  .cosme-variant-picker__value input:checked + .cosme-variant-picker__label--swatch {
    border-color: var(--color-foreground);
  }

  .cosme-variant-picker__swatch {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-background-2, var(--color-background));
    background-size: cover;
    background-position: center;
  }

  .cosme-variant-picker__label.is-unavailable {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .cosme-variant-picker__label--pill.is-unavailable {
    text-decoration: line-through;
  }

  .cosme-variant-picker__value input:focus-visible + .cosme-variant-picker__label {
    outline: var(--focus-ring-width) solid var(--color-accent);
    outline-offset: 2px;
  }
  .cosme-product-form__row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--spacing-sm);
    width: 100%;
  }

  .cosme-product-form__quantity {
    flex: 0 0 auto;
  }

  .cosme-product-form__buy-now {
    flex: 1 1 auto;
    min-width: 0;
  }

  .cosme-product-form__buy-now .shopify-payment-button {
    width: 100%;
  }

  .cosme-product-form__buy-now .shopify-payment-button__button {
    width: 100%;
    min-height: 2.75rem;
  }

  .cosme-product-form__quantity {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .cosme-main-product--align-center .cosme-product-form__quantity {
    align-items: center;
  }

  .cosme-product-form__quantity-label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-product-form__quantity-control {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.15rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-button);
    background-color: var(--color-input-background, var(--color-background));
    color: var(--color-foreground);
  }

  .cosme-product-form__quantity-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: inherit;
    background: transparent;
    color: inherit;
  }

  .cosme-product-form__quantity-button:hover {
    color: var(--color-accent);
  }

  .cosme-product-form__quantity-button:focus-visible {
    color: var(--color-accent);
    outline: var(--focus-ring-width) solid var(--color-accent);
    outline-offset: 2px;
  }

  .cosme-product-form__quantity-input {
    width: 2.5rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: center;
    appearance: textfield;
  }

  .cosme-product-form__quantity-input::-webkit-outer-spin-button,
  .cosme-product-form__quantity-input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .cosme-product-form__actions {
    display: flex;
    flex-direction: column;
  }

  @media screen and (min-width: 768px) {
    .cosme-product-form__actions {
      flex-direction: row;
      align-items: stretch;
    }

    .cosme-product-form__submit,
    .cosme-product-form__buy-now {
      flex: 1 1 0;
    }
  }

  .cosme-product-form__submit,
  .cosme-product-form__actions .shopify-payment-button,
  .cosme-product-form__actions .shopify-payment-button__button {
    width: 100%;
  }

  .cosme-product-form__buy-now.is-disabled {
    display: none;
  }
  .cosme-product-form__buy-now--outline .shopify-payment-button__button {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    line-height: 1 !important;
    padding-block: 0.5rem !important;
  }

  .cosme-product-form__buy-now--outline .shopify-payment-button__button {
    background-color: transparent !important;
    border: var(--border-width) solid var(--color-button-secondary-border, var(--color-border)) !important;
    color: var(--color-button-secondary-label, var(--color-foreground)) !important;
    border-radius: var(--radius-button) !important;
    font-family: var(--font-body--family) !important;
    font-weight: 500 !important;
    letter-spacing: 0.04em !important;
    text-transform: none !important;
  }

  .cosme-product-form__buy-now--outline .shopify-payment-button__button:hover {
    background-color: var(--color-background, transparent) !important;
    border-color: var(--color-button-secondary-border-hover, var(--color-foreground)) !important;
    color: var(--color-button-secondary-label-hover, var(--color-foreground)) !important;
  }

  .cosme-product-form__buy-now--outline .shopify-payment-button__button:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-accent);
    outline-offset: 2px;
  }

  .shopify-payment-button__button {
    min-height: 2.75rem;
    border-radius: var(--radius-button) !important;
  }

  .shopify-payment-button__button--unbranded {
    background-color: var(--color-button-secondary-background, transparent) !important;
    border: var(--border-width) solid var(--color-border) !important;
    color: var(--color-button-secondary-label, var(--color-foreground)) !important;
  }

  .cosme-product-form__status:empty {
    display: none;
  }

  .cosme-product-form__status {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-success);
  }

  .cosme-product-form__status.is-error {
    color: var(--color-error);
  }

  .cosme-pickup-availability {
    margin-block-start: var(--spacing-lg);
    padding-block-start: var(--spacing-lg);
    border-top: var(--border-width) solid var(--color-border);
  }

  .cosme-pickup-availability__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    width: 100%;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    text-align: start;
    color: inherit;
    font: inherit;
  }

  .cosme-pickup-availability__summary {
    flex: 1 1 auto;
  }

  .cosme-pickup-availability__chevron {
    display: inline-flex;
    flex-shrink: 0;
    transition: transform var(--transition-duration, 0.2s) var(--transition-easing, ease);
  }

  .cosme-pickup-availability__toggle[aria-expanded='true'] .cosme-pickup-availability__chevron {
    transform: rotate(180deg);
  }

  .cosme-pickup-availability__panel[hidden] {
    display: none;
  }

  .cosme-pickup-availability__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--spacing-md);
    margin-block-start: var(--spacing-md);
  }

  .cosme-pickup-availability__location,
  .cosme-pickup-availability__status {
    margin: 0;
  }

  .cosme-pickup-availability__status--available {
    color: var(--color-success, var(--color-accent));
  }

  .cosme-pickup-availability__status--unavailable {
    color: var(--color-muted);
  }

  .cosme-pickup-availability__address {
    color: var(--color-muted);
    font-size: 0.875rem;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .cosme-pickup-availability__chevron {
      transition: none;
    }
  }

  .cosme-gift-card-recipient {
    display: grid;
    gap: var(--spacing-lg);
    margin-block-start: var(--spacing-lg);
    padding-block-start: var(--spacing-lg);
    border-top: var(--border-width) solid var(--color-border);
  }

  .cosme-gift-card-recipient__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    cursor: pointer;
  }

  .cosme-gift-card-recipient__fields {
    display: grid;
    gap: var(--spacing-md);
  }

  .cosme-gift-card-recipient__fields[hidden] {
    display: none;
  }

  .cosme-main-product__meta {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    margin: 0;
  }

  .cosme-main-product__meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs) var(--spacing-sm);
    font-size: 0.8125rem;
  }

  .cosme-main-product__meta dt {
    color: var(--color-muted);
  }

  .cosme-main-product__meta dd {
    margin: 0;
    color: var(--color-foreground);
  }

  .cosme-main-product__share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .cosme-main-product__share-label {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .cosme-main-product__share-button {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-foreground);
    font-size: 0.8125rem;
  }

  .cosme-main-product__share-button:hover {
    color: var(--color-accent);
  }

  .cosme-main-product__share-button:focus-visible {
    color: var(--color-accent);
    outline: var(--focus-ring-width) solid var(--color-accent);
    outline-offset: 2px;
  }

  .cosme-main-product__media {
    min-width: 0;
    align-self: start;
  }

  .cosme-main-product__trust {
    width: 100%;
  }

  .cosme-main-product__trust .cosme-trust-bar {
    grid-template-columns: repeat(3, 1fr);
    padding-block: var(--spacing-sm);
    /* border-block: var(--border-width) solid var(--color-border); */
  }

  .cosme-main-product__trust .cosme-trust-bar__item {
    min-height: 2.25rem;
  }

  @media screen and (min-width: 768px) {
    .cosme-main-product__inner {
      grid-template-columns: minmax(0, var(--product-media-width, 58%)) minmax(0, 1fr);
      align-items: start;
    }

    .cosme-main-product__media.is-sticky {
      position: sticky;
      top: calc(var(--header-sticky-offset, 0px) + 20px);
      z-index: 1;
    }

    .cosme-main-product__media.is-sticky .cosme-product-gallery--left .cosme-product-gallery__thumbs,
    .cosme-main-product__media.is-sticky .cosme-product-gallery--right .cosme-product-gallery__thumbs {
      max-height: calc(100dvh - var(--header-sticky-offset, 0px) - 2rem);
    }
  }

  @media screen and (min-width: 990px) {
    .cosme-main-product__info {
      padding-block-start: 0.25rem;
    }
  }
  .cosme-main-product--align-center .cosme-variant-picker__values {
    justify-content: center;
  }

  .cosme-main-product--align-center .cosme-product-form__row {
    justify-content: center;
  }

  .cosme-main-product--align-center .cosme-product-form__actions {
    justify-content: center;
  }

  .cosme-main-product--align-center .cosme-main-product__price .cosme-price {
    justify-content: center;
  }

  .cosme-product-details--inline {
    width: 100%;
    max-width: none;
    background: transparent;
  }

  .cosme-product-details--inline .cosme-product-details__accordion {
    max-width: none;
  }

  .cosme-product-details {
    background-color: var(--color-background);
    color: var(--color-foreground);
    overflow-x: hidden;
    max-width: 100%;
  }

  .cosme-product-details__accordion {
    width: 100%;
    max-width: 42rem;
    min-width: 0;
  }

  /* Каждый item имеет только нижний border */
  .cosme-product-details__item {
    border-block-end: var(--border-width) solid var(--color-border);
    border-block-start: 0;
  }

  /* Первый item в каждой группе .cosme-product-details__accordion — с верхним border */
  .cosme-product-details__accordion > .cosme-product-details__item:first-child {
    border-block-start: var(--border-width) solid var(--color-border);
  }

  /* Все последующие группы .cosme-product-details схлопывают верхний border */
  .cosme-main-product__info
    > *:has(.cosme-product-details)
    ~ *:has(.cosme-product-details)
    .cosme-product-details__item:first-child,
  .cosme-main-product__info .cosme-product-details ~ .cosme-product-details .cosme-product-details__item:first-child {
    border-block-start: 0;
    margin-block-start: calc(var(--spacing-md) * -1);
  }

  .cosme-product-details__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    width: 100%;
    min-height: 3.25rem;
    padding-block: 0.9rem;
    cursor: pointer;
    list-style: none;
    color: var(--color-heading);
  }

  .cosme-product-details__summary::-webkit-details-marker {
    display: none;
  }

  .cosme-product-details__summary:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-accent);
    outline-offset: 4px;
  }

  .cosme-product-details__title {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: 0.8125rem;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .cosme-product-details__icon {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-foreground);
  }

  .cosme-product-details__icon-minus {
    display: none;
  }

  .cosme-product-details__item[open] .cosme-product-details__icon-plus {
    display: none;
  }

  .cosme-product-details__item[open] .cosme-product-details__icon-minus {
    display: inline-flex;
  }

  .cosme-product-details--icon-chevron .cosme-product-details__icon {
    transition: transform var(--transition-duration) var(--transition-easing);
  }

  .cosme-product-details--icon-chevron .cosme-product-details__item[open] .cosme-product-details__icon {
    transform: rotate(180deg);
  }

  .cosme-product-details__item::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 0.35s var(--transition-easing), content-visibility 0.35s allow-discrete;
  }

  .cosme-product-details__item[open]::details-content {
    block-size: auto;
  }

  .cosme-product-details__content {
    padding-block: 0 1.25rem;
    max-width: 40rem;
    font-size: 0.9375rem;
    line-height: var(--line-height-body);
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }

  .cosme-product-details__content p,
  .cosme-product-details__content ul,
  .cosme-product-details__content ol {
    margin: 0 0 0.75rem;
  }

  .cosme-product-details__content ul,
  .cosme-product-details__content ol {
    padding-inline-start: 1.1rem;
  }

  .cosme-product-details__content .cosme-rte > *:first-child {
    margin-block-start: 0;
  }

  .cosme-product-details__content .cosme-rte > *:last-child {
    margin-block-end: 0;
  }

  .cosme-product-details__content a {
    color: var(--color-foreground);
  }

  .cosme-product-details__content a:hover,
  .cosme-product-details__content a:focus-visible {
    color: var(--color-accent);
  }

  .cosme-product-details__accordion:empty {
    display: none;
  }
  h2.cosme-main-product__title {
    font-size: clamp(1.4rem, 1.8vw, 2rem);
  }
  /* Мобильная версия — в столбик, на всю ширину */
  @media screen and (max-width: 749px) {
    .cosme-main-product__trust .cosme-trust-bar {
      grid-template-columns: 1fr;
      gap: var(--spacing-xs);
      text-align: center;
    }

    .cosme-main-product__trust .cosme-trust-bar__item {
      min-height: auto;
      padding-block: var(--spacing-xs);
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    if (window._cosmeMainProduct) return;
    window._cosmeMainProduct = true;

    const applyFormAttributeToExternalInputs = (root) => {
      const section = root?.matches?.('[data-main-product]')
        ? root
        : root?.querySelector?.('[data-main-product]') || root?.closest?.('[data-main-product]');
      if (!section) return;
      const form = section.querySelector('[data-product-form]');
      if (!form || !form.id) return;
      section
        .querySelectorAll(
          '[data-variant-picker-form-anchor] input, [data-quantity-input], [data-gift-card-recipient] input, [data-gift-card-recipient] textarea'
        )
        .forEach((input) => {
          if (!form.contains(input)) input.setAttribute('form', form.id);
        });
    };

    const stringsFrom = (section) => ({
      adding: section?.dataset.stringAdding || 'Adding…',
      added: section?.dataset.stringAdded || 'Added to cart',
      error: section?.dataset.stringError || 'Unable to add to cart. Please try again.',
      copied: section?.dataset.stringCopied || 'Link copied',
      copyFailed: section?.dataset.stringCopyFailed || 'Unable to copy link',
    });

    const parseHtml = (text) => new DOMParser().parseFromString(text, 'text/html');

    const clampQuantity = (input, nextValue) => {
      const min = Number(input.min || 1);
      const max = input.max ? Number(input.max) : Number.POSITIVE_INFINITY;
      return Math.min(max, Math.max(min, nextValue));
    };

    const refreshPaymentButton = () => {
      if (window.Shopify && Shopify.PaymentButton && typeof Shopify.PaymentButton.init === 'function') {
        Shopify.PaymentButton.init();
      }
    };

    const replaceProductRoot = (section, html, focusId) => {
      const doc = parseHtml(html);
      const incoming = doc.querySelector('[data-product-root]');
      const current = section.querySelector('[data-product-root]');
      if (!incoming || !current) return;

      const quantityInput = current.querySelector('[data-quantity-input]');
      const quantity = quantityInput ? quantityInput.value : '1';

      current.replaceWith(incoming);

      const nextQuantity = incoming.querySelector('[data-quantity-input]');
      if (nextQuantity) nextQuantity.value = clampQuantity(nextQuantity, Number(quantity) || 1);

      const incomingSticky = doc.querySelector('[data-sticky-atc-inner]');
      const currentSticky = section.querySelector('[data-sticky-atc-inner]');
      if (incomingSticky && currentSticky) currentSticky.replaceWith(incomingSticky);

      refreshPaymentButton();
      section.dispatchEvent(new CustomEvent('cosme:product-updated', { bubbles: true }));

      if (focusId) {
        const focusTarget = incoming.querySelector(`#${CSS.escape(focusId)}`);
        if (focusTarget) focusTarget.focus();
      }
    };

    const updateVariant = async (section, optionInput) => {
      const selected = Array.from(section.querySelectorAll('[data-option-value-id]:checked'))
        .map((input) => input.dataset.optionValueId)
        .filter(Boolean);

      const productUrl = optionInput.dataset.productUrl || section.dataset.productUrl || window.location.pathname;
      const url = new URL(productUrl, window.location.origin);
      url.searchParams.set('section_id', section.dataset.sectionId);
      if (selected.length) url.searchParams.set('option_values', selected.join(','));

      const response = await fetch(url.toString());
      if (!response.ok) return;

      const html = await response.text();

      // Если изменение пришло из sticky — не фокусируемся
      const focusId = window._cosmeVariantFromSticky ? null : optionInput.id;
      replaceProductRoot(section, html, focusId);
      window._cosmeVariantFromSticky = false;

      const variantInput = section.querySelector('[data-product-variant-id]');
      const historyUrl = new URL(window.location.href);
      if (variantInput && variantInput.value) {
        historyUrl.searchParams.set('variant', variantInput.value);
      } else {
        historyUrl.searchParams.delete('variant');
      }
      window.history.replaceState({}, '', historyUrl.toString());
    };
    const desktopGalleryQuery = window.matchMedia('(min-width: 768px)');

    const syncStickyGallery = (section) => {
      const media = section.querySelector('[data-product-media]');
      const info = section.querySelector('[data-product-info]');
      if (!media || !info) return;

      const offsetRaw = getComputedStyle(document.documentElement).getPropertyValue('--header-sticky-offset').trim();
      const offset = Number.parseFloat(offsetRaw) || 0;
      const available = window.innerHeight - offset;
      const shouldStick =
        desktopGalleryQuery.matches &&
        info.offsetHeight > media.offsetHeight &&
        info.offsetHeight > window.innerHeight &&
        media.offsetHeight <= available;

      media.classList.toggle('is-sticky', shouldStick);
    };

    const observeStickyGallery = (section) => {
      const media = section.querySelector('[data-product-media]');
      const info = section.querySelector('[data-product-info]');
      if (!media || !info) return;

      section._galleryStickyResize?.disconnect();
      section._galleryStickyIO?.disconnect();

      const run = () => syncStickyGallery(section);
      const resizeObserver = new ResizeObserver(run);
      resizeObserver.observe(info);
      resizeObserver.observe(media);
      section._galleryStickyResize = resizeObserver;

      const intersectionObserver = new IntersectionObserver(run, { threshold: [0, 1] });
      intersectionObserver.observe(info);
      section._galleryStickyIO = intersectionObserver;

      if (!section._galleryStickyToggleBound) {
        section.addEventListener(
          'toggle',
          (event) => {
            if (event.target.closest('[data-product-info]')) syncStickyGallery(section);
          },
          true
        );
        section._galleryStickyToggleBound = true;
      }

      run();
    };

    const addToCart = async (form, submitButton) => {
      const section = form.closest('[data-main-product]');
      const strings = stringsFrom(section);
      const statuses = [
        form.querySelector('[data-product-form-status]'),
        section?.querySelector('[data-sticky-atc-status]'),
      ].filter(Boolean);
      const buttons = Array.from(
        new Set(
          [
            submitButton,
            form.querySelector('.cosme-product-form__submit'),
            section?.querySelector('.cosme-sticky-atc__submit'),
          ].filter(Boolean)
        )
      );
      const originalLabels = buttons.map((button) => button.textContent);
      const originalDisabled = buttons.map((button) => button.disabled);
      const variantInput =
        form.querySelector('[data-product-variant-id]') || section?.querySelector('[data-product-variant-id]');
      const quantityInput =
        form.querySelector('[data-quantity-input]') || section?.querySelector('[data-quantity-input]');

      if (!variantInput || !variantInput.value || submitButton.disabled) return;

      buttons.forEach((button) => {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        button.textContent = strings.adding;
      });
      statuses.forEach((status) => {
        status.textContent = '';
        status.classList.remove('is-error');
      });

      try {
        const payload = {
          id: Number(variantInput.value),
          quantity: Number(quantityInput?.value || 1),
        };
        const recipientProperties = giftCardRecipientProperties(form);
        if (recipientProperties) payload.properties = recipientProperties;

        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(payload),
        });

        if (!response.ok) {
          const payload = await response.json().catch(() => ({}));
          throw new Error(payload.description || strings.error);
        }

        document.dispatchEvent(new CustomEvent('cart:refresh'));

        const cartType = section.dataset.cartType || 'drawer';
        if (cartType === 'page') {
          window.location.href = '/cart';
        } else {
          const cartToggle = document.querySelector('[data-header-cart-toggle]');
          if (cartToggle) {
            cartToggle.click();
          }
        }

        statuses.forEach((status) => {
          status.textContent = strings.added;
        });
      } catch (error) {
        statuses.forEach((status) => {
          status.textContent = error.message || strings.error;
          status.classList.add('is-error');
        });
      } finally {
        buttons.forEach((button, index) => {
          button.disabled = originalDisabled[index];
          button.removeAttribute('aria-busy');
          button.textContent = originalLabels[index];
        });
      }
    };

    const shareProduct = async (button) => {
      const section = button.closest('[data-main-product]');
      const strings = stringsFrom(section);
      const url = button.dataset.shareUrl || window.location.href;
      const title = button.dataset.shareTitle || document.title;
      const status = button.parentElement?.querySelector('[data-share-status]');

      try {
        if (navigator.share) {
          await navigator.share({ title, url });
          return;
        }

        await navigator.clipboard.writeText(url);
        if (status) status.textContent = strings.copied;
      } catch (error) {
        if (error && error.name === 'AbortError') return;
        if (status) status.textContent = strings.copyFailed;
      }
    };

    const giftCardRecipientRoot = (form) => {
      const section = form.closest('[data-main-product]');
      return form.querySelector('[data-gift-card-recipient]') || section?.querySelector('[data-gift-card-recipient]');
    };

    const syncGiftCardRecipient = (form, { clear } = { clear: false }) => {
      const root = giftCardRecipientRoot(form);
      if (!root) return;
      const toggle = root.querySelector('[data-gift-card-recipient-toggle]');
      const fields = root.querySelector('[data-gift-card-recipient-fields]');
      const error = root.querySelector('[data-gift-card-recipient-error]');
      if (!toggle || !fields) return;

      const enabled = toggle.checked;
      fields.hidden = !enabled;
      fields.querySelectorAll('input, textarea').forEach((input) => {
        input.disabled = !enabled;
        if (!enabled && clear) input.value = '';
      });
      if (error) error.hidden = true;
    };

    const giftCardRecipientProperties = (form) => {
      const root = giftCardRecipientRoot(form);
      if (!root) return null;
      const toggle = root.querySelector('[data-gift-card-recipient-toggle]');
      if (!toggle || !toggle.checked) return null;

      const properties = {
        __shopify_send_gift_card_to_recipient: 'true',
      };
      root.querySelectorAll('[data-gift-card-recipient-fields] [name]').forEach((input) => {
        if (input.disabled) return;
        const value = input.value.trim();
        if (!value) return;
        const match = input.name.match(/^properties\[(.+)\]$/);
        if (match) properties[match[1]] = value;
      });
      return properties;
    };

    const validateGiftCardRecipient = (form) => {
      const root = giftCardRecipientRoot(form);
      if (!root) return true;

      const toggle = root.querySelector('[data-gift-card-recipient-toggle]');
      const email = root.querySelector('[data-gift-card-recipient-email]');
      const error = root.querySelector('[data-gift-card-recipient-error]');
      if (!toggle) return true;

      if (!toggle.checked) {
        syncGiftCardRecipient(form, { clear: true });
        return true;
      }

      syncGiftCardRecipient(form);
      const emailValue = email ? email.value.trim() : '';
      const emailValid = Boolean(emailValue && email.checkValidity());
      if (emailValid) {
        if (error) error.hidden = true;
        return true;
      }

      if (error) error.hidden = false;
      if (email) email.focus();
      return false;
    };

    document.addEventListener('change', (event) => {
      const quantityInput = event.target.closest('[data-quantity-input]');
      if (quantityInput) {
        quantityInput.value = clampQuantity(quantityInput, Number(quantityInput.value || 1));
        return;
      }

      const recipientToggle = event.target.closest('[data-gift-card-recipient-toggle]');
      if (recipientToggle) {
        const form =
          event.target.closest('[data-product-form]') ||
          event.target.closest('[data-main-product]')?.querySelector('[data-product-form]');
        if (form) syncGiftCardRecipient(form, { clear: !recipientToggle.checked });
        return;
      }

      const optionInput = event.target.closest('[data-option-value-id]');
      const section = event.target.closest('[data-main-product]');
      if (!optionInput || !section) return;
      updateVariant(section, optionInput);
    });

    document.addEventListener('click', (event) => {
      const decrease = event.target.closest('[data-quantity-decrease]');
      const increase = event.target.closest('[data-quantity-increase]');
      if (decrease || increase) {
        const section = event.target.closest('[data-main-product]');
        const input = section?.querySelector('[data-quantity-input]');
        if (!input) return;
        const delta = decrease ? -1 : 1;
        input.value = clampQuantity(input, Number(input.value || 1) + delta);
        return;
      }

      const pickupToggle = event.target.closest('[data-pickup-toggle]');
      if (pickupToggle) {
        const pickup = pickupToggle.closest('[data-pickup-availability]');
        const panel = pickup && pickup.querySelector('[data-pickup-panel]');
        if (!panel) return;

        const expanded = pickupToggle.getAttribute('aria-expanded') === 'true';
        pickupToggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        panel.hidden = expanded;
        return;
      }

      const shareButton = event.target.closest('[data-product-share]');
      if (shareButton) shareProduct(shareButton);
    });

    document.addEventListener('submit', (event) => {
      const form = event.target.closest('[data-product-form]');
      if (!form) return;

      if (!validateGiftCardRecipient(form)) {
        event.preventDefault();
        return;
      }

      const submitter = event.submitter;
      const isAddToCart =
        !submitter || submitter.name === 'add' || submitter.classList.contains('cosme-product-form__submit');
      if (!isAddToCart) return;

      event.preventDefault();
      const submitButton =
        (submitter && submitter.name === 'add' && submitter) ||
        form.querySelector('[name="add"], .cosme-product-form__submit');
      if (submitButton) addToCart(form, submitButton);
    });

    document.querySelectorAll('[data-main-product]').forEach((section) => {
      observeStickyGallery(section);
      applyFormAttributeToExternalInputs(section);
    });
    document.querySelectorAll('[data-product-form]').forEach((form) => {
      syncGiftCardRecipient(form);
    });

    document.addEventListener('cosme:product-updated', (event) => {
      const section = event.target.closest('[data-main-product]') || event.target;
      if (section?.matches?.('[data-main-product]')) observeStickyGallery(section);
      applyFormAttributeToExternalInputs(section);
      const form =
        section?.querySelector?.('[data-product-form]') || event.target.querySelector?.('[data-product-form]');
      if (form) syncGiftCardRecipient(form);
    });

    document.addEventListener('shopify:section:load', (event) => {
      const section = event.target.querySelector('[data-main-product]');
      if (section) observeStickyGallery(section);
      applyFormAttributeToExternalInputs(section || event.target);
      const form = event.target.querySelector('[data-product-form]');
      if (form) syncGiftCardRecipient(form);
    });

    desktopGalleryQuery.addEventListener('change', () => {
      document.querySelectorAll('[data-main-product]').forEach(observeStickyGallery);
    });

    window.addEventListener('resize', () => {
      document.querySelectorAll('[data-main-product]').forEach(syncStickyGallery);
    });
  })();
  document.addEventListener('click', function (e) {
    const link = e.target.closest('.cosme-main-product__rating-link');
    if (!link) return;
    const href = link.getAttribute('href');
    if (!href || !href.startsWith('#')) return;
    e.preventDefault();

    const tabsContainer = document.querySelector('.cosme-product-tabs');
    if (!tabsContainer) return;

    // Ищем кнопку вкладки Reviews
    const reviewTabButton = tabsContainer.querySelector('[data-product-tab][aria-controls="ProductReviews"]');
    if (reviewTabButton) {
      reviewTabButton.click(); // эмулируем клик
    }

    tabsContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
{% endjavascript %}

