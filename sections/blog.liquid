{% liquid
  assign heading_id = 'JournalHeading-' | append: section.id
  assign stories_id = 'JournalStories-' | append: section.id
  assign desktop_columns = section.settings.columns_desktop | default: '3' | plus: 0
  assign text_alignment = section.settings.text_alignment | default: 'left'
  assign section_spacing = section.settings.section_spacing | default: 'medium'

  assign heading = section.settings.heading | strip
  if heading == blank
    assign heading = blog.title
  endif

  assign eyebrow = section.settings.eyebrow | strip
  assign intro_description = section.settings.description | strip

  assign show_eyebrow = false
  if section.settings.show_eyebrow
    if eyebrow != blank
      assign show_eyebrow = true
    endif
  endif

  assign show_intro_description = false
  if section.settings.show_description
    if intro_description != blank
      assign show_intro_description = true
    endif
  endif

  assign tablet_columns = 2
  if desktop_columns >= 4
    assign tablet_columns = 3
  endif

  case desktop_columns
    when 4
      assign card_sizes = '(min-width: 990px) 24vw, (min-width: 768px) 42vw, 92vw'
      assign image_width = 720
    when 2
      assign card_sizes = '(min-width: 990px) 46vw, (min-width: 768px) 46vw, 92vw'
      assign image_width = 1100
    else
      assign card_sizes = '(min-width: 990px) 32vw, (min-width: 768px) 45vw, 92vw'
      assign image_width = 960
  endcase

  case section.settings.image_ratio
    when 'wide'
      assign aspect_ratio = '16/9'
      assign image_height = image_width | times: 9 | divided_by: 16
    when 'landscape'
      assign aspect_ratio = '3/2'
      assign image_height = image_width | times: 2 | divided_by: 3
    when 'square'
      assign aspect_ratio = '1/1'
      assign image_height = image_width
    else
      assign aspect_ratio = '4/5'
      assign image_height = image_width | times: 5 | divided_by: 4
  endcase

  assign featured_width = 1600
  case section.settings.featured_image_ratio
    when 'wide'
      assign featured_ratio = '16/9'
      assign featured_height = featured_width | times: 9 | divided_by: 16
    when 'portrait'
      assign featured_ratio = '4/5'
      assign featured_height = featured_width | times: 5 | divided_by: 4
    when 'square'
      assign featured_ratio = '1/1'
      assign featured_height = featured_width
    else
      assign featured_ratio = '16/10'
      assign featured_height = featured_width | times: 10 | divided_by: 16
  endcase

  assign articles_count = blog.articles_count | default: 0
%}

<section
  id="Journal-{{ section.id }}"
  class="cosme-journal full-width color-{{ section.settings.color_scheme }} cosme-journal--spacing-{{ section_spacing }} cosme-journal--align-{{ text_alignment }} cosme-journal--cols-{{ desktop_columns }}{% if settings.enable_animations %} cosme-journal--animated{% endif %}"
  style="
    --journal-cols: {{ desktop_columns }};
    --journal-cols-md: {{ tablet_columns }};
  "
  aria-labelledby="{{ heading_id }}"
  {{ section.shopify_attributes }}
>
  <div class="cosme-journal__inner">
    <header class="cosme-journal__intro">
      {% if show_eyebrow %}
        <p class="cosme-journal__eyebrow">{{ eyebrow | escape }}</p>
      {% endif %}

      <h1 class="cosme-journal__heading" id="{{ heading_id }}">{{ heading | escape }}</h1>

      {% if show_intro_description %}
        <p class="cosme-journal__description">{{ intro_description | escape }}</p>
      {% endif %}
    </header>

    {% if articles_count == 0 %}
      <p class="cosme-journal__empty">{{ 'blog.empty' | t }}</p>
    {% else %}
      {% paginate blog.articles by 12 %}
        {% liquid
          assign featured_article = blank
          assign featured_id = 0
          assign show_featured = false

          if section.settings.show_featured
            assign featured_article = section.settings.featured_article
            if featured_article != blank
              if featured_article.blog.id != blog.id
                assign featured_article = blank
              endif
            endif
            if featured_article == blank
              if paginate.current_page == 1
                assign featured_article = blog.articles.first
              endif
            endif
            if featured_article != blank
              assign featured_id = featured_article.id
              if paginate.current_page == 1
                assign show_featured = true
              endif
            endif
          endif

          assign featured_category = blog.title
        %}

        {% if show_featured %}
          <article class="cosme-journal__featured">
            <a
              class="cosme-journal__link cosme-journal__link--featured"
              href="{{ featured_article.url }}"
              aria-label="{{ 'blog.read_article_label' | t: title: featured_article.title | escape }}"
            >
              {% render 'cosme-article-card',
                article: featured_article,
                aspect_ratio: featured_ratio,
                image_width: featured_width,
                image_height: featured_height,
                sizes: '(min-width: 990px) min(52vw, 760px), 92vw',
                heading_tag: 'h2',
                loading: 'eager',
                fetchpriority: 'high',
                featured: true,
                show_excerpt: section.settings.show_featured_excerpt,
                show_date: section.settings.show_date,
                show_reading_time: section.settings.show_reading_time,
                show_category: section.settings.show_category,
                show_cta: section.settings.show_cta,
                show_index: false,
                category_label: featured_category,
                placeholder_name: 'image'
              %}
            </a>
          </article>
        {% endif %}

        {% capture journal_grid %}
          {% liquid
            assign rendered_index = 0
          %}
          {% for article in blog.articles %}
            {% liquid
              assign skip_article = false
              if featured_id != 0
                if article.id == featured_id
                  assign skip_article = true
                endif
              endif
            %}
            {% unless skip_article %}
              {% liquid
                assign rendered_index = rendered_index | plus: 1
                assign article_category = blog.title

                assign card_loading = 'lazy'
                assign card_fetchpriority = blank
                if paginate.current_page == 1
                  if show_featured == false
                    if forloop.index <= 3
                      assign card_loading = 'eager'
                      assign card_fetchpriority = 'high'
                    endif
                  endif
                endif
              %}
              <li class="cosme-journal__item">
                <a
                  class="cosme-journal__link"
                  href="{{ article.url }}"
                  aria-label="{{ 'blog.read_article_label' | t: title: article.title | escape }}"
                >
                  {% render 'cosme-article-card',
                    article: article,
                    aspect_ratio: aspect_ratio,
                    image_width: image_width,
                    image_height: image_height,
                    sizes: card_sizes,
                    heading_tag: 'h3',
                    loading: card_loading,
                    fetchpriority: card_fetchpriority,
                    featured: false,
                    show_excerpt: section.settings.show_excerpt,
                    show_date: section.settings.show_date,
                    show_reading_time: section.settings.show_reading_time,
                    show_category: section.settings.show_category,
                    show_cta: section.settings.show_cta,
                    show_index: section.settings.show_index,
                    card_index: rendered_index,
                    category_label: article_category,
                    placeholder_name: 'image'
                  %}
                </a>
              </li>
            {% endunless %}
          {% endfor %}
        {% endcapture %}

        {% assign journal_grid_markup = journal_grid | strip %}
        {% if journal_grid_markup != blank %}
          <div class="cosme-journal__stories">
            <h2 class="cosme-journal__stories-heading" id="{{ stories_id }}">
              {{ 'blog.latest_stories' | t }}
            </h2>
            <ul class="cosme-journal__grid" role="list" aria-labelledby="{{ stories_id }}">
              {{ journal_grid_markup }}
            </ul>
          </div>
        {% endif %}

        {% if paginate.pages > 1 %}
          {% assign current_page_label = paginate.current_page | append: '' %}
          <nav class="cosme-journal__pagination" aria-label="{{ 'blog.pagination' | t }}">
            {% if paginate.previous %}
              <a
                class="cosme-journal__page-link"
                href="{{ paginate.previous.url }}"
                rel="prev"
                aria-label="{{ 'blog.previous' | t }}"
              >
                {{ 'blog.previous' | t }}
              </a>
            {% endif %}

            <ol class="cosme-journal__pages" role="list">
              {% for part in paginate.parts %}
                <li>
                  {% if part.is_link %}
                    <a
                      class="cosme-journal__page-link"
                      href="{{ part.url }}"
                      aria-label="{{ 'blog.page' | t: page: part.title }}"
                    >
                      {{ part.title }}
                    </a>
                  {% elsif part.title == current_page_label %}
                    <span
                      class="cosme-journal__page-link cosme-journal__page-link--current"
                      aria-current="page"
                      aria-label="{{ 'blog.page' | t: page: part.title }}"
                    >
                      {{ part.title }}
                    </span>
                  {% else %}
                    <span class="cosme-journal__page-ellipsis" aria-hidden="true">{{ part.title }}</span>
                  {% endif %}
                </li>
              {% endfor %}
            </ol>

            {% if paginate.next %}
              <a
                class="cosme-journal__page-link"
                href="{{ paginate.next.url }}"
                rel="next"
                aria-label="{{ 'blog.next' | t }}"
              >
                {{ 'blog.next' | t }}
              </a>
            {% endif %}
          </nav>
        {% endif %}
      {% endpaginate %}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cosme-journal {
    overflow-x: clip;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .cosme-journal__inner {
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    min-width: 0;
  }

  .cosme-journal--spacing-small .cosme-journal__inner {
    padding-block: calc(var(--spacing-section) * 0.4);
  }

  .cosme-journal--spacing-medium .cosme-journal__inner {
    padding-block: clamp(1.5rem, 3.5vw, calc(var(--spacing-section) * 0.65));
  }

  .cosme-journal--spacing-large .cosme-journal__inner {
    padding-block: clamp(2rem, 4.5vw, var(--spacing-section));
  }

  .cosme-journal__intro {
    max-width: 38rem;
    margin-block-end: var(--spacing-xl);
  }

  .cosme-journal--align-center .cosme-journal__intro {
    margin-inline: auto;
    text-align: center;
  }

  .cosme-journal__eyebrow {
    margin: 0 0 var(--spacing-sm);
    font-size: 0.6875rem;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-journal__heading {
    margin: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-heading, var(--color-foreground));
  }

  .cosme-journal__description {
    margin: var(--spacing-sm) 0 0;
    max-width: 32rem;
    overflow-wrap: anywhere;
    font-size: 0.9375rem;
    line-height: var(--line-height-body);
    color: var(--color-muted);
  }

  .cosme-journal--align-center .cosme-journal__description {
    margin-inline: auto;
  }

  .cosme-journal__empty {
    margin: 0;
    max-width: 32rem;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: var(--line-height-body);
  }

  .cosme-journal--align-center .cosme-journal__empty {
    margin-inline: auto;
    text-align: center;
  }

  .cosme-journal__featured {
    margin-block-end: var(--spacing-2xl);
    padding-block-end: var(--spacing-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  .cosme-journal__link--featured {
    display: block;
  }

  .cosme-journal__stories-heading {
    margin: 0 0 var(--spacing-lg);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cosme-journal--align-center .cosme-journal__stories-heading {
    text-align: center;
  }

  .cosme-journal__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--grid-gap);
    row-gap: calc(var(--grid-gap) * 1.45);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cosme-journal__item {
    min-width: 0;
  }

  .cosme-journal__link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-card);
  }

  .cosme-journal__link:hover {
    color: inherit;
  }

  .cosme-journal__link:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-accent);
    outline-offset: 4px;
  }

  .cosme-journal__pagination,
  .cosme-journal__pages {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm) var(--spacing-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cosme-journal__pagination {
    margin-block-start: var(--spacing-2xl);
  }

  .cosme-journal__page-link,
  .cosme-journal__page-ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .cosme-journal__page-link:focus-visible {
    color: var(--color-foreground);
    outline: var(--focus-ring-width) solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .cosme-journal__page-link:hover {
      color: var(--color-foreground);
    }
  }

  .cosme-journal__page-link--current {
    color: var(--color-foreground);
    box-shadow: inset 0 -1px 0 var(--color-foreground);
  }

  @media screen and (min-width: 768px) {
    .cosme-journal__grid {
      grid-template-columns: repeat(var(--journal-cols-md), minmax(0, 1fr));
    }

    .cosme-journal__intro {
      margin-block-end: var(--spacing-xl);
    }

    .cosme-journal--align-left .cosme-journal__featured .cosme-article-card__excerpt {
      max-width: 40rem;
    }
  }

  @media screen and (min-width: 990px) {
    .cosme-journal__grid {
      grid-template-columns: repeat(var(--journal-cols), minmax(0, 1fr));
    }

    .cosme-journal--cols-3 .cosme-article-card__title {
      font-size: clamp(1.25rem, 1.45vw, 1.625rem);
    }

    .cosme-journal--cols-4 .cosme-article-card__title {
      font-size: 1.125rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "enabled_on": {
    "templates": ["blog"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.blog.settings.eyebrow",
      "default": "The journal"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "t:sections.blog.settings.show_eyebrow",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Beauty, thoughtfully curated."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.blog.settings.description",
      "default": "Stories, rituals and insights for a more considered approach to beauty."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.blog.settings.show_description",
      "default": true
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.blog.settings.text_alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:sections.blog.settings.featured_header"
    },
    {
      "type": "checkbox",
      "id": "show_featured",
      "label": "t:sections.blog.settings.show_featured",
      "default": true
    },
    {
      "type": "article",
      "id": "featured_article",
      "label": "t:sections.blog.settings.featured_article",
      "info": "t:sections.blog.settings.featured_article_info"
    },
    {
      "type": "select",
      "id": "featured_image_ratio",
      "label": "t:sections.blog.settings.featured_image_ratio",
      "options": [
        { "value": "landscape", "label": "t:sections.blog.settings.ratio_landscape" },
        { "value": "wide", "label": "t:sections.blog.settings.ratio_wide" },
        { "value": "portrait", "label": "t:sections.blog.settings.ratio_portrait" },
        { "value": "square", "label": "t:sections.blog.settings.ratio_square" }
      ],
      "default": "landscape",
      "visible_if": "{{ section.settings.show_featured }}"
    },
    {
      "type": "checkbox",
      "id": "show_featured_excerpt",
      "label": "t:sections.blog.settings.show_featured_excerpt",
      "default": true,
      "visible_if": "{{ section.settings.show_featured }}"
    },
    {
      "type": "header",
      "content": "t:sections.blog.settings.grid_header"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.blog.settings.columns_desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.blog.settings.image_ratio",
      "options": [
        { "value": "portrait", "label": "t:sections.blog.settings.ratio_portrait" },
        { "value": "square", "label": "t:sections.blog.settings.ratio_square" },
        { "value": "landscape", "label": "t:sections.blog.settings.ratio_landscape" },
        { "value": "wide", "label": "t:sections.blog.settings.ratio_wide" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "t:sections.blog.settings.show_category",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:sections.blog.settings.show_excerpt",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:sections.blog.settings.show_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reading_time",
      "label": "t:sections.blog.settings.show_reading_time",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_index",
      "label": "t:sections.blog.settings.show_index",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "t:sections.blog.settings.show_cta",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:labels.section_spacing"
    },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "small", "label": "t:options.size.small" },
        { "value": "medium", "label": "t:options.size.medium" },
        { "value": "large", "label": "t:options.size.large" }
      ],
      "default": "medium"
    }
  ],
  "presets": [
    {
      "name": "t:general.blog"
    }
  ]
}
{% endschema %}
