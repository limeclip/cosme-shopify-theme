{% liquid
  assign layout = section.settings.layout | default: 'fullscreen'
  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign media_position = section.settings.media_position | default: 'left'
  assign align_x = section.settings.horizontal_alignment | default: 'left'
  assign align_y = section.settings.vertical_alignment | default: 'bottom'
  assign text_width = section.settings.text_width | default: 'medium'
  assign desktop_height = section.settings.desktop_height | default: '75vh'
  assign mobile_height = section.settings.mobile_height | default: '85vh'
  assign overlay_opacity = section.settings.overlay_opacity | default: 35
  assign color_scheme = section.settings.color_scheme | default: 'scheme-1'
  assign controls_color = section.settings.controls_color | default: 'auto'
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign slide_count = slide_blocks.size
  assign autoplay_enabled = section.settings.autoplay
  assign autoplay_delay = section.settings.autoplay_delay | default: 5000
  assign section_width = section.settings.section_width | default: 'full'
  assign grid_desktop_items = section.settings.grid_desktop_items | default: '3'
  assign grid_mobile_items = section.settings.grid_mobile_items | default: '1.2'
  assign grid_content_position = section.settings.grid_content_position | default: 'below'
  assign grid_image_ratio = section.settings.grid_image_ratio | default: 'portrait'
  assign is_grid = false

  if layout == 'grid'
    assign is_grid = true
  endif

  case section.settings.grid_gap
    when 'small'
      assign grid_gap_token = 'var(--spacing-sm)'
    when 'large'
      assign grid_gap_token = 'var(--spacing-xl)'
    else
      assign grid_gap_token = 'var(--grid-gap)'
  endcase

  case grid_image_ratio
    when 'square'
      assign grid_ratio_value = '1 / 1'
    when 'landscape'
      assign grid_ratio_value = '3 / 2'
    else
      assign grid_ratio_value = '4 / 5'
  endcase

  assign emh_placeholder_invert = 0
  assign emh_scheme_id = section.settings.color_scheme
  if section.settings.color_scheme.id != blank
    assign emh_scheme_id = section.settings.color_scheme.id
  endif
  for emh_scheme in settings.color_schemes
    if emh_scheme.id == emh_scheme_id
      if emh_scheme.settings.background != blank
        assign emh_bg_brightness = emh_scheme.settings.background | color_brightness
        if emh_bg_brightness < 128
          assign emh_placeholder_invert = 1
        endif
      endif
    endif
  endfor

  if heading_tag != 'h1'
    if heading_tag != 'h2'
      if heading_tag != 'h3'
        assign heading_tag = 'h1'
      endif
    endif
  endif

  if slide_count <= 1
    assign autoplay_enabled = false
  endif

  assign status_current = 1 | prepend: '00' | slice: -2, 2
  assign status_total = slide_count | prepend: '00' | slice: -2, 2

  case desktop_height
    when '60vh'
      assign desktop_height_value = '60vh'
    when '75vh'
      assign desktop_height_value = '75vh'
    when '100vh'
      assign desktop_height_value = '100svh'
    else
      assign desktop_height_value = 'auto'
  endcase

  case mobile_height
    when '70vh'
      assign mobile_height_value = '70vh'
    when '85vh'
      assign mobile_height_value = '85vh'
    when '100vh'
      assign mobile_height_value = '100svh'
    else
      assign mobile_height_value = 'auto'
  endcase

  if layout == 'split'
    assign image_sizes = '(min-width: 990px) 55vw, 100vw'
  elsif layout == 'grid'
    assign image_sizes = '(min-width: 990px) 32vw, 80vw'
  else
    assign image_sizes = '100vw'
  endif
%}

<section
  id="EditorialMediaHero-{{ section.id }}"
  class="
    cosme-editorial-media-hero
    full-width
    cosme-editorial-media-hero--width-{{ section_width }}
    color-{{ color_scheme }}
    cosme-editorial-media-hero--{{ layout }}
    cosme-editorial-media-hero--media-{{ media_position }}
    cosme-editorial-media-hero--x-{{ align_x }}
    cosme-editorial-media-hero--y-{{ align_y }}
    cosme-editorial-media-hero--text-{{ text_width }}
    cosme-editorial-media-hero--desktop-{{ desktop_height }}
    cosme-editorial-media-hero--mobile-{{ mobile_height }}
    {% if is_grid %}cosme-editorial-media-hero--content-{{ grid_content_position }}{% endif %}
    {% if emh_placeholder_invert == 1 %}cosme-editorial-media-hero--placeholder-invert{% endif %}
    {% unless controls_color == 'auto' %}cosme-editorial-media-hero--controls-{{ controls_color }}{% endunless %}
    {% if settings.enable_animations %}cosme-editorial-media-hero--animated{% endif %}
  "
  style="
    --emh-overlay: {{ overlay_opacity }};
    --emh-height-desktop: {{ desktop_height_value }};
    --emh-height-mobile: {{ mobile_height_value }};
    --emh-gap: {{ grid_gap_token }};
    --emh-cols-desktop: {{ grid_desktop_items }};
    --emh-cols-mobile: {{ grid_mobile_items }};
    --emh-ratio: {{ grid_ratio_value }};
  "
  data-editorial-media-hero
  data-layout="{{ layout }}"
  data-section-id="{{ section.id }}"
  data-slide-count="{{ slide_count }}"
  data-autoplay="{{ autoplay_enabled }}"
  data-autoplay-delay="{{ autoplay_delay }}"
  data-enable-animations="{{ settings.enable_animations }}"
  aria-roledescription="carousel"
  aria-label="{{ 'sections.editorial_media_hero.landmark_label' | t }}"
  {{ section.shopify_attributes }}
>
  <div class="cosme-editorial-media-hero__inner">
    <div class="cosme-editorial-media-hero__viewport" data-emh-viewport>
      <div class="cosme-editorial-media-hero__track" data-emh-track>
      {%- if slide_count > 0 -%}
        {%- for block in slide_blocks -%}
          {%- liquid
            assign media_type = block.settings.media_type | default: 'image'
            assign desktop_image = block.settings.image
            assign mobile_image = block.settings.mobile_image
            assign desktop_video = block.settings.video
            assign mobile_video = block.settings.mobile_video
            assign has_desktop_image = false
            assign has_mobile_image = false
            assign has_image = false
            assign desktop_video_playable = false
            assign mobile_video_playable = false
            assign use_video = false
            assign render_dual_video = false
            assign hydrate_video = false
            assign media_is_decorative = false

            if desktop_image != blank
              assign has_desktop_image = true
              assign has_image = true
            endif
            if mobile_image != blank
              assign has_mobile_image = true
              assign has_image = true
            endif

            assign hero_image = desktop_image
            if has_desktop_image == false
              if has_mobile_image
                assign hero_image = mobile_image
              endif
            endif

            if desktop_video != blank
              if desktop_video.sources.size > 0
                assign desktop_video_playable = true
              endif
            endif
            if mobile_video != blank
              if mobile_video.sources.size > 0
                assign mobile_video_playable = true
              endif
            endif

            if media_type == 'video'
              if desktop_video_playable
                assign use_video = true
              endif
              if mobile_video_playable
                assign use_video = true
              endif
            endif

            if desktop_video_playable
              if mobile_video_playable
                if desktop_video.id != mobile_video.id
                  assign render_dual_video = true
                endif
              endif
            endif

            assign slide_alt = block.settings.image_alt | strip
            if slide_alt == blank
              if hero_image != blank
                if hero_image.alt != blank
                  assign slide_alt = hero_image.alt
                endif
              endif
            endif
            if slide_alt == blank
              if use_video
                if desktop_video != blank
                  if desktop_video.alt != blank
                    assign slide_alt = desktop_video.alt
                  endif
                endif
              endif
            endif
            if slide_alt == blank
              if block.settings.heading != blank
                assign slide_alt = block.settings.heading
              endif
            endif

            if block.settings.heading != blank
              assign media_is_decorative = true
            endif
            if block.settings.eyebrow != blank
              assign media_is_decorative = true
            endif
            if block.settings.text != blank
              assign media_is_decorative = true
            endif

            assign focal_css = 'center center'
            case block.settings.image_focal_position
              when 'top'
                assign focal_css = 'top center'
              when 'bottom'
                assign focal_css = 'bottom center'
              when 'left'
                assign focal_css = 'center left'
              when 'right'
                assign focal_css = 'center right'
              when 'top_left'
                assign focal_css = 'top left'
              when 'top_right'
                assign focal_css = 'top right'
              when 'bottom_left'
                assign focal_css = 'bottom left'
              when 'bottom_right'
                assign focal_css = 'bottom right'
            endcase

            if forloop.first
              assign slide_loading = 'eager'
              assign slide_fetchpriority = 'high'
              if settings.enable_animations
                assign hydrate_video = true
              endif
            else
              assign slide_loading = 'lazy'
              assign slide_fetchpriority = 'low'
            endif

            assign heading_id = 'EditorialMediaHeroHeading-' | append: section.id | append: '-' | append: block.id
            assign desktop_poster = blank
            assign mobile_poster = blank

            if use_video
              if desktop_video_playable
                assign desktop_poster = desktop_video.preview_image
              elsif mobile_video_playable
                assign desktop_poster = mobile_video.preview_image
              endif
              if desktop_poster == blank
                assign desktop_poster = hero_image
              endif

              if mobile_video_playable
                assign mobile_poster = mobile_video.preview_image
              elsif desktop_video_playable
                assign mobile_poster = desktop_video.preview_image
              endif
              if mobile_poster == blank
                if has_mobile_image
                  assign mobile_poster = mobile_image
                else
                  assign mobile_poster = desktop_poster
                endif
              endif
            endif
          -%}
          {%- liquid
            assign slide_style_extra = ''
            assign emh_allow_slide_align = false
            if layout == 'fullscreen'
              assign emh_allow_slide_align = true
            endif
            if layout == 'large'
              assign emh_allow_slide_align = true
            endif
            if emh_allow_slide_align
              case block.settings.slide_alignment_x
                when 'left'
                  assign slide_style_extra = slide_style_extra | append: '--emh-x-justify: flex-start; --emh-x-text: left; --emh-x-justify-copy: start; --emh-x-text-margin-inline: 0; --emh-x-text-margin-start: 0;'
                when 'center'
                  assign slide_style_extra = slide_style_extra | append: '--emh-x-justify: center; --emh-x-text: center; --emh-x-justify-copy: center; --emh-x-text-margin-inline: auto; --emh-x-text-margin-start: auto;'
                when 'right'
                  assign slide_style_extra = slide_style_extra | append: '--emh-x-justify: flex-end; --emh-x-text: left; --emh-x-justify-copy: start; --emh-x-text-margin-inline: 0; --emh-x-text-margin-start: 0;'
              endcase
              case block.settings.slide_alignment_y
                when 'top'
                  assign slide_style_extra = slide_style_extra | append: ' --emh-y-align: flex-start;'
                when 'center'
                  assign slide_style_extra = slide_style_extra | append: ' --emh-y-align: center;'
                when 'bottom'
                  assign slide_style_extra = slide_style_extra | append: ' --emh-y-align: flex-end;'
              endcase
            endif
          -%}
          <article
            class="cosme-editorial-media-hero__slide{% if forloop.first %} is-active{% endif %}{% if block.settings.content_color == 'light' %} cosme-editorial-media-hero__slide--content-light{% endif %}{% if block.settings.content_color == 'dark' %} cosme-editorial-media-hero__slide--content-dark{% endif %}"
            data-emh-slide
            data-slide-index="{{ forloop.index0 }}"
            {% if use_video %}
              data-emh-has-video
            {% endif %}
            role="group"
            aria-roledescription="slide"
            aria-label="{{ 'sections.editorial_media_hero.slide_label' | t: number: forloop.index, total: slide_count }}"
            {% if is_grid == false %}
              {% unless forloop.first %}
                inert
                aria-hidden="true"
              {% endunless %}
            {% endif %}
            style="--emh-focal: {{ focal_css }}; {{ slide_style_extra }}"
            {{ block.shopify_attributes }}
          >
            <div class="cosme-editorial-media-hero__media">
              {%- if use_video -%}
                {%- if desktop_poster != blank -%}
                  {%- if desktop_poster != blank
                    and mobile_poster != blank
                    and desktop_poster.id != mobile_poster.id
                  -%}
                    <picture class="cosme-editorial-media-hero__poster" aria-hidden="true">
                      <source
                        media="(max-width: 749px)"
                        srcset="
                          {{ mobile_poster | image_url: width: 500 }} 500w,
                          {{ mobile_poster | image_url: width: 750 }} 750w,
                          {{ mobile_poster | image_url: width: 1000 }} 1000w,
                          {{ mobile_poster | image_url: width: 1400 }} 1400w
                        "
                        sizes="100vw"
                      >
                      {{
                        desktop_poster
                        | image_url: width: 2400
                        | image_tag:
                          class: 'cosme-editorial-media-hero__img',
                          alt: '',
                          loading: slide_loading,
                          fetchpriority: slide_fetchpriority,
                          widths: '750, 990, 1200, 1500, 1800, 2400',
                          sizes: image_sizes
                      }}
                    </picture>
                  {%- else -%}
                    {% render 'cosme-image',
                      image: desktop_poster,
                      alt: '',
                      class: 'cosme-editorial-media-hero__poster',
                      width: 2400,
                      sizes: image_sizes,
                      loading: slide_loading,
                      fetchpriority: slide_fetchpriority
                    %}
                  {%- endif -%}
                {%- else -%}
                  <div
                    class="cosme-editorial-media-hero__placeholder cosme-editorial-media-hero__poster"
                    aria-hidden="true"
                  >
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'cosme-editorial-media-hero__placeholder-svg' }}
                  </div>
                {%- endif -%}

                {%- if render_dual_video -%}
                  <video
                    class="cosme-editorial-media-hero__video cosme-editorial-media-hero__video--desktop"
                    data-emh-video
                    playsinline
                    muted
                    loop
                    preload="none"
                    disablepictureinpicture
                    {% if hydrate_video %}
                      autoplay
                    {% endif %}
                    {% if desktop_poster != blank %}
                      poster="{{ desktop_poster | image_url: width: 1800 }}"
                    {% endif %}
                    {% if media_is_decorative %}
                      aria-hidden="true"
                    {% elsif slide_alt != blank %}
                      aria-label="{{ slide_alt | escape }}"
                    {% endif %}
                  >
                    {%- for source in desktop_video.sources -%}
                      <source
                        {% if hydrate_video %}
                          src="{{ source.url }}"
                        {% else %}
                          data-src="{{ source.url }}"
                        {% endif %}
                        type="{{ source.mime_type }}"
                      >
                    {%- endfor -%}
                  </video>
                  <video
                    class="cosme-editorial-media-hero__video cosme-editorial-media-hero__video--mobile"
                    data-emh-video
                    playsinline
                    muted
                    loop
                    preload="none"
                    disablepictureinpicture
                    {% if mobile_poster != blank %}
                      poster="{{ mobile_poster | image_url: width: 1200 }}"
                    {% endif %}
                    {% if media_is_decorative %}
                      aria-hidden="true"
                    {% elsif slide_alt != blank %}
                      aria-label="{{ slide_alt | escape }}"
                    {% endif %}
                  >
                    {%- for source in mobile_video.sources -%}
                      <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
                    {%- endfor -%}
                  </video>
                {%- else -%}
                  {%- liquid
                    assign single_video = desktop_video
                    if desktop_video_playable == false
                      assign single_video = mobile_video
                    endif
                    assign single_poster = desktop_poster
                  -%}
                  <video
                    class="cosme-editorial-media-hero__video"
                    data-emh-video
                    playsinline
                    muted
                    loop
                    preload="none"
                    disablepictureinpicture
                    {% if hydrate_video %}
                      autoplay
                    {% endif %}
                    {% if single_poster != blank %}
                      poster="{{ single_poster | image_url: width: 1800 }}"
                    {% endif %}
                    {% if media_is_decorative %}
                      aria-hidden="true"
                    {% elsif slide_alt != blank %}
                      aria-label="{{ slide_alt | escape }}"
                    {% endif %}
                  >
                    {%- for source in single_video.sources -%}
                      <source
                        {% if hydrate_video %}
                          src="{{ source.url }}"
                        {% else %}
                          data-src="{{ source.url }}"
                        {% endif %}
                        type="{{ source.mime_type }}"
                      >
                    {%- endfor -%}
                  </video>
                {%- endif -%}
              {%- elsif has_image -%}
                {%- if has_desktop_image and has_mobile_image -%}
                  <picture>
                    <source
                      media="(max-width: 749px)"
                      srcset="
                        {{ mobile_image | image_url: width: 500 }} 500w,
                        {{ mobile_image | image_url: width: 750 }} 750w,
                        {{ mobile_image | image_url: width: 1000 }} 1000w,
                        {{ mobile_image | image_url: width: 1400 }} 1400w
                      "
                      sizes="100vw"
                    >
                    {{
                      desktop_image
                      | image_url: width: 2400
                      | image_tag:
                        class: 'cosme-editorial-media-hero__img',
                        alt: slide_alt,
                        loading: slide_loading,
                        fetchpriority: slide_fetchpriority,
                        widths: '750, 990, 1200, 1500, 1800, 2400',
                        sizes: image_sizes
                    }}
                  </picture>
                {%- else -%}
                  {% render 'cosme-image',
                    image: hero_image,
                    alt: slide_alt,
                    class: 'cosme-editorial-media-hero__image',
                    width: 2400,
                    sizes: image_sizes,
                    loading: slide_loading,
                    fetchpriority: slide_fetchpriority
                  %}
                {%- endif -%}
              {%- else -%}
                <div
                  class="cosme-editorial-media-hero__placeholder"
                  {% if slide_alt != blank %}
                    role="img"
                    aria-label="{{ slide_alt | escape }}"
                  {% else %}
                    aria-hidden="true"
                  {% endif %}
                >
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'cosme-editorial-media-hero__placeholder-svg' }}
                </div>
              {%- endif -%}
              <span class="cosme-editorial-media-hero__overlay" aria-hidden="true"></span>
            </div>

            <div class="cosme-editorial-media-hero__content">
              <div class="cosme-editorial-media-hero__copy">
                {%- if block.settings.eyebrow != blank -%}
                  <p class="cosme-editorial-media-hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>
                {%- endif -%}

                {%- if block.settings.heading != blank -%}
                  <{{ heading_tag }}
                    class="cosme-editorial-media-hero__heading"
                    {% if forloop.first %}
                      id="{{ heading_id }}"
                    {% endif %}
                  >
                    {{ block.settings.heading | escape }}
                  </{{ heading_tag }}>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="cosme-editorial-media-hero__text">
                    {{ block.settings.text | escape | newline_to_br }}
                  </div>
                {%- endif -%}

                {%- if block.settings.primary_button_label != blank
                  or block.settings.secondary_button_label != blank
                -%}
                  <div class="cosme-editorial-media-hero__actions">
                    {%- if block.settings.primary_button_label != blank -%}
                      {% render 'cosme-button',
                        label: block.settings.primary_button_label,
                        url: block.settings.primary_button_link,
                        style: 'primary',
                        class: 'cosme-editorial-media-hero__button'
                      %}
                    {%- endif -%}
                    {%- if block.settings.secondary_button_label != blank -%}
                      {% render 'cosme-button',
                        label: block.settings.secondary_button_label,
                        url: block.settings.secondary_button_link,
                        style: 'secondary',
                        class: 'cosme-editorial-media-hero__button'
                      %}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        <article
          class="cosme-editorial-media-hero__slide is-active"
          data-emh-slide
          data-slide-index="0"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ 'sections.editorial_media_hero.slide_label' | t: number: 1, total: 1 }}"
        >
          <div class="cosme-editorial-media-hero__media">
            <div
              class="cosme-editorial-media-hero__placeholder"
              role="img"
              aria-label="{{ 'sections.editorial_media_hero.image_placeholder' | t }}"
            >
              {{ 'lifestyle-1' | placeholder_svg_tag: 'cosme-editorial-media-hero__placeholder-svg' }}
            </div>
            <span class="cosme-editorial-media-hero__overlay" aria-hidden="true"></span>
          </div>
          <div class="cosme-editorial-media-hero__content">
            <div class="cosme-editorial-media-hero__copy"></div>
          </div>
        </article>
      {%- endif -%}
      </div>
    </div>

    {%- if slide_count > 1 -%}
      <div class="cosme-editorial-media-hero__controls">
        <div class="cosme-editorial-media-hero__nav">
          <button
            type="button"
            class="cosme-editorial-media-hero__arrow"
            data-emh-prev
            aria-label="{{ 'sections.editorial_media_hero.previous_slide' | t }}"
          >
            {% render 'cosme-icon', icon: 'chevron-left' %}
          </button>
          <button
            type="button"
            class="cosme-editorial-media-hero__arrow"
            data-emh-next
            aria-label="{{ 'sections.editorial_media_hero.next_slide' | t }}"
          >
            {% render 'cosme-icon', icon: 'chevron-right' %}
          </button>
        </div>

        <p
          class="cosme-editorial-media-hero__status"
          data-emh-status
          aria-live="polite"
          aria-atomic="true"
        >
          {{ 'sections.editorial_media_hero.slide_status' | t: current: status_current, total: status_total }}
        </p>

        <div
          class="cosme-editorial-media-hero__pagination"
          role="group"
          aria-label="{{ 'sections.editorial_media_hero.slide_controls' | t }}"
        >
          {%- for block in slide_blocks -%}
            <button
              type="button"
              class="cosme-editorial-media-hero__dot{% if forloop.first %} is-active{% endif %}"
              data-emh-dot="{{ forloop.index0 }}"
              aria-label="{{ 'sections.editorial_media_hero.slide_label' | t: number: forloop.index, total: slide_count }}"
              {% if forloop.first %}
                aria-current="true"
              {% endif %}
            ></button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .cosme-editorial-media-hero {
    --emh-min-height: var(--emh-height-mobile, 85vh);
    --emh-placeholder-invert: 0;
    --emh-controls-color: var(--color-slider-arrows, var(--color-foreground));
    --emh-controls-dot: color-mix(in srgb, var(--color-foreground) 35%, transparent);
    --emh-controls-dot-active: var(--color-foreground);
    --emh-x-justify: flex-start;
    --emh-x-text: left;
    --emh-x-justify-copy: start;
    --emh-x-text-margin-inline: 0;
    --emh-x-text-margin-start: 0;
    --emh-y-align: flex-end;

    position: relative;
    overflow: hidden;
    width: 100%;
    color: var(--color-foreground);
    background-color: var(--color-background);
  }

  .cosme-editorial-media-hero--controls-light.cosme-editorial-media-hero--fullscreen,
  .cosme-editorial-media-hero--controls-light.cosme-editorial-media-hero--large {
    --emh-controls-color: color-mix(in srgb, white 88%, var(--color-background) 12%);
    --emh-controls-dot: color-mix(in srgb, white 40%, transparent);
    --emh-controls-dot-active: color-mix(in srgb, white 90%, transparent);
  }

  .cosme-editorial-media-hero--controls-dark.cosme-editorial-media-hero--fullscreen,
  .cosme-editorial-media-hero--controls-dark.cosme-editorial-media-hero--large {
    --emh-controls-color: color-mix(in srgb, black 78%, var(--color-foreground) 22%);
    --emh-controls-dot: color-mix(in srgb, black 35%, transparent);
    --emh-controls-dot-active: color-mix(in srgb, black 80%, transparent);
  }

  .cosme-editorial-media-hero--x-center {
