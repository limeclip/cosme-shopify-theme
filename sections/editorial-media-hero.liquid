    const initHero = (root) => {
      if (!root || instances.has(root)) return;

      const slides = Array.from(root.querySelectorAll('[data-emh-slide]'));
      if (slides.length === 0) return;

      const prevButton = root.querySelector('[data-emh-prev]');
      const nextButton = root.querySelector('[data-emh-next]');
      const dots = Array.from(root.querySelectorAll('[data-emh-dot]'));
      const status = root.querySelector('[data-emh-status]');
      const autoplayEnabled = root.getAttribute('data-autoplay') === 'true';
      const autoplayDelay = Math.max(2000, Number(root.getAttribute('data-autoplay-delay')) || 5000);
      const hasSlider = slides.length > 1;
      const isGrid = root.getAttribute('data-layout') === 'grid';
      const viewport = root.querySelector('[data-emh-viewport]');
      const isOverlayGrid = isGrid && root.classList.contains('cosme-editorial-media-hero--content-overlay');

      let currentIndex = Math.max(
        0,
        slides.findIndex((slide) => slide.classList.contains('is-active'))
      );
      if (currentIndex < 0) currentIndex = 0;

      let autoplayTimer = 0;
      let visible = true;
      let focusedInside = false;
      let userPaused = false;

      const cleanupFns = [];

      const on = (target, event, handler, options) => {
        target.addEventListener(event, handler, options);
        cleanupFns.push(() => target.removeEventListener(event, handler, options));
      };

      root.querySelectorAll('[data-emh-video]').forEach((video) => {
        const markUnavailable = () => {
          video.classList.add('is-unavailable');
          pauseVideo(video, false);
        };

        on(video, 'error', markUnavailable);
        video.querySelectorAll('source').forEach((source) => on(source, 'error', markUnavailable));
      });

      const stopAutoplay = () => {
        if (autoplayTimer) {
          window.clearTimeout(autoplayTimer);
          autoplayTimer = 0;
        }
      };

      const canAutoplay = () =>
        hasSlider &&
        autoplayEnabled &&
        allowMotion(root) &&
        visible &&
        !document.hidden &&
        !focusedInside &&
        !userPaused;

      const updateChrome = (nextIndex) => {
        slides.forEach((slide, slideIndex) => {
          const isActive = slideIndex === nextIndex;
          slide.classList.toggle('is-active', isActive);

          if (isGrid) {
            slide.removeAttribute('inert');
            slide.removeAttribute('aria-hidden');
            if (isOverlayGrid) {
              const content = slide.querySelector('.cosme-editorial-media-hero__content');
              if (content) {
                if (isActive) {
                  content.removeAttribute('aria-hidden');
                } else {
                  content.setAttribute('aria-hidden', 'true');
                }
              }
            }
            return;
          }

          if (isActive) {
            slide.removeAttribute('inert');
            slide.setAttribute('aria-hidden', 'false');
          } else {
            slide.setAttribute('inert', '');
            slide.setAttribute('aria-hidden', 'true');
            pauseSlideVideos(slide, true);
          }
        });

        dots.forEach((dot, dotIndex) => {
          const isActive = dotIndex === nextIndex;
          dot.classList.toggle('is-active', isActive);
          if (isActive) {
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.removeAttribute('aria-current');
          }
        });

        if (status) {
          const label = slides[nextIndex]?.getAttribute('aria-label') || '';
          status.textContent = `${pad(nextIndex + 1)} / ${pad(slides.length)}`;
          if (label) status.setAttribute('aria-label', label);
        }
      };

      const slideIsVisible = (slide) => {
        if (!viewport) return false;
        const slideRect = slide.getBoundingClientRect();
        const viewRect = viewport.getBoundingClientRect();
        return slideRect.right > viewRect.left + 12 && slideRect.left < viewRect.right - 12;
      };

      const syncVideos = () => {
        slides.forEach((slide, slideIndex) => {
          const shouldPlay = isGrid
            ? visible && !document.hidden && slideIsVisible(slide)
            : slideIndex === currentIndex && visible && !document.hidden;

          if (shouldPlay) {
            playSlideVideos(root, slide);
          } else {
            pauseSlideVideos(slide, true);
          }
        });
      };

      const closestSlideIndex = () => {
        if (!viewport) return currentIndex;
        const left = viewport.scrollLeft;
        let closest = 0;
        let min = Number.POSITIVE_INFINITY;
        slides.forEach((slide, index) => {
          const dist = Math.abs(slide.offsetLeft - left);
          if (dist < min) {
            min = dist;
            closest = index;
          }
        });
        return closest;
      };

      const goTo = (index, fromScroll) => {
        const nextIndex = (index + slides.length) % slides.length;

        if (nextIndex !== currentIndex) {
          updateChrome(nextIndex);
          currentIndex = nextIndex;
        }

        if (isGrid && viewport && fromScroll !== true) {
          const behavior = allowMotion(root) ? 'smooth' : 'auto';
          viewport.scrollTo({ left: slides[nextIndex].offsetLeft, behavior });
        }

        syncVideos();
      };

      const scheduleAutoplay = () => {
        stopAutoplay();
        if (!canAutoplay()) return;

        autoplayTimer = window.setTimeout(() => {
          autoplayTimer = 0;
          if (!canAutoplay()) return;
          goTo(currentIndex + 1);
          scheduleAutoplay();
        }, autoplayDelay);
      };

      const pauseForInteraction = () => {
        userPaused = true;
        stopAutoplay();
        window.setTimeout(() => {
          userPaused = false;
          scheduleAutoplay();
        }, autoplayDelay);
      };

      if (hasSlider && prevButton) {
        on(prevButton, 'click', () => {
          pauseForInteraction();
          goTo(currentIndex - 1);
        });
      }

      if (hasSlider && nextButton) {
        on(nextButton, 'click', () => {
          pauseForInteraction();
          goTo(currentIndex + 1);
        });
      }

      if (isGrid && viewport) {
        let scrollTick = 0;
        on(
          viewport,
          'scroll',
          () => {
            if (scrollTick) return;
            scrollTick = window.requestAnimationFrame(() => {
              scrollTick = 0;
              const nextIndex = closestSlideIndex();
              if (nextIndex === currentIndex) {
                syncVideos();
                return;
              }
              pauseForInteraction();
              goTo(nextIndex, true);
            });
          },
          { passive: true }
        );
      }

      if (hasSlider) {
        dots.forEach((dot) => {
          on(dot, 'click', () => {
            const index = Number.parseInt(dot.getAttribute('data-emh-dot'), 10);
            if (Number.isNaN(index)) return;
            pauseForInteraction();
            goTo(index);
          });
        });

        on(root, 'keydown', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          if (!target.closest('[data-emh-prev], [data-emh-next], [data-emh-dot]')) return;

          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            pauseForInteraction();
            goTo(currentIndex - 1);
          }

          if (event.key === 'ArrowRight') {
            event.preventDefault();
            pauseForInteraction();
            goTo(currentIndex + 1);
          }
        });
      }

      on(root, 'focusin', () => {
        focusedInside = true;
        stopAutoplay();
      });

      on(root, 'focusout', (event) => {
        if (root.contains(event.relatedTarget)) return;
        focusedInside = false;
        scheduleAutoplay();
      });

      on(document, 'visibilitychange', () => {
        if (document.hidden) {
          stopAutoplay();
          syncVideos();
          return;
        }
        syncVideos();
        scheduleAutoplay();
      });

      const motionHandler = () => {
        stopAutoplay();
        syncVideos();
        scheduleAutoplay();
      };

      if (typeof reducedMotionQuery.addEventListener === 'function') {
        reducedMotionQuery.addEventListener('change', motionHandler);
        cleanupFns.push(() => reducedMotionQuery.removeEventListener('change', motionHandler));
      }

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            visible = entries.some((entry) => entry.isIntersecting);
            syncVideos();
            if (visible) {
              scheduleAutoplay();
            } else {
              stopAutoplay();
            }
          },
          { threshold: 0.25 }
        );
        observer.observe(root);
        cleanupFns.push(() => observer.disconnect());
      }

      if (typeof mobileMediaQuery.addEventListener === 'function') {
        mobileMediaQuery.addEventListener('change', syncVideos);
        cleanupFns.push(() => mobileMediaQuery.removeEventListener('change', syncVideos));
      }

      const onBlockSelect = (event) => {
        const slide = event.target?.closest?.('[data-emh-slide]');
        if (!slide || !root.contains(slide)) return;
        const index = Number.parseInt(slide.getAttribute('data-slide-index'), 10);
        if (Number.isNaN(index)) return;
        userPaused = true;
        stopAutoplay();
        goTo(index);
      };

      document.addEventListener('shopify:block:select', onBlockSelect);
      cleanupFns.push(() => document.removeEventListener('shopify:block:select', onBlockSelect));

      updateChrome(currentIndex);
      syncVideos();
      scheduleAutoplay();

      instances.set(root, () => {
        stopAutoplay();
        slides.forEach((slide) => pauseSlideVideos(slide, true));
        cleanupFns.forEach((fn) => fn());
        instances.delete(root);
      });
    };

    const initAll = (container = document) => {
      container.querySelectorAll('[data-editorial-media-hero]').forEach(initHero);
    };

    const destroyAll = (container) => {
      container.querySelectorAll('[data-editorial-media-hero]').forEach((root) => {
        const destroy = instances.get(root);
        if (typeof destroy === 'function') destroy();
      });
    };

    initAll();

    document.addEventListener('shopify:section:load', (event) => {
      initAll(event.target);
    });

    document.addEventListener('shopify:section:unload', (event) => {
      destroyAll(event.target);
    });
  })();
