    const mobileMediaQuery = window.matchMedia('(max-width: 749px)');

    const prefersReducedMotion = () => reducedMotionQuery.matches;

    const allowMotion = (root) => root.getAttribute('data-enable-animations') !== 'false' && !prefersReducedMotion();

    const pad = (value) => String(value).padStart(2, '0');

    const isRenderedVideo = (video) => window.getComputedStyle(video).display !== 'none';

    const hydrateVideo = (video) => {
      let didHydrate = false;
      video.querySelectorAll('source[data-src]').forEach((source) => {
        if (source.getAttribute('src')) return;
        source.setAttribute('src', source.getAttribute('data-src'));
        didHydrate = true;
      });
      if (didHydrate) video.load();
    };

    const pauseVideo = (video, reset) => {
      video.pause();
      if (!reset) return;
      try {
        video.currentTime = 0;
      } catch (error) {
        video.muted = true;
      }
    };

    const playVideo = (video) => {
      if (!isRenderedVideo(video) || video.classList.contains('is-unavailable')) return;

      hydrateVideo(video);
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.setAttribute('muted', '');
      video.setAttribute('playsinline', '');

      const attempt = video.play();
      if (attempt && typeof attempt.catch === 'function') {
        attempt.catch(() => {});
      }
    };

    const pauseSlideVideos = (slide, reset) => {
      slide.querySelectorAll('[data-emh-video]').forEach((video) => pauseVideo(video, reset));
    };

    const playSlideVideos = (root, slide) => {
      if (!allowMotion(root) || document.hidden) {
        pauseSlideVideos(slide, false);
        return;
      }

      slide.querySelectorAll('[data-emh-video]').forEach((video) => {
        if (isRenderedVideo(video)) {
          playVideo(video);
        } else {
          pauseVideo(video, true);
        }
